<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TanTienQR.ViewModels"
             xmlns:d="http://schemas.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
             x:Class="TanTienQR.Views.PlcSettingsView"
             x:DataType="vm:MainViewModel">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- ===== Badge đếm số lượng ===== -->
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="MinWidth" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.badge TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ===== Tiêu đề nhóm ===== -->
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ===== Nút nhỏ trong bảng ===== -->
        <Style Selector="Button.rowAction">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- ===== Nút icon tròn nhỏ ===== -->
        <Style Selector="Button.iconBtn">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- ===== Chip trạng thái ===== -->
        <Style Selector="Border.chip">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.chip TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- ===== Ô nhập trong bảng ===== -->
        <Style Selector="TextBox.cellInput">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>

        <!-- ===== Header bảng ===== -->
        <Style Selector="TextBlock.th">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.12" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ===== Nút xoá: đỏ khi rê chuột ===== -->
        <Style Selector="Button.danger">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>
        <Style Selector="Button.danger:pointerover">
            <Setter Property="Foreground" Value="{StaticResource Danger}" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DangerSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineDanger}" />
        </Style>

        <!-- ===== Dòng đang soạn (mới) ===== -->
        <Style Selector="Border.draftRow">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*" Margin="20,14,20,20" RowSpacing="12">

        <!-- ================= HEADER ================= -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Chỉnh PLC"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}" />
                    <Border Classes="badge">
                        <TextBlock Text="{Binding PlcSettings.ParameterCount}" />
                    </Border>
                </StackPanel>
                <TextBlock Classes="label"
                           FontSize="11.5"
                           Text="Quản lý ô nhớ PLC và áp dụng bộ tham số (recipe) xuống máy." />
            </StackPanel>

            <!-- Nút bật/tắt bảng tham số (chế độ chỉ xem camera) -->
            <Button Grid.Column="1"
                    Classes="soft"
                    Width="34" Height="34"
                    MinWidth="34" MinHeight="34"
                    Padding="0"
                    CornerRadius="8"
                    ToolTip.Tip="Ẩn / hiện bảng tham số PLC"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Command="{Binding PlcSettings.ToggleParameterPanelCommand}">
                <Panel>
                    <!-- Mũi tên trái: ẩn bảng -->
                    <Path Width="14" Height="14"
                          Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.8"
                          StrokeLineCap="Round"
                          StrokeJoin="Round"
                          IsVisible="{Binding PlcSettings.IsParameterPanelVisible}"
                          Data="{StaticResource Icon.ChevronRight}" />
                    <!-- Mũi tên phải: hiện bảng -->
                    <Path Width="14" Height="14"
                          Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.8"
                          StrokeLineCap="Round"
                          StrokeJoin="Round"
                          IsVisible="{Binding !PlcSettings.IsParameterPanelVisible}"
                          Data="{StaticResource Icon.ChevronDown}" />
                </Panel>
            </Button>
        </Grid>

        <!-- ================= THÔNG BÁO TRẠNG THÁI ================= -->
        <Border Grid.Row="1"
                Padding="12,9"
                CornerRadius="14"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource LineColor}"
                BorderThickness="1">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="9">
                <Ellipse Grid.Column="0"
                         Width="7" Height="7"
                         VerticalAlignment="Center"
                         Fill="{StaticResource Ok}"
                         IsVisible="{Binding !PlcSettings.IsStatusError}" />
                <Ellipse Grid.Column="0"
                         Width="7" Height="7"
                         VerticalAlignment="Center"
                         Fill="{StaticResource Danger}"
                         IsVisible="{Binding PlcSettings.IsStatusError}" />
                <Path Grid.Column="1"
                      Width="15" Height="15"
                      Stretch="Uniform"
                      VerticalAlignment="Center"
                      Stroke="{StaticResource TextMuted}"
                      StrokeThickness="1.8"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      IsVisible="{Binding !PlcSettings.IsStatusError}"
                      Data="{StaticResource Icon.Info}" />
                <Path Grid.Column="1"
                      Width="15" Height="15"
                      Stretch="Uniform"
                      VerticalAlignment="Center"
                      Stroke="{StaticResource Danger}"
                      StrokeThickness="1.8"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      IsVisible="{Binding PlcSettings.IsStatusError}"
                      Data="{StaticResource Icon.Alert}" />
                <TextBlock Grid.Column="2"
                           FontSize="11.5"
                           Foreground="{StaticResource TextMuted}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding PlcSettings.StatusMessage}" />
            </Grid>
        </Border>

        <!-- ================= NỘI DUNG =================
             Cột trái (bảng ô nhớ + recipe) bị ẩn khi bấm nút toggle ở header ->
             camera chiếm trọn phần chiều rộng còn lại. -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="14">

            <!-- ============ CỘT TRÁI: RECIPE + BẢNG Ô NHỚ ============ -->
            <Grid Grid.Column="0"
                  Width="{Binding PlcSettings.ParameterPanelWidth}"
                  RowDefinitions="Auto,*"
                  RowSpacing="12"
                  IsVisible="{Binding PlcSettings.IsParameterPanelVisible}">

                <!-- Card Recipe (gọn, 2 hàng) -->
                <Border Grid.Row="0" Classes="panel" Padding="12">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="8">

                        <!-- Hàng 1: nhãn + chọn recipe + nút -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">

                            <!-- Nhãn -->
                            <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Classes="sectionTitle" Text="Recipe" />
                                <Border Classes="badge" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding PlcSettings.RecipeCount}" />
                                </Border>
                            </StackPanel>

                            <!-- Chọn recipe -->
                            <ComboBox Grid.Column="1"
                                      Classes="field"
                                      Height="34"
                                      FontSize="12"
                                      VerticalContentAlignment="Center"
                                      PlaceholderText="Chọn recipe"
                                      ItemsSource="{Binding PlcSettings.Recipes}"
                                      SelectedItem="{Binding PlcSettings.SelectedRecipe}" />

                            <!-- Áp dụng nhanh -->
                            <Button Grid.Column="2"
                                    Classes="soft"
                                    Width="34" Height="34"
                                    MinWidth="34" MinHeight="34"
                                    Padding="0"
                                    CornerRadius="8"
                                    ToolTip.Tip="Áp dụng recipe xuống PLC"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Command="{Binding PlcSettings.ApplyRecipeCommand}">
                                <Path Width="14" Height="14"
                                      Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Data="{StaticResource Icon.Upload}" />
                            </Button>

                            <!-- Xoá -->
                            <Button Grid.Column="3"
                                    Classes="soft danger"
                                    Width="34" Height="34"
                                    MinWidth="34" MinHeight="34"
                                    Padding="0"
                                    CornerRadius="10"
                                    ToolTip.Tip="Xoá recipe đang chọn"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Command="{Binding PlcSettings.DeleteRecipeCommand}">
                                <Path Width="14" Height="14"
                                      Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Data="{StaticResource Icon.Trash}" />
                            </Button>
                        </Grid>

                        <!-- Hàng 2: nhập tên recipe mới + nút tạo -->
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0"
                                       Classes="fieldLabel"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       Text="TÊN MỚI" />
                            <TextBox Grid.Column="1"
                                     Classes="field"
                                     Height="32"
                                     FontSize="12"
                                     VerticalContentAlignment="Center"
                                     PlaceholderText="Ví dụ: Line 1 - Sản phẩm A"
                                     Text="{Binding PlcSettings.NewRecipeName}" />
                            <Button Grid.Column="2"
                                    Classes="soft"
                                    Height="32" MinWidth="76" Padding="10,0"
                                    FontSize="11.5"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Command="{Binding PlcSettings.CreateRecipeCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Path Width="13" Height="13"
                                          Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          Data="{StaticResource Icon.Plus}" />
                                    <TextBlock Text="Tạo" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Bảng ô nhớ (gọn) -->
                <Border Grid.Row="1" Classes="panel" Padding="0">
                    <Grid RowDefinitions="Auto,Auto,*,Auto">

                        <!-- Header panel -->
                        <Grid Grid.Row="0"
                              ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="8"
                              Margin="14,11,14,10">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Path Width="15" Height="15"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Stroke="{StaticResource TextMuted}"
                                      StrokeThickness="1.8"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Data="{StaticResource Icon.CpuChip}" />
                                <TextBlock Classes="sectionTitle" Text="Ô NHỚ PLC" />
                                <Border Classes="badge">
                                    <TextBlock Text="{Binding PlcSettings.ParameterCount}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Classes="overline"
                                       FontSize="10.5"
                                       VerticalAlignment="Center"
                                       Text="Nhấn ▼ để xem chi tiết" />
                            <!-- Thêm tham số mới -->
                            <Button Grid.Column="2"
                                    Classes="primary"
                                    Height="28" MinWidth="98" Padding="10,0"
                                    FontSize="11.5"
                                    CornerRadius="9"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Command="{Binding PlcSettings.AddParameterCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Path Width="13" Height="13"
                                          Stretch="Uniform"
                                          Fill="White"
                                          Data="{StaticResource Icon.Plus}" />
                                    <TextBlock Text="Tham số" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Header cột -->
                        <Border Grid.Row="1"
                                BorderBrush="{StaticResource LineColor}"
                                BorderThickness="0,1,0,1"
                                Padding="14,7"
                                Background="#F8F9FB">
                            <Grid ColumnDefinitions="Auto,*,96,104,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="1" Classes="th" Text="TÊN" />
                                <TextBlock Grid.Column="2" Classes="th" Text="GIÁ TRỊ" />
                                <TextBlock Grid.Column="3" Classes="th" Text="NHẬP" />
                            </Grid>
                        </Border>

                        <!-- Danh sách: gồm dòng đang soạn + dòng đã lưu -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <!-- ======== DÒNG ĐANG SOẠN (mới) ======== -->
                                <ItemsControl ItemsSource="{Binding PlcSettings.DraftRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NewParamRowViewModel">
                                            <Border Classes="draftRow"
                                                    BorderBrush="{StaticResource LineAccent}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="14,8">
                                                <StackPanel Spacing="7">

                                                    <!-- Hàng nhập chính -->
                                                    <Grid ColumnDefinitions="Auto,*,104,Auto" ColumnSpacing="8">
                                                        <!-- Nút xổ -->
                                                        <Button Grid.Column="0"
                                                                Classes="soft iconBtn"
                                                                ToolTip.Tip="Chi tiết ô nhớ"
                                                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PlcSettings.ToggleDraftExpandedCommand}"
                                                                CommandParameter="{Binding}">
                                                            <Panel>
                                                                <Path Width="12" Height="12"
                                                                      Stretch="Uniform"
                                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                      StrokeThickness="1.8"
                                                                      StrokeLineCap="Round"
                                                                      StrokeJoin="Round"
                                                                      IsVisible="{Binding !IsExpanded}"
                                                                      Data="{StaticResource Icon.ChevronDown}" />
                                                                <Path Width="12" Height="12"
                                                                      Stretch="Uniform"
                                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                      StrokeThickness="1.8"
                                                                      StrokeLineCap="Round"
                                                                      StrokeJoin="Round"
                                                                      IsVisible="{Binding IsExpanded}"
                                                                      Data="{StaticResource Icon.ChevronRight}" />
                                                            </Panel>
                                                        </Button>

                                                        <!-- Tên -->
                                                        <TextBox Grid.Column="1"
                                                                 Classes="field cellInput"
                                                                 PlaceholderText="Tên tham số (vd: Delay Camera)"
                                                                 Text="{Binding Name}" />

                                                        <!-- Địa chỉ tóm tắt -->
                                                        <TextBox Grid.Column="2"
                                                                 Classes="field cellInput"
                                                                 PlaceholderText="Ô nhớ (D12)"
                                                                 Text="{Binding Address}" />

                                                        <!-- Nút lưu / huỷ -->
                                                        <StackPanel Grid.Column="3"
                                                                    Orientation="Horizontal"
                                                                    Spacing="4"
                                                                    VerticalAlignment="Center">
                                                            <Button Classes="primary iconBtn"
                                                                    ToolTip.Tip="Lưu tham số"
                                                                    IsEnabled="{Binding CanSave}"
                                                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PlcSettings.SaveDraftParameterCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <Path Width="13" Height="13"
                                                                      Stretch="Uniform"
                                                                      Stroke="{StaticResource BgPanel}"
                                                                      StrokeThickness="2"
                                                                      StrokeLineCap="Round"
                                                                      StrokeJoin="Round"
                                                                      Data="{StaticResource Icon.Check}" />
                                                            </Button>
                                                            <Button Classes="soft iconBtn"
                                                                    ToolTip.Tip="Huỷ"
                                                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PlcSettings.CancelDraftParameterCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <Path Width="12" Height="12"
                                                                      Stretch="Uniform"
                                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                      StrokeThickness="1.8"
                                                                      StrokeLineCap="Round"
                                                                      StrokeJoin="Round"
                                                                      Data="{StaticResource Icon.Close}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Chi tiết (xổ xuống) -->
                                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*"
                                                          ColumnSpacing="8"
                                                          IsVisible="{Binding IsExpanded}">
                                                        <TextBlock Grid.Column="0"
                                                                   Classes="fieldLabel"
                                                                   FontSize="10"
                                                                   VerticalAlignment="Center"
                                                                   Text="KIỂU" />
                                                        <ComboBox Grid.Column="1"
                                                                  Classes="field"
                                                                  Height="30"
                                                                  FontSize="11"
                                                                  MinWidth="104"
                                                                  Padding="8,0"
                                                                  VerticalContentAlignment="Center"
                                                                  ItemsSource="{Binding AvailableValueTypes}"
                                                                  SelectedItem="{Binding ValueType}" />
                                                        <TextBlock Grid.Column="2"
                                                                   Classes="fieldLabel"
                                                                   FontSize="10"
                                                                   VerticalAlignment="Center"
                                                                   Text="TRUY CẬP" />
                                                        <ComboBox Grid.Column="3"
                                                                  Classes="field"
                                                                  Height="30"
                                                                  FontSize="11"
                                                                  MinWidth="118"
                                                                  Padding="8,0"
                                                                  VerticalContentAlignment="Center"
                                                                  ItemsSource="{Binding AvailableAccessModes}"
                                                                  SelectedItem="{Binding AccessMode}" />
                                                        <TextBlock Grid.Column="4"
                                                                   Classes="fieldLabel"
                                                                   FontSize="10"
                                                                   VerticalAlignment="Center"
                                                                   Text="MÔ TẢ" />
                                                        <TextBox Grid.Column="5"
                                                                 Classes="field cellInput"
                                                                 PlaceholderText="Ghi chú (không bắt buộc)"
                                                                 Text="{Binding Description}" />
                                                    </Grid>

                                                    <!-- Lỗi -->
                                                    <TextBlock FontSize="10.5"
                                                               Foreground="{StaticResource Danger}"
                                                               TextWrapping="Wrap"
                                                               IsVisible="{Binding IsError}"
                                                               Text="{Binding StatusText}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- ======== DÒNG ĐÃ LƯU ======== -->
                                <ItemsControl ItemsSource="{Binding PlcSettings.ParameterRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PlcParamRowViewModel">
                                            <Border BorderBrush="{StaticResource LineColor}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="14,6">
                                                <StackPanel Spacing="5">

                                                    <!-- Hàng gọn -->
                                                    <Grid ColumnDefinitions="Auto,*,96,104,Auto" ColumnSpacing="8">

                                                        <!-- Nút xổ -->
                                                        <Button Grid.Column="0"
                                                                Classes="soft iconBtn"
                                                                ToolTip.Tip="Chi tiết ô nhớ"
                                                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PlcSettings.ToggleRowExpandedCommand}"
                                                                CommandParameter="{Binding}">
                                                            <Panel>
                                                                <Path Width="12" Height="12"
                                                                      Stretch="Uniform"
                                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                      StrokeThickness="1.8"
                                                                      StrokeLineCap="Round"
                                                                      StrokeJoin="Round"
                                                                      IsVisible="{Binding !IsExpanded}"
                                                                      Data="{StaticResource Icon.ChevronDown}" />
                                                                <Path Width="12" Height="12"
                                                                      Stretch="Uniform"
                                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                      StrokeThickness="1.8"
                                                                      StrokeLineCap="Round"
                                                                      StrokeJoin="Round"
                                                                      IsVisible="{Binding IsExpanded}"
                                                                      Data="{StaticResource Icon.ChevronRight}" />
                                                            </Panel>
                                                        </Button>

                                                        <!-- Tên + mô tả -->
                                                        <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                                                            <TextBlock FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimary}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Text="{Binding Name}" />
                                                            <TextBlock Classes="label"
                                                                       FontSize="10"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Text="{Binding Description}" />
                                                        </StackPanel>

                                                        <!-- Giá trị đọc từ PLC -->
                                                        <TextBlock Grid.Column="2"
                                                                   Classes="mono"
                                                                   FontSize="11.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource Accent}"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding CurrentValue}" />

                                                        <!-- Ô nhập giá trị -->
                                                        <TextBox Grid.Column="3"
                                                                 Classes="field cellInput"
                                                                 PlaceholderText="Nhập…"
                                                                 Text="{Binding InputValue}" />

                                                        <!-- Thao tác -->
                                                        <StackPanel Grid.Column="4"
                                                                    Orientation="Horizontal"
                                                                    Spacing="3"
                                                                    VerticalAlignment="Center">
                                                            <Button Classes="soft iconBtn"
                                                                    ToolTip.Tip="Đọc giá trị từ PLC"
                                                                    IsVisible="{Binding CanRead}"
                                                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PlcSettings.ReadParameterCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <Path Width="13" Height="13"
                                                                      Stretch="Uniform"
                                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                      StrokeThickness="1.6"
                                                                      StrokeLineCap="Round"
                                                                      StrokeJoin="Round"
                                                                      Data="{StaticResource Icon.Download}" />
                                                            </Button>
                                                            <Button Classes="soft iconBtn"
                                                                    ToolTip.Tip="Ghi giá trị xuống PLC"
                                                                    IsVisible="{Binding CanWrite}"
                                                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PlcSettings.WriteParameterCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <Path Width="13" Height="13"
                                                                      Stretch="Uniform"
                                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                      StrokeThickness="1.6"
                                                                      StrokeLineCap="Round"
                                                                      StrokeJoin="Round"
                                                                      Data="{StaticResource Icon.Upload}" />
                                                            </Button>
                                                            <Button Classes="soft iconBtn"
                                                                    ToolTip.Tip="Sửa thông số"
                                                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PlcSettings.EditParameterCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <Path Width="12" Height="12"
                                                                      Stretch="Uniform"
                                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                      StrokeThickness="1.6"
                                                                      StrokeLineCap="Round"
                                                                      StrokeJoin="Round"
                                                                      Data="{StaticResource Icon.Settings}" />
                                                            </Button>
                                                            <Button Classes="soft iconBtn danger"
                                                                    ToolTip.Tip="Xoá thông số"
                                                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PlcSettings.DeleteParameterCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <Path Width="12" Height="12"
                                                                      Stretch="Uniform"
                                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                      StrokeThickness="1.6"
                                                                      StrokeLineCap="Round"
                                                                      StrokeJoin="Round"
                                                                      Data="{StaticResource Icon.Trash}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Chi tiết (xổ xuống) -->
                                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*"
                                                          ColumnSpacing="8"
                                                          IsVisible="{Binding IsExpanded}">
                                                        <TextBlock Grid.Column="0"
                                                                   Classes="fieldLabel"
                                                                   FontSize="10"
                                                                   VerticalAlignment="Center"
                                                                   Text="Ô NHỚ" />
                                                        <TextBlock Grid.Column="1"
                                                                   Classes="mono"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimary}"
                                                                   VerticalAlignment="Center"
                                                                   MinWidth="56"
                                                                   Text="{Binding Address}" />
                                                        <TextBlock Grid.Column="2"
                                                                   Classes="fieldLabel"
                                                                   FontSize="10"
                                                                   VerticalAlignment="Center"
                                                                   Text="KIỂU" />
                                                        <TextBlock Grid.Column="3"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextMuted}"
                                                                   VerticalAlignment="Center"
                                                                   MinWidth="56"
                                                                   Text="{Binding ValueTypeText}" />

                                                        <!-- Chip R/W -->
                                                        <Border Grid.Column="4"
                                                                Classes="chip"
                                                                Background="{StaticResource AccentSoft}"
                                                                IsVisible="{Binding CanWrite}">
                                                            <TextBlock Text="{Binding AccessModeText}"
                                                                       Foreground="{StaticResource Accent}" />
                                                        </Border>
                                                        <Border Grid.Column="4"
                                                                Classes="chip"
                                                                Background="{StaticResource BgRaised}"
                                                                IsVisible="{Binding !CanWrite}">
                                                            <TextBlock Text="{Binding AccessModeText}"
                                                                       Foreground="{StaticResource TextMuted}" />
                                                        </Border>

                                                        <!-- Mô tả -->
                                                        <TextBlock Grid.Column="5"
                                                                   Classes="label"
                                                                   FontSize="10.5"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Text="{Binding Description}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Chưa có tham số -->
                        <StackPanel Grid.Row="2"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Spacing="7"
                                    IsVisible="{Binding !PlcSettings.IsTableEmpty}">
                            <Border Width="42" Height="42"
                                    CornerRadius="14"
                                    Background="{StaticResource BgRaised}">
                                <Path Width="20" Height="20"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stretch="Uniform"
                                      Stroke="{StaticResource TextMuted}"
                                      StrokeThickness="1.6"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Data="{StaticResource Icon.Table}" />
                            </Border>
                            <TextBlock Text="Chưa có ô nhớ nào"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Classes="label"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Text="Bấm “+ Tham số” để thêm ô nhớ cần đọc hoặc ghi." />
                        </StackPanel>

                        <!-- Footer: các thao tác đọc / ghi / áp dụng -->
                        <Border Grid.Row="3"
                                BorderBrush="{StaticResource LineColor}"
                                BorderThickness="0,1,0,0"
                                Padding="14,10"
                                Background="{StaticResource BgBase}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0"
                                           Classes="label"
                                           FontSize="10.5"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Text="Nhập giá trị ở cột “Nhập”, rồi bấm Áp dụng để ghi xuống PLC và lưu vào recipe." />

                                <!-- 3 nút thao tác: Tải lên / Cập nhật / Áp dụng -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                    <!-- Tải lên: nạp giá trị recipe vào ô nhập -->
                                    <Button Classes="soft"
                                            Height="32" MinWidth="86" Padding="12,0"
                                            FontSize="11.5"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            ToolTip.Tip="Tải giá trị của recipe đang chọn vào ô nhập"
                                            Command="{Binding PlcSettings.LoadRecipeValuesCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Path Width="13" Height="13"
                                                  Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.9"
                                                  StrokeLineCap="Round"
                                                  StrokeJoin="Round"
                                                  Data="{StaticResource Icon.Download}" />
                                            <TextBlock Text="Tải lên" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Cập nhật: đọc lại giá trị thực tế từ PLC -->
                                    <Button Classes="soft"
                                            Height="32" MinWidth="86" Padding="12,0"
                                            FontSize="11.5"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            ToolTip.Tip="Đọc lại giá trị thực tế từ PLC"
                                            Command="{Binding PlcSettings.ReadAllCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Path Width="13" Height="13"
                                                  Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.9"
                                                  StrokeLineCap="Round"
                                                  StrokeJoin="Round"
                                                  Data="{StaticResource Icon.Refresh}" />
                                            <TextBlock Text="Cập nhật" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Áp dụng: ghi xuống PLC + lưu vào recipe -->
                                    <Button Classes="primary"
                                            Height="32" MinWidth="86" Padding="12,0"
                                            FontSize="11.5"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            ToolTip.Tip="Ghi giá trị đang nhập xuống PLC và lưu vào recipe"
                                            Command="{Binding PlcSettings.ApplyAndSaveRecipeCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Path Width="13" Height="13"
                                                  Stretch="Uniform"
                                                  Fill="White"
                                                  Data="{StaticResource Icon.Check}" />
                                            <TextBlock Text="Áp dụng" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ CỘT PHẢI: CAMERA ============ -->
            <Border Grid.Column="1" Classes="panel" Padding="0">
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- Header camera -->
                    <Grid Grid.Row="0"
                          ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="8"
                          Margin="14,11,14,9">
                        <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Width="15" Height="15"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Stroke="{StaticResource TextMuted}"
                                      StrokeThickness="1.8"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Data="{StaticResource Icon.Camera}" />
                                <TextBlock Classes="sectionTitle" Text="CAMERA" />
                            </StackPanel>
                            <TextBlock Classes="mono"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMuted}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding PlcSettings.CameraMonitorUrl}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Classes="soft"
                                Height="30" MinWidth="72" Padding="10,0"
                                FontSize="11"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="OnReloadCameraClick">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Path Width="13" Height="13"
                                      Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.9"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Data="{StaticResource Icon.Refresh}" />
                                <TextBlock Text="Tải lại" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Classes="soft"
                                Height="30" MinWidth="108" Padding="10,0"
                                FontSize="11"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="OnOpenCameraExternalClick">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Path Width="13" Height="13"
                                      Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.9"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Data="{StaticResource Icon.Link}" />
                                <TextBlock Text="Mở trình duyệt" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Webview camera (rộng) -->
                    <Border Grid.Row="1"
                            Margin="14,0,14,12"
                            Background="{StaticResource BgBase}"
                            BorderBrush="{StaticResource LineColor}"
                            BorderThickness="1"
                            CornerRadius="14"
                            ClipToBounds="True">
                        <Grid>
                            <NativeWebView x:Name="CameraBrowser"
                                           Source="{Binding PlcSettings.CameraMonitorUri}"
                                           IsVisible="{Binding PlcSettings.IsCameraWebEnabled}"
                                           NavigationStarted="OnCameraNavigationStarted"
                                           NavigationCompleted="OnCameraNavigationCompleted" />

                            <!-- Chưa cấu hình IP camera -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8"
                                        IsVisible="{Binding !PlcSettings.HasCameraUrl}">
                                <Border Width="52" Height="52"
                                        CornerRadius="16"
                                        Background="{StaticResource BgRaised}">
                                    <Path Width="26" Height="26"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Stroke="{StaticResource TextMuted}"
                                          StrokeThickness="1.6"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          Data="{StaticResource Icon.Camera}" />
                                </Border>
                                <TextBlock Text="Chưa cấu hình IP camera"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMuted}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Classes="label"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Text="Đặt Camera.Ip trong tab Cấu hình để xem hình." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Footer: áp dụng recipe xuống PLC -->
                    <Border Grid.Row="2"
                            BorderBrush="{StaticResource LineColor}"
                            BorderThickness="0,1,0,0"
                            Padding="14,11"
                            Background="{StaticResource BgBase}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                <TextBlock FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           Text="Áp dụng recipe" />
                                <TextBlock Classes="label"
                                           FontSize="10"
                                           Text="Ghi bộ giá trị đang chọn xuống PLC." />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="primary"
                                    Height="36" MinWidth="140" Padding="14,0"
                                    FontSize="12"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Content="Áp dụng xuống PLC"
                                    Command="{Binding PlcSettings.ApplyRecipeCommand}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>