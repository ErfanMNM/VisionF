<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TanTienQR.ViewModels"
             xmlns:services="using:TanTienQR.Services"
             xmlns:d="http://schemas.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="760"
             x:Class="TanTienQR.Views.AboutView"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.request-error">
            <Setter Property="Foreground" Value="{StaticResource Danger}" />
        </Style>
        <!-- Dong nhan / gia tri trong cac card thong tin: cung mot nhip de
             cac cot khong bi lech baseline. -->
        <Style Selector="TextBlock.infoValue">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.infoValue.strong">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource LineColor}" />
        </Style>
    </UserControl.Styles>

    <!-- Tab Giới thiệu: gom thông tin phiên bản, license và cập nhật phần mềm
         về một chỗ, thay cho popup license + card cập nhật rải rác ở tab Thông tin.
         Bố cục 2x2: mỗi hàng là một cặp card cùng chiều cao nên mép dưới luôn
         thẳng nhau, không còn cột phải hụt giữa trang. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18,6,18,18" RowDefinitions="Auto,Auto" RowSpacing="14">

            <!-- ===== Tiêu đề ===== -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border Grid.Column="0"
                        Width="42" Height="42"
                        CornerRadius="14"
                        Background="{StaticResource AccentSoft}"
                        BorderBrush="{StaticResource LineAccent}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <Path Width="20" Height="20"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Stretch="Uniform"
                          Stroke="{StaticResource Accent}"
                          StrokeThickness="1.9"
                          StrokeLineCap="Round"
                          StrokeJoin="Round"
                          Data="{StaticResource Icon.InfoCircle}" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Giới thiệu" Classes="pageTitle" />
                    <TextBlock Classes="label"
                               FontSize="12"
                               Text="Phiên bản phần mềm, giấy phép sử dụng và cập nhật." />
                </StackPanel>

                <Border Grid.Column="2" Classes="pill" VerticalAlignment="Center">
                    <TextBlock Classes="mono" Text="{Binding AppVersionText}" />
                </Border>
            </Grid>

            <!-- ===== Nội dung ===== -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="1.05*,0.95*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="14"
                  RowSpacing="14">

                <!-- ==================== HÀNG 1 - CỘT TRÁI: GIẤY PHÉP ==================== -->
                <Border Grid.Row="0" Grid.Column="0" Classes="panel" Padding="18">
                    <!-- Hang cuoi (divider + nut) duoc day xuong day card: khi license
                         con han (khong co canh bao) card van cao bang card ben canh. -->
                    <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="14">

                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="overline" Text="GIẤY PHÉP SỬ DỤNG" />
                                <TextBlock Classes="label" FontSize="12"
                                           Text="TanTienQR · Quét mã - PLC Omron" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Classes="badge"
                                    Classes.running="{Binding IsLicenseRunning}"
                                    Classes.warning="{Binding IsLicenseWarning}"
                                    Classes.fault="{Binding IsLicenseFault}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding LicenseStatusText}" />
                            </Border>
                        </Grid>

                        <!-- Thông tin license -->
                        <Border Grid.Row="1" VerticalAlignment="Center" Classes="device" Padding="14,12">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="9">
                                <Grid ColumnDefinitions="132,*" ColumnSpacing="12">
                                    <TextBlock Classes="fieldLabel" Text="KHÁCH HÀNG"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="infoValue strong"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding LicenseCustomerText}"
                                               Text="{Binding LicenseCustomerText}" />
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="132,*" ColumnSpacing="12">
                                    <TextBlock Classes="fieldLabel" Text="HẾT HẠN"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="mono infoValue"
                                               Text="{Binding LicenseExpiryText}" />
                                </Grid>
                                <Grid Grid.Row="2" ColumnDefinitions="132,*" ColumnSpacing="12">
                                    <TextBlock Classes="fieldLabel" Text="THỜI GIAN CÒN LẠI"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="infoValue strong"
                                               Text="{Binding LicenseDaysLeftText}" />
                                </Grid>
                                <Grid Grid.Row="3" ColumnDefinitions="132,*" ColumnSpacing="12">
                                    <TextBlock Classes="fieldLabel" Text="GÓI MODULE"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="infoValue"
                                               FontSize="12" TextWrapping="Wrap"
                                               Text="{Binding LicenseModulesText}" />
                                </Grid>
                                <Grid Grid.Row="4" ColumnDefinitions="132,*,Auto" ColumnSpacing="12">
                                    <TextBlock Classes="fieldLabel" Text="MÃ MÁY (HWID)"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="mono"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMuted}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Text="{Binding HwidText}" />
                                    <Button Grid.Column="2"
                                            Classes="chip"
                                            MinHeight="30"
                                            MinWidth="0"
                                            Padding="12,0"
                                            FontSize="11"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            Content="{Binding CopyHwidButtonText}"
                                            ToolTip.Tip="Sao chép mã máy (HWID) vào clipboard"
                                            Command="{Binding CopyHwidCommand}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Cảnh báo khi license lỗi -->
                        <Border Grid.Row="2"
                                Padding="12"
                                CornerRadius="9"
                                Background="{StaticResource DangerSoft}"
                                BorderBrush="{StaticResource Danger}"
                                BorderThickness="1"
                                IsVisible="{Binding !IsLicenseValid}">
                            <TextBlock Text="{Binding LicenseMessageText}"
                                       FontSize="12"
                                       Foreground="{StaticResource Danger}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Grid Grid.Row="3" RowDefinitions="Auto,Auto" RowSpacing="12">
                            <Border Classes="divider" />

                            <!-- Hành động: nút nhập license giãn theo bề ngang, nút huỷ giữ
                                 kích thước thật để hai nút không bị kéo lệch như ô nhập. -->
                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Button Grid.Column="0"
                                        Classes="soft"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Command="{Binding ImportLicenseCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Width="15" Height="15"
                                              Stretch="Uniform"
                                              Stroke="{StaticResource TextPrimary}"
                                              StrokeThickness="1.9"
                                              StrokeLineCap="Round"
                                              StrokeJoin="Round"
                                              Data="{StaticResource Icon.File}" />
                                        <TextBlock Text="Nhập license từ file .lic…" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1"
                                        Classes="whitebtn danger"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        IsVisible="{Binding IsLicenseValid}"
                                        Command="{Binding RevokeLicenseCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Width="15" Height="15"
                                              Stretch="Uniform"
                                              Stroke="{StaticResource Danger}"
                                              StrokeThickness="1.9"
                                              StrokeLineCap="Round"
                                              StrokeJoin="Round"
                                              Data="{StaticResource Icon.Trash}" />
                                        <TextBlock Text="Hủy license hiện tại" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ==================== HÀNG 1 - CỘT PHẢI: YÊU CẦU CẤP LICENSE ==================== -->
                <Border Grid.Row="0" Grid.Column="1" Classes="panel" Padding="18">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="12"
                          IsEnabled="{Binding !RequestLicenseCommand.IsRunning}">

                        <StackPanel Grid.Row="0" Spacing="3">
                            <TextBlock Classes="sectionTitle" Text="Yêu cầu cấp license" />
                            <TextBlock Classes="label" FontSize="11" TextWrapping="Wrap"
                                       Text="Gửi mã máy (HWID) của máy này đến nhà cung cấp. Sau khi được cấp, nhập file .lic để kích hoạt." />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Spacing="5">
                            <TextBlock Classes="fieldLabel" Text="ĐỊA CHỈ LICENSE PORTAL" />
                            <TextBox Classes="field"
                                     Text="{Binding LicensePortalUrl, Mode=TwoWay}"
                                     PlaceholderText="https://…workers.dev" />
                        </StackPanel>

                        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10">
                            <StackPanel Grid.Column="0" Spacing="5">
                                <TextBlock Classes="fieldLabel" Text="KHÁCH HÀNG / CÔNG TY" />
                                <TextBox Classes="field"
                                         Text="{Binding LicenseRequestCustomer, Mode=TwoWay}"
                                         MaxLength="200"
                                         PlaceholderText="Tuỳ chọn" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Classes="fieldLabel" Text="EMAIL / SỐ ĐIỆN THOẠI" />
                                <TextBox Classes="field"
                                         Text="{Binding LicenseRequestContact, Mode=TwoWay}"
                                         MaxLength="200"
                                         PlaceholderText="Tuỳ chọn" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="3" Spacing="5">
                            <TextBlock Classes="fieldLabel" Text="GHI CHÚ" />
                            <TextBox Classes="field"
                                     Text="{Binding LicenseRequestNote, Mode=TwoWay}"
                                     MaxLength="1000"
                                     PlaceholderText="Nội dung cần nhà cung cấp biết (tuỳ chọn)" />
                        </StackPanel>

                        <TextBlock Grid.Row="4" Classes="label" FontSize="12" TextWrapping="Wrap"
                                   Classes.request-error="{Binding IsLicenseRequestError}"
                                   IsVisible="{Binding HasLicenseRequestMessage}"
                                   Text="{Binding LicenseRequestMessage}" />

                        <Button Grid.Row="6" Classes="primary"
                                HorizontalAlignment="Right"
                                MinWidth="230"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Command="{Binding RequestLicenseCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Width="15" Height="15"
                                      Stretch="Uniform"
                                      Stroke="White"
                                      StrokeThickness="1.9"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Data="{StaticResource Icon.Upload}" />
                                <TextBlock Text="Gửi yêu cầu cấp license" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- ==================== HÀNG 2 - CỘT TRÁI: THÔNG TIN ỨNG DỤNG ==================== -->
                <Border Grid.Row="1" Grid.Column="0" Classes="panel" Padding="18">
                    <StackPanel Spacing="11" VerticalAlignment="Center">
                        <TextBlock Classes="overline" Text="THÔNG TIN ỨNG DỤNG" />

                        <Grid ColumnDefinitions="132,*" ColumnSpacing="12">
                            <TextBlock Classes="fieldLabel" Text="SẢN PHẨM"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="infoValue strong"
                                       TextWrapping="Wrap"
                                       Text="TanTienQR · Quét mã - PLC Omron" />
                        </Grid>
                        <Grid ColumnDefinitions="132,*" ColumnSpacing="12">
                            <TextBlock Classes="fieldLabel" Text="PHIÊN BẢN"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="mono infoValue"
                                       Text="{Binding AppVersionText}" />
                        </Grid>
                        <Grid ColumnDefinitions="132,*" ColumnSpacing="12">
                            <TextBlock Classes="fieldLabel" Text="LICENSE"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="infoValue strong"
                                       Text="{Binding LicenseStatusText}" />
                        </Grid>
                        <Grid ColumnDefinitions="132,*" ColumnSpacing="12">
                            <TextBlock Classes="fieldLabel" Text="HẾT HẠN"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="mono infoValue"
                                       Text="{Binding LicenseExpiryText}" />
                        </Grid>

                        <Border Classes="divider" />

                        <TextBlock Classes="label" FontSize="11" TextWrapping="Wrap"
                                   Text="Gửi mã máy (HWID) cho nhà cung cấp để được cấp file license.lic, sau đó nhập license ở card Giấy phép sử dụng." />
                    </StackPanel>
                </Border>

                <!-- ==================== HÀNG 2 - CỘT PHẢI: CẬP NHẬT PHẦN MỀM ==================== -->
                <Border Grid.Row="1" Grid.Column="1"
                        Classes="panel" Padding="18"
                        DataContext="{Binding Updates}"
                        x:DataType="services:UpdateClient">
                    <StackPanel Spacing="12" IsEnabled="{Binding !IsBusy}">
                        <TextBlock Classes="overline" Text="CẬP NHẬT PHẦN MỀM" />

                        <Grid ColumnDefinitions="132,*" ColumnSpacing="12">
                            <TextBlock Classes="fieldLabel" Text="PHIÊN BẢN HIỆN TẠI"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="mono infoValue"
                                       Text="{Binding CurrentVersion}" />
                        </Grid>
                        <Grid ColumnDefinitions="132,*" ColumnSpacing="12">
                            <TextBlock Classes="fieldLabel" Text="BẢN MỚI"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="mono infoValue strong"
                                       Text="{Binding AvailableVersionText}" />
                        </Grid>

                        <Border Background="{StaticResource BgRaised}"
                                BorderBrush="{StaticResource LineColor}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,10">
                            <TextBlock Text="{Binding Status}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Border>

                        <StackPanel Spacing="4" IsVisible="{Binding HasNotes}">
                            <TextBlock Classes="fieldLabel" Text="GHI CHÚ BẢN MỚI" />
                            <TextBlock Text="{Binding Notes}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       MaxHeight="110" />
                        </StackPanel>

                        <StackPanel Spacing="4" IsVisible="{Binding HasLastResult}">
                            <TextBlock Classes="fieldLabel" Text="KẾT QUẢ LẦN TRƯỚC" />
                            <TextBlock Text="{Binding LastResult}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       MaxHeight="110" />
                        </StackPanel>

                        <Border Classes="divider" />

                        <!-- Nút thật (accent + icon, chữ canh giữa) thay cho thanh
                             xám full-width trông như ô nhập. -->
                        <WrapPanel HorizontalAlignment="Right" ItemSpacing="8" LineSpacing="8">
                            <Button Classes="primary"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Command="{Binding CheckCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Width="15" Height="15"
                                          Stretch="Uniform"
                                          Stroke="White"
                                          StrokeThickness="2"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          Data="{StaticResource Icon.Refresh}" />
                                    <TextBlock Text="Kiểm tra bản mới" />
                                </StackPanel>
                            </Button>
                            <Button Classes="soft"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    IsVisible="{Binding CanDownload}"
                                    Command="{Binding DownloadCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Width="15" Height="15"
                                          Stretch="Uniform"
                                          Stroke="{StaticResource TextPrimary}"
                                          StrokeThickness="1.9"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          Data="{StaticResource Icon.Download}" />
                                    <TextBlock Text="Tải bản cập nhật" />
                                </StackPanel>
                            </Button>
                            <Button Classes="primary"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    IsVisible="{Binding CanInstall}"
                                    Command="{Binding InstallCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Width="15" Height="15"
                                          Stretch="Uniform"
                                          Stroke="White"
                                          StrokeThickness="1.9"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          Data="{StaticResource Icon.Power}" />
                                    <TextBlock Text="Cài đặt và khởi động lại" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <TextBlock Classes="label" FontSize="11" TextWrapping="Wrap"
                                   Text="Chỉ cài khi dây chuyền đã dừng. Cần đăng nhập Quản trị / Lập trình viên và license hợp lệ." />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
