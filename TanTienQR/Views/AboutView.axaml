<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TanTienQR.ViewModels"
             xmlns:services="using:TanTienQR.Services"
             xmlns:d="http://schemas.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="760"
             x:Class="TanTienQR.Views.AboutView"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.request-error">
            <Setter Property="Foreground" Value="{StaticResource Danger}" />
        </Style>
    </UserControl.Styles>

    <!-- Tab Giới thiệu: gom thông tin phiên bản, license và cập nhật phần mềm
         về một chỗ, thay cho popup license + card cập nhật rải rác ở tab Thông tin. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18,6,18,18" RowDefinitions="Auto,Auto" RowSpacing="14">

            <!-- ===== Tiêu đề ===== -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border Grid.Column="0"
                        Width="42" Height="42"
                        CornerRadius="14"
                        Background="{StaticResource AccentSoft}"
                        BorderBrush="{StaticResource LineAccent}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <Path Width="20" Height="20"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Stretch="Uniform"
                          Stroke="{StaticResource Accent}"
                          StrokeThickness="1.9"
                          StrokeLineCap="Round"
                          StrokeJoin="Round"
                          Data="{StaticResource Icon.InfoCircle}" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Giới thiệu" Classes="pageTitle" />
                    <TextBlock Classes="label"
                               FontSize="12"
                               Text="Phiên bản phần mềm, giấy phép sử dụng và cập nhật." />
                </StackPanel>

                <Border Grid.Column="2" Classes="pill" VerticalAlignment="Center">
                    <TextBlock Classes="mono" Text="{Binding AppVersionText}" />
                </Border>
            </Grid>

            <!-- ===== Nội dung: license (trái) + cập nhật / thông tin (phải) ===== -->
            <Grid Grid.Row="1" ColumnDefinitions="1.05*,0.95*" ColumnSpacing="14">

                <!-- ==================== LICENSE ==================== -->
                <Border Grid.Column="0" Classes="panel" Padding="18">
                    <StackPanel Spacing="14">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="overline" Text="GIẤY PHÉP SỬ DỤNG" />
                                <TextBlock Classes="label" FontSize="12" Text="Sản phẩm: TanTienQR" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Classes="badge"
                                    Classes.running="{Binding IsLicenseRunning}"
                                    Classes.warning="{Binding IsLicenseWarning}"
                                    Classes.fault="{Binding IsLicenseFault}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding LicenseStatusText}" />
                            </Border>
                        </Grid>

                        <!-- Thông tin license -->
                        <Border Classes="device" Padding="14">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                                <Grid ColumnDefinitions="120,*" ColumnSpacing="12">
                                    <TextBlock Classes="label" FontSize="11" Text="KHÁCH HÀNG" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding LicenseCustomerText}"
                                               Text="{Binding LicenseCustomerText}" />
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="120,*" ColumnSpacing="12">
                                    <TextBlock Classes="label" FontSize="11" Text="HẾT HẠN" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="mono" FontSize="13"
                                               Text="{Binding LicenseExpiryText}" />
                                </Grid>
                                <Grid Grid.Row="2" ColumnDefinitions="120,*" ColumnSpacing="12">
                                    <TextBlock Classes="label" FontSize="11" Text="THỜI GIAN CÒN LẠI" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                                               Text="{Binding LicenseDaysLeftText}" />
                                </Grid>
                                <Grid Grid.Row="3" ColumnDefinitions="120,*" ColumnSpacing="12">
                                    <TextBlock Classes="label" FontSize="11" Text="GÓI MODULE" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap"
                                               Text="{Binding LicenseModulesText}" />
                                </Grid>
                                <Grid Grid.Row="4" ColumnDefinitions="120,*,Auto" ColumnSpacing="12">
                                    <TextBlock Classes="label" FontSize="11" Text="MÃ MÁY (HWID)" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Classes="mono" FontSize="11"
                                               Foreground="{StaticResource TextMuted}"
                                               TextWrapping="Wrap"
                                               Text="{Binding HwidText}" />
                                    <Button Grid.Column="2"
                                            Classes="chip"
                                            MinHeight="26"
                                            MinWidth="0"
                                            Padding="10,0"
                                            FontSize="10"
                                            VerticalAlignment="Top"
                                            Content="{Binding CopyHwidButtonText}"
                                            ToolTip.Tip="Sao chép mã máy (HWID) vào clipboard"
                                            Command="{Binding CopyHwidCommand}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Cảnh báo khi license lỗi -->
                        <Border Padding="12"
                                CornerRadius="9"
                                Background="{StaticResource DangerSoft}"
                                BorderBrush="{StaticResource Danger}"
                                BorderThickness="1"
                                IsVisible="{Binding !IsLicenseValid}">
                            <TextBlock Text="{Binding LicenseMessageText}"
                                       FontSize="12"
                                       Foreground="{StaticResource Danger}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- Yêu cầu cấp license -->
                        <Border Classes="device" Padding="14">
                            <StackPanel Spacing="8" IsEnabled="{Binding !RequestLicenseCommand.IsRunning}">
                                <TextBlock Text="Yêu cầu cấp license" FontSize="15" FontWeight="Bold" />
                                <TextBlock Classes="label" FontSize="11" TextWrapping="Wrap"
                                           Text="Gửi HWID của máy này đến nhà cung cấp. Sau khi được cấp, nhập file .lic để kích hoạt." />
                                <TextBox Text="{Binding LicensePortalUrl, Mode=TwoWay}"
                                         PlaceholderText="URL License Portal (https://...workers.dev)" />
                                <TextBox Text="{Binding LicenseRequestCustomer, Mode=TwoWay}" MaxLength="200"
                                         PlaceholderText="Tên khách hàng / công ty (tuỳ chọn)" />
                                <TextBox Text="{Binding LicenseRequestContact, Mode=TwoWay}" MaxLength="200"
                                         PlaceholderText="Email / số điện thoại liên hệ (tuỳ chọn)" />
                                <TextBox Text="{Binding LicenseRequestNote, Mode=TwoWay}" MaxLength="1000"
                                         PlaceholderText="Ghi chú cấp license (tuỳ chọn)" />
                                <Button Classes="soft" HorizontalAlignment="Stretch"
                                        Content="Gửi yêu cầu cấp license"
                                        Command="{Binding RequestLicenseCommand}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="label" FontSize="12" TextWrapping="Wrap"
                                   Classes.request-error="{Binding IsLicenseRequestError}"
                                   IsVisible="{Binding HasLicenseRequestMessage}"
                                   Text="{Binding LicenseRequestMessage}" />

                        <!-- Hành động -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Classes="soft"
                                    HorizontalAlignment="Stretch"
                                    Content="Nhập license từ file .lic..."
                                    Command="{Binding ImportLicenseCommand}" />
                            <Button Grid.Column="1" Classes="soft"
                                    HorizontalAlignment="Stretch"
                                    Content="Hủy license hiện tại"
                                    IsVisible="{Binding IsLicenseValid}"
                                    Command="{Binding RevokeLicenseCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================== CỘT PHẢI ==================== -->
                <StackPanel Grid.Column="1" Spacing="14">

                    <!-- Cập nhật phần mềm -->
                    <Border Classes="panel" Padding="18"
                            DataContext="{Binding Updates}"
                            x:DataType="services:UpdateClient">
                        <StackPanel Spacing="9" IsEnabled="{Binding !IsBusy}">
                            <TextBlock Classes="overline" Text="CẬP NHẬT PHẦN MỀM" />
                            <TextBlock Text="{Binding CurrentVersion, StringFormat='Đang dùng: {0}'}" />
                            <TextBlock Text="{Binding LastResult}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding AvailableVersion, StringFormat='Bản mới: {0}'}" />
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" MaxHeight="120" />
                            <StackPanel Spacing="8">
                                <Button Classes="soft" HorizontalAlignment="Stretch"
                                        Content="Kiểm tra bản mới"
                                        Command="{Binding CheckCommand}" />
                                <Button Classes="soft" HorizontalAlignment="Stretch"
                                        Content="Tải bản cập nhật"
                                        IsVisible="{Binding CanDownload}"
                                        Command="{Binding DownloadCommand}" />
                                <Button Classes="primary" HorizontalAlignment="Stretch"
                                        Content="Cài đặt và khởi động lại"
                                        IsVisible="{Binding CanInstall}"
                                        Command="{Binding InstallCommand}" />
                            </StackPanel>
                            <TextBlock Classes="label" FontSize="11" TextWrapping="Wrap"
                                       Text="Chỉ cài khi dây chuyền đã dừng. Cần đăng nhập Quản trị / Lập trình viên và license hợp lệ." />
                        </StackPanel>
                    </Border>

                    <!-- Thông tin ứng dụng -->
                    <Border Classes="panel" Padding="18">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="overline" Text="THÔNG TIN ỨNG DỤNG" />

                            <Grid ColumnDefinitions="120,*" ColumnSpacing="12">
                                <TextBlock Classes="label" FontSize="11" Text="SẢN PHẨM" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                                           Text="TanTienQR · Quét mã - PLC Omron" />
                            </Grid>
                            <Grid ColumnDefinitions="120,*" ColumnSpacing="12">
                                <TextBlock Classes="label" FontSize="11" Text="PHIÊN BẢN" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="mono" FontSize="13"
                                           Text="{Binding AppVersionText}" />
                            </Grid>
                            <Grid ColumnDefinitions="120,*" ColumnSpacing="12">
                                <TextBlock Classes="label" FontSize="11" Text="LICENSE" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                                           Text="{Binding LicenseStatusText}" />
                            </Grid>
                            <Grid ColumnDefinitions="120,*" ColumnSpacing="12">
                                <TextBlock Classes="label" FontSize="11" Text="HẾT HẠN" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="mono" FontSize="13"
                                           Text="{Binding LicenseExpiryText}" />
                            </Grid>

                            <TextBlock Classes="label" FontSize="11" TextWrapping="Wrap"
                                       Text="Gửi mã máy (HWID) cho nhà cung cấp để được cấp file license.lic, sau đó nhập license ở cột bên trái." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
