<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TanTienQR.ViewModels"
        xmlns:views="using:TanTienQR.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="820"
        x:Class="TanTienQR.Views.LoginShellWindow"
        x:DataType="vm:LoginViewModel"
        Icon="/Assets/tantien-logo.ico"
        Title="TanTienQR · Đăng nhập"
        Width="1360" Height="820"
        MinWidth="1100" MinHeight="700"
        CanResize="True"
        CanMinimize="True"
        CanMaximize="True"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:LoginViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Viền accent trên cùng của custom chrome -->
        <Border Grid.Row="0" Height="3" Background="{StaticResource Accent}" />

        <!-- ===== Thanh tiêu đề tự vẽ ===== -->
        <Border Grid.Row="1" x:Name="HeaderBar"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource LineColor}"
                BorderThickness="0,0,0,1"
                Padding="16,8,8,8"
                PointerPressed="OnHeaderPointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="38" Height="38"
                            CornerRadius="11"
                            Background="White"
                            BorderBrush="{StaticResource LineAccent}"
                            BorderThickness="1">
                        <Image Source="/Assets/tantien-logo-tt.png"
                               Stretch="Uniform"
                               Margin="3" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="TanTienQR"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="Quét mã · PLC"
                                   Classes="label"
                                   FontSize="10" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="Đăng nhập để tiếp tục"
                           Classes="label"
                           FontSize="12"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="MinButton"
                            Width="34" Height="34"
                            MinWidth="0" MinHeight="0"
                            Padding="0"
                            CornerRadius="17"
                            Background="{StaticResource BgRaised}"
                            BorderBrush="{StaticResource LineColor}"
                            BorderThickness="1"
                            Foreground="{StaticResource TextPrimary}"
                            FontSize="14"
                            FontWeight="Bold"
                            Content="–"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="Thu nhỏ"
                            Click="OnMinimizeClick" />
                    <Button x:Name="MaxButton"
                            Width="34" Height="34"
                            MinWidth="0" MinHeight="0"
                            Padding="0"
                            CornerRadius="17"
                            Background="{StaticResource BgRaised}"
                            BorderBrush="{StaticResource LineColor}"
                            BorderThickness="1"
                            Foreground="{StaticResource TextPrimary}"
                            FontSize="12"
                            FontWeight="Bold"
                            Content="▢"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="Phóng to / khôi phục"
                            Click="OnMaxRestoreClick" />
                    <Button x:Name="FullScreenButton"
                            Width="34" Height="34"
                            MinWidth="0" MinHeight="0"
                            Padding="0"
                            CornerRadius="17"
                            Background="{StaticResource BgRaised}"
                            BorderBrush="{StaticResource LineColor}"
                            BorderThickness="1"
                            Foreground="{StaticResource TextPrimary}"
                            FontSize="12"
                            FontWeight="Bold"
                            Content="⛶"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="Toàn màn hình (F11)"
                            Click="OnFullScreenClick" />
                    <Button x:Name="CloseButton"
                            Width="34" Height="34"
                            MinWidth="0" MinHeight="0"
                            Padding="0"
                            CornerRadius="17"
                            Background="{StaticResource DangerSoft}"
                            BorderBrush="{StaticResource LineDanger}"
                            BorderThickness="1"
                            Foreground="{StaticResource Danger}"
                            FontSize="12"
                            FontWeight="Bold"
                            Content="✕"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="Thoát ứng dụng"
                            Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Ruột đăng nhập =====
             Tách sang LoginView để dùng lại được làm OVERLAY trong
             MainWindow (không tạo/đóng 2 cửa sổ -> hết giật khi bấm đăng nhập).
             Wrapper này giữ lại để trình xem trước / audit harness không vỡ. -->
        <views:LoginView Grid.Row="2" />
    </Grid>
</Window>
