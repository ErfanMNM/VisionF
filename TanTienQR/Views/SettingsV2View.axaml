<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TanTienQR.ViewModels"
             xmlns:views="using:TanTienQR.Views"
             x:Class="TanTienQR.Views.SettingsV2View"
             x:DataType="vm:MainViewModel">
    <UserControl.Resources>
        <DataTemplate x:Key="FlowNodeTemplate" DataType="vm:SettingsV2NodeViewModel">
            <Button Classes="flowNode" Classes.selected="{Binding IsSelected}"
                    Command="{Binding SelectCommand}" Width="218" Height="94"
                    AutomationProperties.Name="{Binding Title}">
                <Grid ColumnDefinitions="42,*" ColumnSpacing="10">
                    <Border Background="#f0f3f9" CornerRadius="13" Width="42" Height="48">
                        <Path Data="{Binding Section.IconGeometry}" Width="24" Height="24"
                              Stretch="Uniform" Stroke="{Binding StatusBrush}" StrokeThickness="1.7"
                              StrokeLineCap="Round" StrokeJoin="Round" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"
                                       Foreground="#111a2e" TextTrimming="CharacterEllipsis" />
                            <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{Binding StatusBrush}"
                                     VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding Endpoint}" FontSize="11" Foreground="#45506a"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Endpoint}" />
                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{Binding StatusBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="SectionEditorTemplate" DataType="vm:ConfigSectionViewModel">
            <views:SettingsV2SectionEditor />
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Button.flowNode">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#dfe4ef" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.flowNode.selected">
            <Setter Property="BorderBrush" Value="#2456d6" />
            <Setter Property="BorderThickness" Value="2.5" />
            <Setter Property="Background" Value="#f1f5ff" />
        </Style>
        <Style Selector="Button.flowNode:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#f1f5ff" />
        </Style>
        <Style Selector="Button.flowTab">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#56617a" />
            <Setter Property="BorderBrush" Value="#dfe4ef" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.flowTab.selected">
            <Setter Property="Background" Value="#2456d6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#2456d6" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="16" RowDefinitions="Auto,*,Auto" RowSpacing="12" IsEnabled="{Binding CanEditConfig}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
                <TextBlock Classes="pageTitle" Text="Thiết bị &amp; Module" />
                <TextBlock Text="Chọn một khối để chỉnh thông số. QRBox là cấu hình PLC."
                           Foreground="#56617a" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="flowTab" Classes.selected="{Binding !SettingsV2.IsOtherSettingsVisible}"
                        Command="{Binding SettingsV2.ShowFlowCommand}" Content="Sơ đồ thiết bị" />
                <Button Classes="flowTab" Classes.selected="{Binding SettingsV2.IsOtherSettingsVisible}"
                        Command="{Binding SettingsV2.ShowOtherSettingsCommand}" Content="Cài đặt khác" />
            </StackPanel>
        </Grid>

        <!-- Like the supplied flow reference, the diagram can scroll at compact
             workstation sizes while the property inspector remains available. -->
        <Grid Grid.Row="1" ColumnDefinitions="*,350" ColumnSpacing="14"
              IsVisible="{Binding !SettingsV2.IsOtherSettingsVisible}">
            <Border Background="White" BorderBrush="#dfe4ef" BorderThickness="1" CornerRadius="22" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Margin="16,14" ColumnDefinitions="*,Auto">
                        <TextBlock Text="SƠ ĐỒ KẾT NỐI" FontSize="11" FontWeight="Bold" Foreground="#56617a" />
                        <Border Grid.Column="1" Background="#f0f3f9" CornerRadius="9" Padding="8,3">
                            <TextBlock Text="V2 · THỬ NGHIỆM" FontSize="9" FontWeight="Bold" Foreground="#56617a" />
                        </Border>
                    </Grid>
                    <ScrollViewer x:Name="FlowScroller" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Canvas Width="750" Height="510" Background="#fafbfe">
                            <!-- Connectors express the flow; gray service links
                                 intentionally do not imply a live connection. -->
                            <Path Data="M236 79 C280 79 270 211 310 211" Stroke="{Binding SettingsV2.Scanner.StatusBrush}" StrokeThickness="3" StrokeDashArray="3,5" />
                            <Path Data="M236 191 C278 191 276 239 310 239" Stroke="{Binding SettingsV2.Gateway.StatusBrush}" StrokeThickness="3" StrokeDashArray="3,5" />
                            <Path Data="M236 303 C278 303 276 267 310 267" Stroke="{Binding SettingsV2.Camera.StatusBrush}" StrokeThickness="3" StrokeDashArray="3,5" />
                            <Path Data="M236 415 C280 415 270 295 310 295" Stroke="{Binding SettingsV2.Printer.StatusBrush}" StrokeThickness="3" StrokeDashArray="3,5" />
                            <Path Data="M440 211 C482 211 470 79 514 79" Stroke="#c9d1e2" StrokeThickness="3" StrokeDashArray="3,5" />
                            <Path Data="M440 239 C480 239 476 191 514 191" Stroke="#c9d1e2" StrokeThickness="3" StrokeDashArray="3,5" />
                            <Path Data="M440 267 C480 267 476 303 514 303" Stroke="#c9d1e2" StrokeThickness="3" StrokeDashArray="3,5" />
                            <Path Data="M440 295 C482 295 470 415 514 415" Stroke="#c9d1e2" StrokeThickness="3" StrokeDashArray="3,5" />
                            <ItemsControl Canvas.Left="18" Canvas.Top="32"
                                          ItemsSource="{Binding SettingsV2.InputNodes}" ItemTemplate="{StaticResource FlowNodeTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Spacing="18" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ItemsControl Canvas.Left="514" Canvas.Top="32"
                                          ItemsSource="{Binding SettingsV2.OutputNodes}" ItemTemplate="{StaticResource FlowNodeTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Spacing="18" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <StackPanel Canvas.Left="298" Canvas.Top="155" Width="154" Spacing="9">
                                <TextBlock Text="PLC · FINS / UDP" FontWeight="Bold" FontSize="10" Foreground="#2456d6" HorizontalAlignment="Center" />
                                <Button x:Name="QrBoxNode" Width="130" Height="130" CornerRadius="30" Background="#2456d6"
                                        BorderBrush="#c7d7ff" BorderThickness="4"
                                        Command="{Binding SettingsV2.QrBox.SelectCommand}" AutomationProperties.Name="QRBox · cấu hình PLC">
                                    <StackPanel Spacing="9" HorizontalAlignment="Center">
                                        <Path Width="38" Height="38" Stretch="Uniform" Stroke="White" StrokeThickness="1.6"
                                              Data="M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h3v3h-3z M18 18h3v3h-3z" />
                                        <TextBlock Text="QRBox" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding PlcStatusText}" Foreground="{Binding SettingsV2.QrBox.StatusBrush}"
                                           FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding SettingsV2.QrBox.Endpoint}" FontSize="10" Foreground="#45506a"
                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="154" />
                            </StackPanel>
                        </Canvas>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="16,10,16,14" Spacing="4">
                        <TextBlock Text="{Binding SettingsV2.RuntimeSummary}" FontSize="11" Foreground="#56617a" TextWrapping="Wrap" />
                        <TextBlock Text="Địa chỉ trên sơ đồ là bản nháp. Camera / PLC / Printer báo trạng thái thực tế; các khối dịch vụ chỉ báo cấu hình."
                                   FontSize="10" Foreground="#738097" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="PropertyInspector" Grid.Column="1" Background="White" BorderBrush="#dfe4ef" BorderThickness="1" CornerRadius="22" Padding="18">
                <Grid RowDefinitions="Auto,*" RowSpacing="14">
                    <StackPanel Spacing="5">
                        <TextBlock Text="THUỘC TÍNH" FontSize="10" FontWeight="Bold" Foreground="#56617a" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{Binding SettingsV2.SelectedTitle}" FontSize="19" FontWeight="Bold" Foreground="#111a2e" TextWrapping="Wrap" />
                            <Border Grid.Column="1" Background="#edf2ff" CornerRadius="8" Padding="8,4" VerticalAlignment="Top">
                                <TextBlock Text="{Binding SettingsV2.SelectedProtocol}" Foreground="#2456d6" FontSize="10" FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  IsEnabled="{Binding !ConfigEditor.IsSaving}">
                        <ContentControl Content="{Binding SettingsV2.SelectedSection}" ContentTemplate="{StaticResource SectionEditorTemplate}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- All non-diagram settings stay reachable in one separate area. -->
        <Grid Grid.Row="1" ColumnDefinitions="260,*" ColumnSpacing="14" IsVisible="{Binding SettingsV2.IsOtherSettingsVisible}">
            <Border Background="White" BorderBrush="#dfe4ef" BorderThickness="1" CornerRadius="22" Padding="14">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Cài đặt khác" FontSize="18" FontWeight="Bold" Foreground="#111a2e" />
                        <TextBlock Text="Bảo mật, lịch sử, license và các tiện ích" FontSize="11" Foreground="#56617a" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding SettingsV2.OtherSections}"
                             SelectedItem="{Binding SettingsV2.SelectedOtherSection, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:ConfigSectionViewModel">
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="12" Margin="0,8" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="White" BorderBrush="#dfe4ef" BorderThickness="1" CornerRadius="22" Padding="22">
                <Grid RowDefinitions="Auto,*" RowSpacing="16">
                    <TextBlock Text="{Binding SettingsV2.SelectedTitle}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" Foreground="#111a2e" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  IsEnabled="{Binding !ConfigEditor.IsSaving}">
                        <ContentControl MaxWidth="660" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch"
                                        Content="{Binding SettingsV2.SelectedSection}" ContentTemplate="{StaticResource SectionEditorTemplate}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#dfe4ef" BorderThickness="1" CornerRadius="16" Padding="14,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <StackPanel Spacing="5" VerticalAlignment="Center">
                    <TextBlock Text="Dùng chung bản nháp với Cấu hình. Lưu áp dụng cho toàn bộ nhóm đã sửa. Camera / PLC áp dụng ngay sau xác nhận."
                               FontSize="11" Foreground="#56617a" TextWrapping="Wrap" />
                    <StackPanel IsVisible="{Binding ConfigEditor.HasMessage}">
                        <TextBlock Text="{Binding ConfigEditor.ConfigMessageText}" FontSize="11" Foreground="#2456d6" TextWrapping="Wrap"
                                   IsVisible="{Binding !ConfigEditor.HasErrorMessage}" />
                        <TextBlock Text="{Binding ConfigEditor.ConfigMessageText}" FontSize="11" Foreground="#b4202c" TextWrapping="Wrap"
                                   IsVisible="{Binding ConfigEditor.HasErrorMessage}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ConfigEditor.RestartBannerText}" FontSize="11" Foreground="#8a5700" TextWrapping="Wrap"
                               IsVisible="{Binding ConfigEditor.RestartRequired}" />
                    <TextBlock Text="appsettings.Development.json đang ghi đè cấu hình khi khởi động."
                               FontSize="11" Foreground="#8a5700" TextWrapping="Wrap"
                               IsVisible="{Binding ConfigEditor.HasDevelopmentOverride}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="chip" Content="Hoàn tác" Command="{Binding ConfigEditor.ResetCommand}" IsEnabled="{Binding ConfigEditor.CanReset}" />
                        <Button Classes="flowTab" Classes.selected="True" Content="Lưu cấu hình"
                                Command="{Binding ConfigEditor.SaveCommand}" IsEnabled="{Binding ConfigEditor.CanSave}" />
                    </StackPanel>
                    <Button Classes="chip" Content="Khởi động lại để áp dụng" Command="{Binding ConfigEditor.RestartNowCommand}"
                            IsVisible="{Binding ConfigEditor.RestartRequired}" IsEnabled="{Binding ConfigEditor.CanRestartNow}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
