<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TanTienQR.ViewModels"
        xmlns:controls="using:TanTienQR.Controls"
        xmlns:d="http://schemas.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="480"
        x:Class="TanTienQR.Views.RecipeDeleteConfirmWindow"
        x:DataType="vm:RecipeDeleteConfirmViewModel"
        Title="Xoá recipe"
        Width="440" Height="480"
        MinWidth="400" MinHeight="440"
        CanResize="False"
        CanMinimize="False"
        CanMaximize="False"
        WindowStartupLocation="CenterOwner">

    <Border Background="{StaticResource BgBase}" Padding="26">
        <Grid RowDefinitions="Auto,*,Auto,Auto">

            <!-- Tiêu đề -->
            <StackPanel Grid.Row="0" Spacing="10">
                <Border Width="48" Height="48"
                        CornerRadius="15"
                        Background="{StaticResource DangerSoft}"
                        HorizontalAlignment="Center">
                    <TextBlock Text="🗑"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Xoá recipe"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"
                           HorizontalAlignment="Center" />
                <TextBlock FontSize="11.5"
                           Foreground="{StaticResource TextMuted}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           MaxWidth="340"
                           Text="Bộ tham số của recipe sẽ bị xoá khỏi hệ thống. Hãy nhập mật khẩu để xác nhận." />
            </StackPanel>

            <!-- Form -->
            <StackPanel Grid.Row="1" Spacing="14" Margin="0,18,0,0">

                <!-- Recipe sắp xoá -->
                <Border Classes="device" Padding="12">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="fieldLabel" Text="RECIPE SẮP XOÁ" />
                        <TextBlock Text="{Binding RecipeName}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Tài khoản -->
                <Border Classes="device" Padding="12">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="fieldLabel" Text="TÀI KHOẢN ĐANG ĐĂNG NHẬP" />
                        <TextBlock Text="{Binding Username}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" />
                    </StackPanel>
                </Border>

                <!-- Mật khẩu -->
                <StackPanel Spacing="6">
                    <TextBlock Classes="fieldLabel" Text="MẬT KHẨU *" />
                    <TextBox Classes="field"
                             Height="42"
                             PasswordChar="•"
                             PlaceholderText="Nhập mật khẩu để xác nhận"
                             Text="{Binding Password}" />
                </StackPanel>

                <!-- Lỗi -->
                <Border IsVisible="{Binding HasError}"
                        Padding="11"
                        CornerRadius="10"
                        Background="{StaticResource DangerSoft}"
                        BorderBrush="{StaticResource Danger}"
                        BorderThickness="1">
                    <TextBlock Text="{Binding ErrorMessage}"
                               FontSize="12"
                               Foreground="{StaticResource Danger}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <!-- Nút -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,16,0,0">
                <Button Grid.Column="0"
                        Classes="soft"
                        Height="44"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Content="Huỷ"
                        Click="OnCancelClick" />
                <Button Grid.Column="1"
                        Classes="primary"
                        Height="44"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        IsDefault="True"
                        Content="Xoá recipe"
                        IsEnabled="{Binding CanSubmit}"
                        Command="{Binding ConfirmCommand}" />
            </Grid>

            <!-- ===== Bàn phím ảo (máy cảm ứng) =====
                 HÀNG RIÊNG (Grid.Row="3") -> không phủ lên form.
                 Khi mở, code-behind tự giãn cao cửa sổ (xem RecipeDeleteConfirmWindow.axaml.cs).

                 Control tự quản lý IsVisible: chỉ cửa sổ đang sở hữu ô nhập
                 mới hiện bàn phím. Khi ẩn, hàng này co về 0 và form lấy lại
                 toàn bộ chỗ. -->
            <controls:VirtualKeyboard Grid.Row="3"
                                     Margin="0,12,0,-26"
                                     DataContext="{Binding Keyboard}" />
        </Grid>
    </Border>
</Window>
