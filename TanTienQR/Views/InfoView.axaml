<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TanTienQR.ViewModels"
             xmlns:controls="using:TanTienQR.Controls"
             xmlns:d="http://schemas.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="700"
             x:Class="TanTienQR.Views.InfoView"
             x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="Auto,Auto,*" Margin="18,6,18,18" RowSpacing="14">

        <!-- Tiêu đề -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="3">
                <TextBlock Text="Bảng điều khiển quét mã"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}" />
                <TextBlock Text="Nhận tín hiệu camera và gửi kết quả xuống PLC Omron (D12 = kết quả, D16 = Ready)"
                           Classes="label"
                           FontSize="12" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Classes="pill" Classes.ok="{Binding IsReady}" Classes.warn="{Binding !IsReady}">
                    <TextBlock Text="{Binding AppStateText}" />
                </Border>
                <Border Classes="pill" Classes.ok="{Binding IsPlcConnected}" Classes.danger="{Binding !IsPlcConnected}">
                    <TextBlock Text="{Binding PlcStatusText}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- KPI -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
            <Border Grid.Column="0" Classes="kpi">
                <StackPanel Spacing="3">
                    <TextBlock Classes="label" FontSize="11" Text="TỔNG SỐ LẦN QUÉT" />
                    <TextBlock Classes="kpiValue" Text="{Binding TotalScans}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="kpi">
                <StackPanel Spacing="3">
                    <TextBlock Classes="label" FontSize="11" Text="PASS" />
                    <TextBlock Classes="kpiValue" Foreground="{StaticResource Ok}" Text="{Binding PassCount}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Classes="kpi">
                <StackPanel Spacing="3">
                    <TextBlock Classes="label" FontSize="11" Text="FAIL" />
                    <TextBlock Classes="kpiValue" Foreground="{StaticResource Danger}" Text="{Binding FailCount}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Classes="kpi">
                <StackPanel Spacing="3">
                    <TextBlock Classes="label" FontSize="11" Text="TỶ LỆ ĐẠT" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="kpiValue" Text="{Binding PassRate}" />
                        <TextBlock Classes="unit" VerticalAlignment="Bottom" Margin="0,0,0,6" Text="%" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bảng quét + sự kiện -->
        <Grid Grid.Row="2" ColumnDefinitions="*,330" ColumnSpacing="12">

            <!-- Bảng mã quét -->
            <Border Grid.Column="0" Classes="panel" Padding="14,12">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <TextBlock Classes="sectionTitle" Text="LỊCH SỬ MÃ QUÉT" />
                            <TextBlock Classes="label" VerticalAlignment="Center" Text="{Binding TotalScans, StringFormat='Tổng: {0}'}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="label" VerticalAlignment="Center" Text="Mã cuối:" />
                            <TextBlock Classes="reading" Text="{Binding LastScanText}" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="label mono" VerticalAlignment="Center" Text="{Binding LastScanTimeText}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="6">
                        <!-- Header -->
                        <Grid Grid.Row="0" ColumnDefinitions="102,*,140,110,90,90" ColumnSpacing="8"
                              Margin="4,0,4,0">
                            <TextBlock Classes="label" FontSize="10" Text="GIỜ" />
                            <TextBlock Grid.Column="1" Classes="label" FontSize="10" Text="MÃ / SERIAL" />
                            <TextBlock Grid.Column="2" Classes="label" FontSize="10" Text="GTIN" />
                            <TextBlock Grid.Column="3" Classes="label" FontSize="10" Text="KẾT QUẢ" />
                            <TextBlock Grid.Column="4" Classes="label" FontSize="10" Text="XỬ LÝ" />
                            <TextBlock Grid.Column="5" Classes="label" FontSize="10" Text="GỬI PLC" />
                        </Grid>

                        <!-- Dữ liệu -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Scans}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScanRowViewModel">
                                        <Border Classes="event" Margin="0,1" Padding="10,7">
                                            <Grid ColumnDefinitions="102,*,140,110,90,90" ColumnSpacing="8">
                                                <TextBlock Classes="mono" FontSize="11" VerticalAlignment="Center" Text="{Binding TimeText}" />
                                                <TextBlock Grid.Column="1" Classes="mono" FontSize="12" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Text="{Binding CodeText}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Classes="mono" FontSize="11"
                                                           VerticalAlignment="Center" Text="{Binding GtinText}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="3" Classes="badge" Classes.running="{Binding IsPass}" Classes.warning="{Binding IsWarningOutcome}" Classes.fault="{Binding IsInvalid}">
                                                    <TextBlock Text="{Binding OutcomeText}" />
                                                </Border>
                                                <TextBlock Grid.Column="4" Classes="mono" FontSize="11"
                                                           VerticalAlignment="Center" Text="{Binding ProcessingTimeText}" />
                                                <TextBlock Grid.Column="5" Classes="label" FontSize="11" VerticalAlignment="Center" Text="{Binding PlcText}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- Sự kiện gần đây + Thông tin sản xuất -->
            <Border Grid.Column="1" Classes="panel" Padding="8,10">
                <TabControl>
                    <TabItem Header="Sự kiện gần đây">
                        <Grid RowDefinitions="Auto,*" RowSpacing="10" Margin="6,8,6,4">
                            <TextBlock Classes="sectionTitle" Text="SỰ KIỆN GẦN ĐÂY" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Events}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ScanEvent">
                                            <Border Classes="event" Margin="0,2" Padding="9,7">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                                    <Border Classes="stripe" Classes.warning="{Binding IsWarning}" Classes.critical="{Binding IsCritical}" />
                                                    <TextBlock Grid.Column="1" FontSize="11" TextWrapping="Wrap" MaxLines="2"
                                                               VerticalAlignment="Center" Text="{Binding Message}" />
                                                    <TextBlock Grid.Column="2" Classes="label mono" FontSize="10"
                                                               VerticalAlignment="Center" Text="{Binding TimeText}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Thông tin sản xuất">
                        <Grid RowDefinitions="Auto,*" Margin="10,8,10,6">
                            <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,10">
                                <TextBlock Classes="sectionTitle"
                                           FontSize="15"
                                           Foreground="{StaticResource TextPrimary}"
                                           Text="Thông tin sản xuất" />
                                <Border Height="3"
                                        Width="46"
                                        HorizontalAlignment="Left"
                                        CornerRadius="2"
                                        Background="{StaticResource Accent}" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="9">

                                    <!-- ===== Chọn PO và chạy ===== -->
                                    <Border Classes="device" Padding="11,10">
                                        <StackPanel Spacing="8">

                                            <TextBlock Classes="label" FontSize="10"
                                                       Text="CHỌN LỆNH SẢN XUẤT" />

                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                                <ComboBox MinHeight="33"
                                                          HorizontalAlignment="Stretch"
                                                          ItemsSource="{Binding ProductionInfo.Orders.Orders}"
                                                          SelectedItem="{Binding ProductionInfo.Orders.SelectedOrder}"
                                                          PlaceholderText="Chọn PO...">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ProductionOrderRowViewModel">
                                                            <TextBlock FontSize="11.5" Text="{Binding OrderNo}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>

                                                <Button Grid.Column="1"
                                                        Classes="soft"
                                                        MinHeight="33"
                                                        MinWidth="0"
                                                        Padding="9,0"
                                                        FontSize="11"
                                                        FontWeight="Normal"
                                                        VerticalAlignment="Stretch"
                                                        Content="⇩ Tải PO"
                                                        IsEnabled="{Binding !ProductionInfo.IsBusy}"
                                                        Command="{Binding ProductionInfo.Orders.DownloadOrdersCommand}" />
                                            </Grid>

                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="7">
                                                <Button Grid.Column="0"
                                                        Classes="primary"
                                                        MinHeight="34"
                                                        MinWidth="0"
                                                        Padding="8,0"
                                                        FontSize="12"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Content="▶ Bắt đầu"
                                                        IsEnabled="{Binding ProductionInfo.CanStart}"
                                                        Command="{Binding ProductionInfo.Orders.StartProductionCommand}" />

                                                <Button Grid.Column="1"
                                                        Classes="soft"
                                                        MinHeight="34"
                                                        MinWidth="0"
                                                        Padding="8,0"
                                                        FontSize="12"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Content="✓ Hoàn tất"
                                                        IsEnabled="{Binding ProductionInfo.CanComplete}"
                                                        Command="{Binding ProductionInfo.Orders.CompleteProductionCommand}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- ===== Tiến trình + số liệu ===== -->
                                    <Border Classes="device" Padding="11,10">
                                        <StackPanel Spacing="9">

                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Classes="label" FontSize="10" Text="LỆNH SẢN XUẤT" />
                                                    <TextBlock Classes="mono" FontSize="12.5" FontWeight="Bold"
                                                               Foreground="{StaticResource TextPrimary}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding ProductionInfo.OrderNoText}" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Classes="badge"
                                                        VerticalAlignment="Center"
                                                        Classes.running="{Binding ProductionInfo.IsRunning}">
                                                    <TextBlock FontSize="10" Text="{Binding ProductionInfo.StatusText}" />
                                                </Border>
                                            </Grid>

                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                <!-- Donut tiến trình -->
                                                <StackPanel Grid.Column="0"
                                                            Width="82"
                                                            HorizontalAlignment="Left"
                                                            Spacing="2">
                                                    <controls:DonutProgress Width="82"
                                                                          Height="82"
                                                                          Value="{Binding ProductionInfo.ProgressPercent}"
                                                                          Thickness="7" />
                                                    <TextBlock Classes="label" FontSize="9"
                                                               HorizontalAlignment="Center"
                                                               TextAlignment="Center"
                                                               Text="Tiến trình sản xuất" />
                                                </StackPanel>

                                                <!-- Số liệu -->
                                                <StackPanel Grid.Column="1" Spacing="11" VerticalAlignment="Center">
                                                    <StackPanel Spacing="1">
                                                        <TextBlock Classes="label" FontSize="10" Text="SỐ LƯỢNG ĐƠN" />
                                                        <TextBlock Classes="mono" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimary}"
                                                                   Text="{Binding ProductionInfo.OrderQtyText}" />
                                                    </StackPanel>

                                                    <StackPanel Spacing="1">
                                                        <TextBlock Classes="label" FontSize="10" Text="ĐÃ QUÉT / TỔNG" />
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Classes="mono" FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimary}"
                                                                       Text="{Binding ProductionInfo.ScannedText}" />
                                                            <TextBlock Classes="mono" FontSize="13"
                                                                       Foreground="{StaticResource TextMuted}"
                                                                       Text="/" />
                                                            <TextBlock Classes="mono" FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimary}"
                                                                       Text="{Binding ProductionInfo.OrderQtyText}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- ===== Mốc thời gian (timeline) ===== -->
                                    <Border Classes="device" Padding="11,10">
                                        <StackPanel Spacing="0">

                                            <!-- Tạo PO -->
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                                <Ellipse Grid.Column="0" Width="9" Height="9"
                                                         VerticalAlignment="Top" Margin="0,3,0,0"
                                                         Fill="{StaticResource Idle}" />
                                                <TextBlock Grid.Column="1" Classes="label" FontSize="11"
                                                           Text="Tạo PO" />
                                                <TextBlock Grid.Column="1" Classes="mono" FontSize="11"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           Text="{Binding ProductionInfo.CreatedText}" />
                                            </Grid>

                                            <!-- Bắt đầu -->
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9" Margin="0,7,0,0">
                                                <Ellipse Grid.Column="0" Width="9" Height="9"
                                                         VerticalAlignment="Top" Margin="0,3,0,0"
                                                         Fill="{StaticResource Accent}" />
                                                <TextBlock Grid.Column="1" Classes="label" FontSize="11"
                                                           Text="Bắt đầu" />
                                                <TextBlock Grid.Column="1" Classes="mono" FontSize="11"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           Text="{Binding ProductionInfo.StartedText}" />
                                            </Grid>

                                            <!-- Hoàn tất -->
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9" Margin="0,7,0,0">
                                                <Ellipse Grid.Column="0" Width="9" Height="9"
                                                         VerticalAlignment="Top" Margin="0,3,0,0"
                                                         Fill="Transparent"
                                                         Stroke="{StaticResource LineColor}"
                                                         StrokeThickness="1.5" />
                                                <TextBlock Grid.Column="1" Classes="label" FontSize="11"
                                                           Text="Hoàn tất" />
                                                <TextBlock Grid.Column="1" Classes="mono" FontSize="11"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           Text="{Binding ProductionInfo.CompletedText}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
