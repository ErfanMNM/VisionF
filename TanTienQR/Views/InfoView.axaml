<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TanTienQR.ViewModels"
             xmlns:d="http://schemas.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
             x:Class="TanTienQR.Views.InfoView"
             x:DataType="vm:MainViewModel">

    <!-- Bố cục 3 cột theo mẫu Dashboard 4:
         cột trái (sidebar app) | cột giữa (KPI + bảng quét) | cột phải 352px
         (Thông tin sản xuất + Sự kiện gần đây).
         Cột giữa dùng tỉ lệ (1.6*) để luôn rộng hơn cột phải, tránh bị bóp. -->
    <Grid ColumnDefinitions="1.6*,352" ColumnSpacing="16" Margin="16,18,20,18">

        <!-- ==================== CỘT GIỮA ==================== -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="12">

            <!-- Tiêu đề trang -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="3">
                    <TextBlock Text="Bảng điều khiển quét mã"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="Nhận tín hiệu camera và gửi kết quả xuống PLC Omron (D12 = kết quả, D16 = Ready)"
                               Classes="label"
                               FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Classes="pill" Classes.ok="{Binding IsReady}" Classes.warn="{Binding !IsReady}">
                        <TextBlock Text="{Binding AppStateText}" />
                    </Border>
                    <Border Classes="pill" Classes.ok="{Binding IsPlcConnected}" Classes.danger="{Binding !IsPlcConnected}">
                        <TextBlock Text="{Binding PlcStatusText}" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- KPI: 1 khối liền, chia bằng border-right (giống mẫu) -->
            <Border Grid.Row="1"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource LineColor}"
                    BorderThickness="1"
                    CornerRadius="16">
                <Grid ColumnDefinitions="*,*,*,*">
                    <!-- Tổng số lần quét -->
                    <StackPanel Grid.Column="0" Margin="18,12" Spacing="8">
                        <TextBlock Classes="overline" Text="TỔNG SỐ LẦN QUÉT" />
                        <TextBlock Classes="mono" FontSize="34" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" Text="{Binding TotalScans}" />
                    </StackPanel>

                    <!-- Pass -->
                    <StackPanel Grid.Column="1" Margin="18,12" Spacing="8">
                        <TextBlock Classes="overline" Text="PASS" />
                        <TextBlock Classes="mono" FontSize="34" FontWeight="Bold"
                                   Foreground="{StaticResource Ok}" Text="{Binding PassCount}" />
                    </StackPanel>

                    <!-- Fail -->
                    <StackPanel Grid.Column="2" Margin="18,12" Spacing="8">
                        <TextBlock Classes="overline" Text="FAIL" />
                        <TextBlock Classes="mono" FontSize="34" FontWeight="Bold"
                                   Foreground="{StaticResource Danger}" Text="{Binding FailCount}" />
                    </StackPanel>

                    <!-- Tỷ lệ đạt -->
                    <StackPanel Grid.Column="3" Margin="18,12" Spacing="8">
                        <TextBlock Classes="overline" Text="TỶ LỆ ĐẠT" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="mono" FontSize="34" FontWeight="Bold"
                                       Foreground="{StaticResource Warn}" Text="{Binding PassRate}" />
                            <TextBlock Classes="mono" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Bottom" Margin="0,0,0,6" Text="%" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bảng lịch sử mã quét -->
            <Border Grid.Row="2"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource LineColor}"
                    BorderThickness="1"
                    CornerRadius="16">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">

                    <!-- Header bảng -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="overline"
                                       FontSize="14"
                                       LetterSpacing="0.1"
                                       Foreground="{StaticResource TextPrimary}"
                                       Text="LỊCH SỰ MÃ QUÉT" />
                            <Border Background="{StaticResource BgRaised}"
                                    CornerRadius="10"
                                    Padding="10,3">
                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           Text="{Binding TotalScans, StringFormat='Tổng: {0}'}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="label" FontSize="13" VerticalAlignment="Center" Text="Mã cuối:" />
                            <TextBlock Classes="mono" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center"
                                       Text="{Binding LastScanText}" />
                            <TextBlock Classes="label mono" FontSize="11"
                                       VerticalAlignment="Center" Text="{Binding LastScanTimeText}" />
                        </StackPanel>
                    </Grid>

                    <!-- Header cột -->
                    <Grid Grid.Row="1"
                          ColumnDefinitions="90,1.6*,1.2*,100,110,100"
                          ColumnSpacing="12"
                          Margin="20,0"
                          Background="#F8F9FB">
                        <Border Grid.Row="0" Grid.Column="0"
                                BorderBrush="{StaticResource LineColor}"
                                BorderThickness="0,0,0,1"
                                Margin="0,9,0,9">
                            <TextBlock Classes="overline" Text="GIỜ" />
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1"
                                BorderBrush="{StaticResource LineColor}"
                                BorderThickness="0,0,0,1"
                                Margin="0,9,0,9">
                            <TextBlock Classes="overline" Text="MÃ / SERIAL" />
                        </Border>
                        <Border Grid.Row="0" Grid.Column="2"
                                BorderBrush="{StaticResource LineColor}"
                                BorderThickness="0,0,0,1"
                                Margin="0,9,0,9">
                            <TextBlock Classes="overline" Text="GTIN" />
                        </Border>
                        <Border Grid.Row="0" Grid.Column="3"
                                BorderBrush="{StaticResource LineColor}"
                                BorderThickness="0,0,0,1"
                                Margin="0,9,0,9">
                            <TextBlock Classes="overline" Text="KẾT QUẢ" />
                        </Border>
                        <Border Grid.Row="0" Grid.Column="4"
                                BorderBrush="{StaticResource LineColor}"
                                BorderThickness="0,0,0,1"
                                Margin="0,9,0,9">
                            <TextBlock Classes="overline" Text="XỬ LÝ" />
                        </Border>
                        <Border Grid.Row="0" Grid.Column="5"
                                BorderBrush="{StaticResource LineColor}"
                                BorderThickness="0,0,0,1"
                                Margin="0,9,0,9">
                            <TextBlock Classes="overline" Text="GỬI PLC" />
                        </Border>
                    </Grid>

                    <!-- Dữ liệu -->
                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Scans}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScanRowViewModel">
                                        <Border Margin="20,1" Padding="0,7">
                                            <Grid ColumnDefinitions="90,1.6*,1.2*,100,110,100" ColumnSpacing="12">
                                                <TextBlock Classes="mono" FontSize="11"
                                                           VerticalAlignment="Center" Text="{Binding TimeText}" />
                                                <TextBlock Grid.Column="1" Classes="mono" FontSize="12" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Text="{Binding CodeText}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Classes="mono" FontSize="11"
                                                           VerticalAlignment="Center" Text="{Binding GtinText}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="3" Classes="badge"
                                                        Classes.running="{Binding IsPass}"
                                                        Classes.warning="{Binding IsWarningOutcome}"
                                                        Classes.fault="{Binding IsInvalid}"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding OutcomeText}" />
                                                </Border>
                                                <TextBlock Grid.Column="4" Classes="mono" FontSize="11"
                                                           VerticalAlignment="Center" Text="{Binding ProcessingTimeText}" />
                                                <TextBlock Grid.Column="5" Classes="label" FontSize="11"
                                                           VerticalAlignment="Center" Text="{Binding PlcText}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty state: khung scan + thông báo -->
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Spacing="10"
                                    IsVisible="{Binding !HasScans}">
                            <Border Width="56" Height="56"
                                    CornerRadius="16"
                                    Background="#FEF3C7"
                                    BorderBrush="#F59E0B"
                                    BorderThickness="1">
                                <Path Width="26" Height="26"
                                      Stretch="Uniform"
                                      Stroke="#92400E"
                                      StrokeThickness="1.8"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Data="{StaticResource Icon.Scan}" />
                            </Border>
                            <TextBlock FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Text="Chưa có mã quét nào" />
                            <TextBlock FontSize="13"
                                       Classes="label"
                                       TextAlignment="Center"
                                       Text="Mã camera quét được sẽ hiển thị tại đây." />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== CỘT PHẢI ==================== -->
        <!-- Card 1 + Card 2 cao theo nội dung (Auto), Card 3 chiếm phần dư (*) -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="12">

            <!-- ===== Card 1: Thông tin sản xuất (chọn + chạy PO) ===== -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource LineColor}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16,14">
                <StackPanel Spacing="8">

                    <TextBlock Classes="overline"
                               FontSize="14"
                               LetterSpacing="0.1"
                               Foreground="{StaticResource TextPrimary}"
                               Text="THÔNG TIN SẢN XUẤT" />

                    <TextBlock Classes="overline" Text="CHỌN LỆNH SẢN XUẤT" />

                    <!-- Dropdown PO + nút Tải PO -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <ComboBox Grid.Column="0"
                                  Classes="field"
                                  Height="44"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding ProductionInfo.Orders.SelectableOrders}"
                                  SelectedItem="{Binding ProductionInfo.Orders.SelectedOrder}"
                                  PlaceholderText="Chọn PO để bắt đầu sản xuất...">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProductionOrderRowViewModel">
                                    <TextBlock FontSize="13" FontWeight="Medium" Text="{Binding OrderNo}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="1"
                                Classes="whitebtn,iconbtn"
                                MinWidth="108"
                                ToolTip.Tip="Tải PO / Cập nhật danh sách PO từ server"
                                IsEnabled="{Binding !ProductionInfo.IsBusy}"
                                Command="{Binding ProductionInfo.Orders.DownloadOrdersCommand}">
                            <StackPanel>
                                <Path Data="{StaticResource Icon.Download}" />
                                <TextBlock Text="Tải PO" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Bắt đầu / Huỷ PO — 2 nút bằng nhau như mẫu -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Classes="startbtn,iconbtn"
                                FontSize="14"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding ProductionInfo.CanStart}"
                                Command="{Binding ProductionInfo.Orders.StartProductionCommand}">
                            <StackPanel>
                                <Path Data="{StaticResource Icon.Play}" />
                                <TextBlock Text="Bắt đầu" />
                            </StackPanel>
                        </Button>

                        <!-- PO đủ 100% thì tự hoàn tất — luôn hiện nút Huỷ, disable khi chưa đủ điều kiện -->
                        <Button Grid.Column="1"
                                Classes="whitebtn,danger,iconbtn"
                                FontSize="14"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding ProductionInfo.CanCancel}"
                                Command="{Binding ProductionInfo.Orders.CancelProductionCommand}">
                            <StackPanel>
                                <Path Data="{StaticResource Icon.Close}" />
                                <TextBlock Text="Huỷ PO" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Trạng thái thao tác -->
                    <TextBlock Classes="label" FontSize="12"
                               TextWrapping="Wrap"
                               Text="{Binding ProductionInfo.StatusMessage}" />
                </StackPanel>
            </Border>

            <!-- ===== Card 2: Tiến trình sản xuất ===== -->
            <Border Grid.Row="1"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource LineColor}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16,14">
                <StackPanel Spacing="12">

                    <!-- Cảnh báo: máy đã dừng do phát hiện mã trùng lịch sử quét -->
                    <Border IsVisible="{Binding ProductionInfo.IsHalted}"
                            Background="{StaticResource BgPanel}"
                            BorderBrush="{StaticResource Danger}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,8">
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Danger}"
                                       Text="MÁY ĐÃ DỪNG" />
                            <TextBlock FontSize="12"
                                       Foreground="{StaticResource TextSecondary}"
                                       TextWrapping="Wrap"
                                       Text="Phát hiện mã đã từng quét trong lịch sử hệ thống. Đã dừng ghi kết quả xuống PLC và huỷ PO. Vui lòng kiểm tra và xử lý." />
                        </StackPanel>
                    </Border>

                    <!-- Lệnh sản xuất + badge trạng thái -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel Spacing="3">
                            <TextBlock Classes="overline" Text="LỆNH SẢN XUẤT" />
                            <TextBlock Classes="mono" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding ProductionInfo.OrderNoText}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Classes="badge"
                                Classes.running="{Binding ProductionInfo.IsRunning}"
                                VerticalAlignment="Center"
                                Padding="12,4"
                                CornerRadius="14">
                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                       Text="{Binding ProductionInfo.StatusText}" />
                        </Border>
                    </Grid>

                    <!-- Đã quét / tổng + số lượng đơn -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="overline" Text="ĐÃ QUÉT / TỔNG" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="mono" FontSize="36" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}"
                                           Text="{Binding ProductionInfo.ScannedText}" />
                                <TextBlock Classes="mono" FontSize="20" FontWeight="Medium"
                                           Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Bottom" Margin="0,0,0,6"
                                           Text="{Binding ProductionInfo.OrderQtyText, StringFormat=' / {0}'}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Bottom">
                            <TextBlock Classes="overline" Text="SỐ LƯỢNG ĐƠN" />
                            <TextBlock Classes="mono" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Text="{Binding ProductionInfo.OrderQtyText}" />
                        </StackPanel>
                    </Grid>

                    <!-- Thanh tiến trình 24 ô -->
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Classes="overline" Text="TIẾN TRÌNH SẢN XUẤT" />
                            <TextBlock Grid.Column="1" Classes="mono" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource Warn}"
                                       Text="{Binding ProductionInfo.ProgressPercentText}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ProductionInfo.SegmentStates}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="24" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:Boolean">
                                    <Border Classes="segment"
                                            Margin="0,0,3,0"
                                            Classes.on="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Mốc thời gian -->
                    <StackPanel Spacing="0">
                        <Grid ColumnDefinitions="*,Auto" Height="34"
                              Classes="dashedRow" VerticalAlignment="Center">
                            <TextBlock Classes="overline" FontSize="12"
                                       VerticalAlignment="Center" Text="TẠO PO" />
                            <TextBlock Grid.Column="1" Classes="mono" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center"
                                       Text="{Binding ProductionInfo.CreatedText}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Height="34"
                              Classes="dashedRow" VerticalAlignment="Center">
                            <TextBlock Classes="overline" FontSize="12"
                                       VerticalAlignment="Center" Text="BẮT ĐẦU" />
                            <TextBlock Grid.Column="1" Classes="mono" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center"
                                       Text="{Binding ProductionInfo.StartedText}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Height="34"
                              Classes="dashedRow" VerticalAlignment="Center">
                            <TextBlock Classes="overline" FontSize="12"
                                       VerticalAlignment="Center" Text="HOÀN TẤT" />
                            <TextBlock Grid.Column="1" Classes="mono" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center"
                                       Text="{Binding ProductionInfo.CompletedText}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Card 3: Sự kiện gần đây ===== -->
            <Border Grid.Row="2"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource LineColor}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16,12"
                    MinHeight="140">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Classes="overline"
                               FontSize="14"
                               LetterSpacing="0.1"
                               Foreground="{StaticResource TextPrimary}"
                               Text="SỰ KIỆN GẦN ĐÂY" />

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,8,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Events}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScanEvent">
                                    <Border Classes="event" Margin="0,2" Padding="9,7">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                            <Border Classes="stripe"
                                                    Classes.warning="{Binding IsWarning}"
                                                    Classes.critical="{Binding IsCritical}" />
                                            <TextBlock Grid.Column="1" FontSize="11" TextWrapping="Wrap" MaxLines="2"
                                                       VerticalAlignment="Center" Text="{Binding Message}" />
                                            <TextBlock Grid.Column="2" Classes="label mono" FontSize="10"
                                                       VerticalAlignment="Center" Text="{Binding TimeText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="1"
                               Classes="label" FontSize="13"
                               VerticalAlignment="Center"
                               IsVisible="{Binding !HasEvents}"
                               Text="Chưa có sự kiện nào." />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
