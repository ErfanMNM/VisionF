<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TanTienQR.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="700"
             x:Class="TanTienQR.Views.ProductionOrdersView"
             x:DataType="vm:MainViewModel">

    <!-- Trang chỉ để tra cứu: tải PO từ server, tìm kiếm và xem lịch sử.
         Việc chạy PO nằm ở tab "Thông tin sản xuất". -->
    <Grid RowDefinitions="Auto,Auto,*" Margin="18,6,18,18" RowSpacing="12">

        <!-- Tiêu đề + trạng thái server nhận PO từ MES -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
            <StackPanel Spacing="3">
                <TextBlock Text="Truy xuất Sản xuất (Local)"
                           Classes="pageTitle" />
                <TextBlock Classes="label"
                           FontSize="13"
                           Text="Tra cứu toàn bộ lệnh sản xuất đã tải về máy, gồm cả PO đang chạy, hoàn tất hoặc đã huỷ." />
            </StackPanel>

            <!-- Trạng thái HTTP server nhận PO: xanh khi đang chạy,
                 đỏ khi lỗi (port đã dùng / thiếu quyền). -->
            <Border Grid.Column="1"
                    Classes="badge"
                    VerticalAlignment="Center"
                    Classes.running="{Binding ProductionOrders.IsPoServerRunning}"
                    Classes.fault="{Binding ProductionOrders.IsPoServerStatusError}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="NHẬN PO · MES" />
                    <TextBlock Text="•" />
                    <TextBlock Text="{Binding ProductionOrders.PoServerStatusText}" />
                </StackPanel>
            </Border>

            <Button Grid.Column="2"
                    Classes="primary"
                    Height="44" MinWidth="150" Padding="18,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    IsEnabled="{Binding !ProductionOrders.IsBusy}"
                    Command="{Binding ProductionOrders.DownloadOrdersCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Width="16" Height="16"
                          Stretch="Uniform"
                          Stroke="White"
                          StrokeThickness="2"
                          StrokeLineCap="Round"
                          StrokeJoin="Round"
                          Data="{StaticResource Icon.Download}" />
                    <TextBlock Text="Tải PO từ server" Foreground="White" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Thanh tìm kiếm + trạng thái đồng bộ -->
        <Border Grid.Row="1" Classes="filterBar" Padding="14,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                <TextBox Classes="field"
                         MinWidth="0"
                         Height="42"
                         HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Center"
                         FontSize="14"
                         PlaceholderText="Tìm theo mã PO, trạng thái, tên sản phẩm hoặc khách hàng..."
                         Text="{Binding ProductionOrders.SearchText}">
                    <TextBox.InnerLeftContent>
                        <Path Width="17" Height="17"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              Stroke="{StaticResource TextMuted}"
                              Data="{StaticResource Icon.Search}" />
                    </TextBox.InnerLeftContent>
                </TextBox>

                <TextBlock Grid.Column="1"
                           Classes="label"
                           FontSize="12"
                           MaxWidth="420"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Classes.statusError="{Binding ProductionOrders.IsStatusError}"
                           Text="{Binding ProductionOrders.StatusMessage}" />
            </Grid>
        </Border>

        <!-- Bảng danh sách PO -->
        <Border Grid.Row="2" Classes="panel" Padding="0">
            <Grid RowDefinitions="Auto,*">

                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="20,12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Width="16" Height="16"
                              Stretch="Uniform"
                              Stroke="{StaticResource TextPrimary}"
                              StrokeThickness="1.9"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Data="{StaticResource Icon.Table}" />
                        <TextBlock Classes="overline"
                                   FontSize="14"
                                   Foreground="{StaticResource TextPrimary}"
                                   Text="DANH SÁCH LỆNH SẢN XUẤT" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Classes="label"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding ProductionOrders.OrderCountText}" />
                </Grid>

                <!-- Dữ liệu -->
                <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="0">
                    <!-- Header cột + dữ liệu: CÙNG CHUNG BỀ RỘNG (UI-002)
                         Header dùng Margin="20,0" ở cấp Grid, dữ liệu dùng Margin
                         ở cấp từng dòng => 2 hệ toạ độ lệch nhau.
                         Fix: bọc chung 1 ScrollViewer ngang hàng, dùng chung 1 padding. -->
                    <ScrollViewer Grid.Row="0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Disabled">
                        <!-- Header cột: nền #F8F9FB + chữ overline (mẫu Dashboard 4) -->
                        <Grid ColumnDefinitions="200,110,140,130,180" ColumnSpacing="8"
                              Margin="20,0"
                              Background="#F8F9FB">
                            <Border Grid.Row="0" Grid.Column="0"
                                    BorderBrush="{StaticResource LineColor}"
                                    BorderThickness="0,0,0,1"
                                    Margin="0,9,0,9">
                                <TextBlock Classes="overline" Text="MÃ PO" />
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1"
                                    BorderBrush="{StaticResource LineColor}"
                                    BorderThickness="0,0,0,1"
                                    Margin="0,9,0,9">
                                <TextBlock Classes="overline" Text="SỐ LƯỢNG" />
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2"
                                    BorderBrush="{StaticResource LineColor}"
                                    BorderThickness="0,0,0,1"
                                    Margin="0,9,0,9">
                                <TextBlock Classes="overline" Text="ĐÃ QUÉT" />
                            </Border>
                            <Border Grid.Row="0" Grid.Column="3"
                                    BorderBrush="{StaticResource LineColor}"
                                    BorderThickness="0,0,0,1"
                                    Margin="0,9,0,9">
                                <TextBlock Classes="overline" Text="TRẠNG THÁI" />
                            </Border>
                            <Border Grid.Row="0" Grid.Column="4"
                                    BorderBrush="{StaticResource LineColor}"
                                    BorderThickness="0,0,0,1"
                                    Margin="0,9,0,9">
                                <TextBlock Classes="overline" Text="THỜI ĐIỂM TẠO" />
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ProductionOrders.FilteredOrders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProductionOrderRowViewModel">
                                    <Border BorderBrush="{StaticResource LineColor}"
                                            BorderThickness="0,0,0,1"
                                            Margin="20,0"
                                            Padding="0,7">
                                        <Grid ColumnDefinitions="200,110,140,130,180" ColumnSpacing="8">
                                            <TextBlock Classes="mono" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding OrderNo}" />
                                            <TextBlock Grid.Column="1" Classes="mono" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding OrderQty}" />
                                            <TextBlock Grid.Column="2" Classes="mono" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding ProgressText}" />
                                            <Border Grid.Column="3" Classes="badge"
                                                    HorizontalAlignment="Left"
                                                    Classes.running="{Binding IsRunning}"
                                                    Classes.warning="{Binding IsCompleted}"
                                                    Classes.fault="{Binding IsCancelled}">
                                                <TextBlock Text="{Binding StatusText}" />
                                            </Border>
                                            <TextBlock Grid.Column="4" Classes="label mono" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding CreatedText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Trạng thái rỗng (UI-016): bảng trống cần thông báo,
                         không để vùng trắng trơn 1322x513px. -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="10"
                                IsVisible="{Binding ProductionOrders.IsEmpty}">
                        <Border Width="52" Height="52"
                                CornerRadius="16"
                                Background="{StaticResource BgRaised}">
                            <Path Width="24" Height="24"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource TextMuted}"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource Icon.Table}" />
                        </Border>
                        <TextBlock Text="Chưa có dữ liệu"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Classes="label"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Text="Bấm “Tải PO từ server” để lấy danh sách lệnh sản xuất." />
                    </StackPanel>

                    <!-- Không có kết quả tìm kiếm -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="10"
                                IsVisible="{Binding ProductionOrders.HasNoSearchResults}">
                        <Border Width="52" Height="52"
                                CornerRadius="16"
                                Background="{StaticResource BgRaised}">
                            <Path Width="24" Height="24"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource TextMuted}"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource Icon.Search}" />
                        </Border>
                        <TextBlock Text="Không tìm thấy lệnh sản xuất"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Classes="label"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Text="Hãy thử mã PO, trạng thái, tên sản phẩm hoặc khách hàng khác." />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
