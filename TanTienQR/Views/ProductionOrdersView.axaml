<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TanTienQR.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="700"
             x:Class="TanTienQR.Views.ProductionOrdersView"
             x:DataType="vm:MainViewModel">

    <!-- Bố cục theo mẫu Dashboard 4: tiêu đề lớn + panel bo góc 16px,
         header bảng nền #F8F9FB với chữ overline, bo góc card nhỏ 14px. -->
    <Grid RowDefinitions="Auto,Auto,*" Margin="18,6,18,18" RowSpacing="12">

        <!-- Tiêu đề -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="3">
                <TextBlock Text="Truy xuất Sản xuất (Local)"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}" />
                <TextBlock Classes="label"
                           FontSize="13"
                           Text="Quản lý lệnh sản xuất (PO) tải từ server — bắt đầu, hoàn tất và gửi mã kích hoạt." />
            </StackPanel>

            <Button Grid.Column="1"
                    Classes="primary"
                    Height="42" MinWidth="150" Padding="18,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    IsEnabled="{Binding !ProductionOrders.IsBusy}"
                    Command="{Binding ProductionOrders.DownloadOrdersCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Width="16" Height="16"
                          Stretch="Uniform"
                          Stroke="White"
                          StrokeThickness="2"
                          StrokeLineCap="Round"
                          StrokeJoin="Round"
                          Data="{StaticResource Icon.Download}" />
                    <TextBlock Text="Tải PO từ server" Foreground="White" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Card PO đang chạy + thanh thao tác -->
        <Border Grid.Row="1" Classes="panel" Padding="16,14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock Classes="overline"
                                   FontSize="14"
                                   LetterSpacing="0.1"
                                   Foreground="{StaticResource TextPrimary}"
                                   Text="PO ĐANG CHẠY" />
                        <TextBlock Classes="mono" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   Text="{Binding ProductionOrders.RunningOrderNoText}" />
                        <TextBlock Classes="label" VerticalAlignment="Center"
                                   Text="{Binding ProductionOrders.RunningProgressText, StringFormat='Đã quét: {0}'}" />
                    </StackPanel>
                    <TextBlock Classes="label" FontSize="12"
                               TextWrapping="Wrap"
                               Text="{Binding ProductionOrders.StatusMessage}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="primary"
                            Height="40" MinWidth="140" Padding="16,0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            IsEnabled="{Binding ProductionOrders.CanStart}"
                            Command="{Binding ProductionOrders.StartProductionCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Width="15" Height="15"
                                  Stretch="Uniform"
                                  Fill="White"
                                  Data="{StaticResource Icon.Play}" />
                            <TextBlock Text="Bắt đầu sản xuất" Foreground="White" />
                        </StackPanel>
                    </Button>

                    <Button Classes="soft"
                            Height="40" MinWidth="140" Padding="16,0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            IsEnabled="{Binding ProductionOrders.CanComplete}"
                            Command="{Binding ProductionOrders.CompleteProductionCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Width="15" Height="15"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource TextPrimary}"
                                  StrokeThickness="2.4"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource Icon.Check}" />
                            <TextBlock Text="Hoàn tất sản xuất" />
                        </StackPanel>
                    </Button>

                    <Button Classes="soft"
                            Height="40" MinWidth="130" Padding="14,0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            IsEnabled="{Binding ProductionOrders.CanActivate}"
                            Command="{Binding ProductionOrders.ActivatePendingCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Width="15" Height="15"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource TextPrimary}"
                                  StrokeThickness="2"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource Icon.Upload}" />
                            <TextBlock Text="Gửi kích hoạt" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bảng danh sách PO -->
        <Border Grid.Row="2" Classes="panel" Padding="0">
            <Grid RowDefinitions="Auto,Auto,*">

                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="20,12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Width="16" Height="16"
                              Stretch="Uniform"
                              Stroke="{StaticResource TextPrimary}"
                              StrokeThickness="1.9"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Data="{StaticResource Icon.Table}" />
                        <TextBlock Classes="overline"
                                   FontSize="14"
                                   LetterSpacing="0.1"
                                   Foreground="{StaticResource TextPrimary}"
                                   Text="DANH SÁCH LỆNH SẢN XUẤT" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Classes="label"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding ProductionOrders.StatusMessage}" />
                </Grid>

                <!-- Chọn PO -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="20,0,20,10">
                    <TextBlock Classes="overline" FontSize="11"
                               VerticalAlignment="Center"
                               Text="CHỌN LỆNH SẢN XUẤT" />
                    <ComboBox Grid.Column="1"
                              MinHeight="44"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding ProductionOrders.Orders}"
                              SelectedItem="{Binding ProductionOrders.SelectedOrder}"
                              PlaceholderText="Chọn PO để bắt đầu sản xuất...">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProductionOrderRowViewModel">
                                <TextBlock Text="{Binding OrderNo}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <!-- Dữ liệu -->
                <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="0">
                    <!-- Header cột: nền #F8F9FB + chữ overline (mẫu Dashboard 4) -->
                    <Grid Grid.Row="0" ColumnDefinitions="200,110,140,130,180" ColumnSpacing="8"
                          Margin="20,0"
                          Background="#F8F9FB">
                        <Border Grid.Row="0" Grid.Column="0"
                                BorderBrush="{StaticResource LineColor}"
                                BorderThickness="0,0,0,1"
                                Margin="0,9,0,9">
                            <TextBlock Classes="overline" Text="MÃ PO" />
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1"
                                BorderBrush="{StaticResource LineColor}"
                                BorderThickness="0,0,0,1"
                                Margin="0,9,0,9">
                            <TextBlock Classes="overline" Text="SỐ LƯỢNG" />
                        </Border>
                        <Border Grid.Row="0" Grid.Column="2"
                                BorderBrush="{StaticResource LineColor}"
                                BorderThickness="0,0,0,1"
                                Margin="0,9,0,9">
                            <TextBlock Classes="overline" Text="ĐÃ QUÉT" />
                        </Border>
                        <Border Grid.Row="0" Grid.Column="3"
                                BorderBrush="{StaticResource LineColor}"
                                BorderThickness="0,0,0,1"
                                Margin="0,9,0,9">
                            <TextBlock Classes="overline" Text="TRẠNG THÁI" />
                        </Border>
                        <Border Grid.Row="0" Grid.Column="4"
                                BorderBrush="{StaticResource LineColor}"
                                BorderThickness="0,0,0,1"
                                Margin="0,9,0,9">
                            <TextBlock Classes="overline" Text="THỜI ĐIỂM TẠO" />
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ProductionOrders.Orders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProductionOrderRowViewModel">
                                    <Border BorderBrush="{StaticResource LineColor}"
                                            BorderThickness="0,0,0,1"
                                            Margin="20,0"
                                            Padding="0,7">
                                        <Grid ColumnDefinitions="200,110,140,130,180" ColumnSpacing="8">
                                            <TextBlock Classes="mono" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding OrderNo}" />
                                            <TextBlock Grid.Column="1" Classes="mono" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding OrderQty}" />
                                            <TextBlock Grid.Column="2" Classes="mono" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding ProgressText}" />
                                            <Border Grid.Column="3" Classes="badge"
                                                    HorizontalAlignment="Left"
                                                    Classes.running="{Binding IsRunning}"
                                                    Classes.warning="{Binding IsCompleted}">
                                                <TextBlock Text="{Binding StatusText}" />
                                            </Border>
                                            <TextBlock Grid.Column="4" Classes="label mono" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding CreatedText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
