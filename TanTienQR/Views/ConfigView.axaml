<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TanTienQR.ViewModels"
             xmlns:v="using:TanTienQR.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="700"
             x:Class="TanTienQR.Views.ConfigView"
             x:DataType="vm:MainViewModel">

    <!-- Bố cục theo mẫu Dashboard 4: tiêu đề lớn, các card cấu hình bo góc 16px,
         card nhỏ (device) bo góc 14px, thanh thao tác dưới bo góc 16px.

         Cấu trúc trang:
           Row 0 — tiêu đề + banner bắt buộc restart + cảnh báo Development override
           Row 1 — lưới 2 cột các nhóm cấu hình (cuốn dọc), SINH ĐỘNG từ schema
           Row 2 — thanh thao tác (Hoàn tác / Lưu cấu hình) + thông báo kết quả

         ===== THÊM SETTING MỚI =====
         Không cần sửa file này. Thêm property + [ConfigField] trong
         Services/AppConfigModels.cs là form tự hiện đúng vị trí. -->

    <Grid RowDefinitions="Auto,*,Auto" Margin="18,6,18,18" RowSpacing="12">

        <!-- ===== Tiêu đề + banner ===== -->
        <StackPanel Grid.Row="0" Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Cấu hình ứng dụng"
                                   Classes="pageTitle" />
                        <Border Background="{StaticResource WarnSoft}"
                                BorderBrush="{StaticResource LineWarn}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="8,2"
                                VerticalAlignment="Center"
                                IsVisible="{Binding ConfigEditor.IsDirty}">
                            <TextBlock Text="Chưa lưu"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Warn}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Classes="label"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Text="Camera và PLC được áp dụng ngay sau khi xác nhận lưu. Các thông số khác có thể cần khởi động lại ứng dụng." />
                </StackPanel>
            </Grid>

            <!-- ===== BANNER BẮT BUỘC RESTART =====
                 Hiện khi đã lưu cấu hình có thông số quan trọng bị thay đổi.
                 Không có nút "áp dụng nóng": thông số kết nối chỉ được nạp lại
                 khi app khởi động lại. -->
            <Border Background="{StaticResource WarnSoft}"
                    BorderBrush="{StaticResource Warn}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12,10"
                    IsVisible="{Binding ConfigEditor.RestartRequired}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" RowSpacing="8">
                    <Path Grid.Row="0" Grid.Column="0"
                          Width="18" Height="18"
                          Stretch="Uniform"
                          Stroke="{StaticResource Warn}"
                          StrokeThickness="2"
                          StrokeLineCap="Round"
                          StrokeJoin="Round"
                          VerticalAlignment="Top"
                          Margin="0,1,0,0"
                          Data="{StaticResource Icon.Alert}" />

                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                        <TextBlock Foreground="{StaticResource Warn}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Text="Cần khởi động lại ứng dụng" />
                        <TextBlock Foreground="{StaticResource TextPrimary}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Text="{Binding ConfigEditor.RestartBannerText}" />
                        <TextBlock Foreground="{StaticResource TextMuted}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding !ConfigEditor.CanHotApply}"
                                   Text="Các mục được liệt kê ở trên sẽ có hiệu lực sau khi khởi động lại ứng dụng." />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button Classes="chip"
                                IsEnabled="{Binding ConfigEditor.CanRestartNow}"
                                Command="{Binding ConfigEditor.RestartLaterCommand}"
                                ToolTip.Tip="Giữ thay đổi đã lưu, áp dụng sau khi khởi động lại ứng dụng">
                            <TextBlock Text="Để sau" />
                        </Button>
                        <Button Classes="chip"
                                FontWeight="Bold"
                                IsEnabled="{Binding ConfigEditor.CanRestartNow}"
                                Command="{Binding ConfigEditor.RestartNowCommand}"
                                ToolTip.Tip="Khởi động lại ứng dụng ngay để áp dụng cấu hình mới">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Width="14" Height="14"
                                      Stretch="Uniform"
                                      Stroke="{StaticResource TextPrimary}"
                                      StrokeThickness="2"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Data="{StaticResource Icon.Refresh}" />
                                <TextBlock Text="Khởi động lại ngay" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Cảnh báo appsettings.Development.json ghi đè ===== -->
            <Border Background="{StaticResource WarnSoft}"
                    BorderBrush="{StaticResource Warn}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12,8"
                    IsVisible="{Binding ConfigEditor.HasDevelopmentOverride}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Path Width="16" Height="16"
                          Stretch="Uniform"
                          Stroke="{StaticResource Warn}"
                          StrokeThickness="2"
                          StrokeLineCap="Round"
                          StrokeJoin="Round"
                          VerticalAlignment="Top"
                          Margin="0,1,0,0"
                          Data="{StaticResource Icon.Alert}" />
                    <TextBlock Foreground="{StaticResource Warn}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Text="appsettings.Development.json đang tồn tại trong thư mục ứng dụng và sẽ ghi đè các giá trị trong appsettings.json khi app khởi động." />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Các nhóm cấu hình: 2 cột, luôn hiện thanh cuộn dọc khi nội dung vượt khung.
             Toàn bộ card được sinh động từ ConfigSchemaProvider (xem ConfigEditor.Sections). -->
        <ScrollViewer Grid.Row="1" IsEnabled="{Binding !ConfigEditor.IsSaving}"
                      VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding ConfigEditor.Sections}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ConfigSectionViewModel">
                        <Border Classes="panel"
                                Padding="16,14"
                                Margin="0,0,12,12"
                                Width="470">
                            <StackPanel Spacing="10">

                                <!-- ===== Tiêu đề section ===== -->
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Path Width="16" Height="16"
                                          Stretch="Uniform"
                                          Stroke="{StaticResource TextPrimary}"
                                          StrokeThickness="1.9"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          VerticalAlignment="Center"
                                          IsVisible="{Binding HasIcon}"
                                          Data="{Binding IconGeometry}" />
                                    <TextBlock Classes="overline"
                                               FontSize="14"
                                               Foreground="{StaticResource TextPrimary}"
                                               Text="{Binding Title}" />
                                </StackPanel>

                                <TextBlock Classes="label"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding HasDescription}"
                                           Text="{Binding Description}" />

                                <!-- ===== Các trường (sinh động) ===== -->
                                <ItemsControl ItemsSource="{Binding Fields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ConfigFieldViewModel">
                                            <Grid ColumnDefinitions="130,*" ColumnSpacing="12" Margin="0,3">
                                                <TextBlock Classes="label"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding Label}" />

                                                <ContentControl Grid.Column="1"
                                                                HorizontalContentAlignment="Stretch"
                                                                Content="{Binding}">
                                                    <!-- Bộ template cho ô nhập: chọn theo kiểu vỏ của
                                                         trường (Avalonia 12 đã bỏ DataTemplateSelector
                                                         nên dùng DataTemplates với DataType khớp
                                                         theo kiểu ViewModel của trường). -->
                                                    <ContentControl.DataTemplates>
                                                        <DataTemplate DataType="vm:TextField">
                                                            <TextBox PlaceholderText="{Binding Placeholder}"
                                                                     Text="{Binding TextValue, Mode=TwoWay}"
                                                                     HorizontalAlignment="Stretch" />
                                                        </DataTemplate>

                                                        <DataTemplate DataType="vm:NumberField">
                                                            <NumericUpDown Minimum="{Binding Minimum}"
                                                                           Maximum="{Binding Maximum}"
                                                                           Increment="{Binding Increment}"
                                                                           FormatString="0"
                                                                           Value="{Binding Value, Mode=TwoWay}"
                                                                           HorizontalAlignment="Stretch" />
                                                        </DataTemplate>

                                                        <DataTemplate DataType="vm:BoolField">
                                                            <ToggleSwitch Theme="{StaticResource IosToggleSwitchTheme}"
                                                                          IsChecked="{Binding Value, Mode=TwoWay}"
                                                                          Content="{Binding HelpText}"
                                                                          AutomationProperties.Name="{Binding Label}"
                                                                          HorizontalAlignment="Stretch"
                                                                          VerticalAlignment="Center" />
                                                        </DataTemplate>

                                                        <DataTemplate DataType="vm:ComboField">
                                                            <ComboBox ItemsSource="{Binding Options}"
                                                                      SelectedItem="{Binding Value, Mode=TwoWay}"
                                                                      HorizontalAlignment="Stretch" />
                                                        </DataTemplate>

                                                        <DataTemplate DataType="vm:PasswordField">
                                                            <TextBox PasswordChar="●"
                                                                     PlaceholderText="{Binding Placeholder}"
                                                                     Text="{Binding TextValue, Mode=TwoWay}"
                                                                     HorizontalAlignment="Stretch" />
                                                        </DataTemplate>
                                                    </ContentControl.DataTemplates>
                                                </ContentControl>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- ===== Ghi chú D12 / D16 (header/footer) ===== -->
                                <Border Classes="device"
                                        Padding="10"
                                        IsVisible="{Binding ShowMemoryNote}">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="overline" FontSize="11" Text="Ý NGHĨA" />
                                        <TextBlock FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMuted}"
                                                   Text="D12 = 1 khi đọc mã hợp lệ, D12 = 0 khi NoRead / FAIL / sai cấu trúc / trùng mã. D16 = 1 mỗi chu kỳ khi camera + PLC + license đều sẵn sàng." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ===== Card LICENSE (nằm cạnh các card cấu hình) ===== -->
        <Border Grid.Row="1"
                Classes="panel"
                Padding="16,14"
                Margin="0,0,12,12"
                Width="470"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                IsVisible="False">
            <!-- Card license được render bên trong View của app chính. -->
        </Border>

        <!-- ===== Thanh thao tác ===== -->
        <Border Grid.Row="2" Classes="panel" Padding="16,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextMuted}"
                               Text="Cấu hình được lưu vào appsettings.json trong thư mục ứng dụng. Thông số kết nối chỉ áp dụng sau khi khởi động lại ứng dụng." />
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                IsVisible="{Binding ConfigEditor.HasMessage}">
                        <Path Width="14" Height="14"
                              Stretch="Uniform"
                              Stroke="{StaticResource Ok}"
                              StrokeThickness="2.2"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              VerticalAlignment="Center"
                              Data="{StaticResource Icon.Check}"
                              IsVisible="{Binding !ConfigEditor.HasErrorMessage}" />
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource Ok}"
                                   Text="{Binding ConfigEditor.ConfigMessageText}"
                                   IsVisible="{Binding !ConfigEditor.HasErrorMessage}" />
                        <Path Width="14" Height="14"
                              Stretch="Uniform"
                              Stroke="{StaticResource Danger}"
                              StrokeThickness="2.2"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              VerticalAlignment="Center"
                              Data="{StaticResource Icon.Alert}"
                              IsVisible="{Binding ConfigEditor.HasErrorMessage}" />
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource Danger}"
                                   Text="{Binding ConfigEditor.ConfigMessageText}"
                                   IsVisible="{Binding ConfigEditor.HasErrorMessage}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="chip"
                            Command="{Binding ConfigEditor.ResetCommand}" IsEnabled="{Binding ConfigEditor.CanReset}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Width="15" Height="15"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource TextPrimary}"
                                  StrokeThickness="2"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource Icon.Refresh}" />
                            <TextBlock Text="Hoàn tác" />
                        </StackPanel>
                    </Button>
                    <Button Classes="chip"
                            FontWeight="Bold"
                            IsEnabled="{Binding ConfigEditor.CanSave}"
                            Command="{Binding ConfigEditor.SaveCommand}"
                            ToolTip.Tip="Lưu cấu hình. Thay đổi Camera/PLC cần xác nhận và sẽ được áp dụng ngay.">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Width="15" Height="15"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource TextPrimary}"
                                  StrokeThickness="2"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource Icon.Save}" />
                            <TextBlock Text="Lưu cấu hình" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
