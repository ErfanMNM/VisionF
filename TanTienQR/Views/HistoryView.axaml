<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TanTienQR.ViewModels"
             xmlns:d="http://schemas.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="700"
             x:Class="TanTienQR.Views.HistoryView"
             x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="18,6,18,18" RowSpacing="12">

        <!-- Tiêu đề -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Grid.Column="0"
                    Width="42" Height="42"
                    CornerRadius="14"
                    Background="{StaticResource AccentSoft}"
                    BorderBrush="{StaticResource LineAccent}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                <Path Width="20" Height="20"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Stretch="Uniform"
                      Stroke="{StaticResource Accent}"
                      StrokeThickness="1.9"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Data="{StaticResource Icon.Clock}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Lịch sử thao tác"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}" />
                <TextBlock Classes="label"
                           FontSize="12"
                           Text="Nhật ký thao tác của người dùng (chuyển tab, lưu cấu hình, nhập/hủy license, xuất file). Mục dành cho nhà phát triển." />
            </StackPanel>
        </Grid>

        <!-- Bộ lọc: 2 hàng - hàng 1 là trường lọc, hàng 2 là nút điều khiển + xuất file -->
        <Border Grid.Row="1" Classes="filterBar" Padding="14,12">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">

                <!-- Hàng 1: các trường lọc.
                     Kích thước do cột Grid quyết định (không đặt Width cứng) và
                     MinWidth="0" ghi đè MinWidth của style/template mặc định,
                     nên các ô không còn bị tràn đè lên nhau. -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="170,170,200,160,*"
                      ColumnSpacing="12">

                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="fieldLabel" Text="TỪ NGÀY" />
                        <CalendarDatePicker Classes="field"
                                            MinWidth="0"
                                            Height="38"
                                            HorizontalAlignment="Stretch"
                                            VerticalContentAlignment="Center"
                                            SelectedDateFormat="Custom"
                                            CustomDateFormatString="dd/MM/yyyy"
                                            SelectedDate="{Binding HistoryView.FromDate}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Classes="fieldLabel" Text="ĐẾN NGÀY" />
                        <CalendarDatePicker Classes="field"
                                            MinWidth="0"
                                            Height="38"
                                            HorizontalAlignment="Stretch"
                                            VerticalContentAlignment="Center"
                                            SelectedDateFormat="Custom"
                                            CustomDateFormatString="dd/MM/yyyy"
                                            SelectedDate="{Binding HistoryView.ToDate}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Classes="fieldLabel" Text="HÀNH ĐỘNG" />
                        <TextBox Classes="field"
                                 MinWidth="0"
                                 Height="38"
                                 HorizontalAlignment="Stretch"
                                 VerticalContentAlignment="Center"
                                 PlaceholderText="ví dụ: Config"
                                 Text="{Binding HistoryView.ActionFilter}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Spacing="4">
                        <TextBlock Classes="fieldLabel" Text="KẾT QUẢ" />
                        <ComboBox Classes="field"
                                  MinWidth="0"
                                  Height="38"
                                  HorizontalAlignment="Stretch"
                                  VerticalContentAlignment="Center"
                                  ItemsSource="{Binding HistoryView.ResultOptions}"
                                  SelectedItem="{Binding HistoryView.ResultFilter}" />
                    </StackPanel>

                    <Border Grid.Column="4"
                            Height="38"
                            VerticalAlignment="Bottom"
                            Padding="12,0"
                            CornerRadius="14"
                            Background="{StaticResource BgRaised}">
                        <TextBlock Classes="label"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding HistoryView.FilterSummary}" />
                    </Border>
                </Grid>

                <!-- Hàng 2: nút điều khiển + xuất file.
                     Thông tin phân trang chỉ hiển thị ở chân bảng (tránh lặp 2 lần). -->
                <Grid Grid.Row="1"
                      ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                      ColumnSpacing="8">

                    <Button Grid.Column="0"
                            Classes="primary"
                            Height="36" MinWidth="88" Padding="14,0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Command="{Binding HistoryView.ApplyFilterCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Width="16" Height="16"
                                  Stretch="Uniform"
                                  Stroke="White"
                                  StrokeThickness="1.9"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource Icon.Check}" />
                            <TextBlock Text="Áp dụng" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1"
                            Classes="soft"
                            Height="36" MinWidth="80" Padding="14,0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Command="{Binding HistoryView.ResetFilterCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Width="16" Height="16"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource TextPrimary}"
                                  StrokeThickness="1.9"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource Icon.Close}" />
                            <TextBlock Text="Đặt lại" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                            Classes="soft"
                            Height="36" MinWidth="80" Padding="14,0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Command="{Binding HistoryView.LoadCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Width="16" Height="16"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource TextPrimary}"
                                  StrokeThickness="1.9"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource Icon.Refresh}" />
                            <TextBlock Text="Làm mới" />
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Button Classes="soft"
                                Height="36" MinWidth="90" Padding="14,0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Command="{Binding HistoryView.ExportJsonCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Width="16" Height="16"
                                      Stretch="Uniform"
                                      Stroke="{StaticResource TextPrimary}"
                                      StrokeThickness="1.9"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Data="{StaticResource Icon.Download}" />
                                <TextBlock Text="Xuất JSON" />
                            </StackPanel>
                        </Button>
                        <Button Classes="soft"
                                Height="36" MinWidth="90" Padding="14,0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Command="{Binding HistoryView.ExportCsvCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Width="16" Height="16"
                                      Stretch="Uniform"
                                      Stroke="{StaticResource TextPrimary}"
                                      StrokeThickness="1.9"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Data="{StaticResource Icon.Download}" />
                                <TextBlock Text="Xuất CSV" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Bảng dữ liệu -->
        <Border Grid.Row="2" Classes="panel" Padding="0">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Header bảng -->
                <Border Grid.Row="0"
                        Background="#F8F9FB"
                        BorderBrush="{StaticResource LineColor}"
                        BorderThickness="0,0,0,1"
                        Padding="12,10">
                    <Grid ColumnDefinitions="160,170,130,*,110" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Classes="overline" Text="THỜI ĐIỂM" />
                        <TextBlock Grid.Column="1" Classes="overline" Text="HÀNH ĐỘNG" />
                        <TextBlock Grid.Column="2" Classes="overline" Text="ĐỐI TƯỢNG" />
                        <TextBlock Grid.Column="3" Classes="overline" Text="CHI TIẾT" />
                        <TextBlock Grid.Column="4" Classes="overline" Text="KẾT QUẢ" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding HistoryView.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HistoryRowViewModel">
                                <Border BorderBrush="{StaticResource LineColor}"
                                        BorderThickness="0,0,0,1"
                                        Padding="12,7">
                                    <Grid ColumnDefinitions="160,170,130,*,110" ColumnSpacing="10">
                                        <TextBlock Grid.Column="0"
                                                   Classes="mono"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding TimestampText}" />
                                        <TextBlock Grid.Column="1"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Accent}"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Action}" />
                                        <TextBlock Grid.Column="2"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Target}" />
                                        <TextBlock Grid.Column="3"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMuted}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Detail}" />
                                        <Border Grid.Column="4"
                                                Classes="badge"
                                                HorizontalAlignment="Left"
                                                Classes.running="{Binding IsSuccess}"
                                                Classes.warning="{Binding IsCancelled}"
                                                Classes.fault="{Binding IsFailed}">
                                            <TextBlock Text="{Binding Result}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Thông báo khi không có dữ liệu -->
                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="6"
                            IsVisible="{Binding HistoryView.IsEmpty}">
                    <Path Width="22" Height="22"
                          HorizontalAlignment="Center"
                          Stretch="Uniform"
                          Stroke="{StaticResource TextMuted}"
                          StrokeThickness="1.9"
                          StrokeLineCap="Round"
                          StrokeJoin="Round"
                          Data="{StaticResource Icon.List}" />
                    <TextBlock Text="Không có bản ghi"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center" />
                    <TextBlock Classes="label"
                               FontSize="11"
                               Text="Thử đổi khoảng thời gian hoặc xoá bộ lọc."
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Phân trang -->
                <Border Grid.Row="2"
                        BorderBrush="{StaticResource LineColor}"
                        BorderThickness="0,1,0,0"
                        Padding="12,8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0"
                                   Classes="label"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Text="{Binding HistoryView.PaginationText}" />

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Button Classes="chip small"
                                    Content="« Trang đầu"
                                    IsEnabled="{Binding HistoryView.HasPreviousPage}"
                                    Command="{Binding HistoryView.PreviousPageCommand}" />
                            <Button Classes="chip small"
                                    Content="Trang sau »"
                                    IsEnabled="{Binding HistoryView.HasNextPage}"
                                    Command="{Binding HistoryView.NextPageCommand}" />
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Classes="label"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource Ok}"
                                   IsVisible="{Binding HistoryView.HasStatus}"
                                   Text="{Binding HistoryView.StatusMessage}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
