<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TanTienQR.ViewModels"
             xmlns:d="http://schemas.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="700"
             x:Class="TanTienQR.Views.CodeLookupView"
             x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="18,6,18,18" RowSpacing="12">

        <!-- Tiêu đề -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="3">
                <TextBlock Text="Tra cứu mã đã quét"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}" />
                <TextBlock Classes="label"
                           FontSize="12"
                           Text="Tra cứu mã đã chạy qua hệ thống (camera hoặc handheld cầm tay). Nhập tay hoặc quét mã để xem lịch sử." />
            </StackPanel>

            <Border Grid.Column="1"
                    Classes="pill"
                    Classes.ok="{Binding CodeLookup.HasResult}"
                    Classes.warn="{Binding !CodeLookup.HasResult}"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding CodeLookup.ScannerStatusText}" />
            </Border>
        </Grid>

        <!-- Thanh tra cứu -->
        <Border Grid.Row="1" Classes="filterBar" Padding="14,12">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">

                <TextBox Grid.Column="0"
                         Classes="field"
                         MinWidth="0"
                         Height="42"
                         HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Center"
                         FontSize="14"
                         PlaceholderText="Nhập mã cần tra cứu (ví dụ: 8934567890123 / ABC123)..."
                         Text="{Binding CodeLookup.CodeInput}">
                    <TextBox.InnerLeftContent>
                        <Path Width="17" Height="17"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              Stroke="{StaticResource TextMuted}"
                              Data="{StaticResource Icon.Search}" />
                    </TextBox.InnerLeftContent>
                </TextBox>

                <Button Grid.Column="1"
                        Classes="primary,iconbtn"
                        Height="44" MinWidth="110" Padding="18,0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        IsEnabled="{Binding !CodeLookup.IsBusy}"
                        Command="{Binding CodeLookup.LookupCommand}">
                    <StackPanel>
                        <Path Stroke="White"
                              Data="{StaticResource Icon.Search}" />
                        <TextBlock Text="Tra cứu" Foreground="White" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Classes="soft,iconbtn"
                        Height="44" MinWidth="86" Padding="14,0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Command="{Binding CodeLookup.ClearCommand}">
                    <StackPanel>
                        <Path Stroke="{StaticResource TextPrimary}"
                              Data="{StaticResource Icon.Close}" />
                        <TextBlock Text="Xoá" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Card tóm tắt lần quét gần nhất -->
        <Border Grid.Row="2" Classes="panel" Padding="14,12"
                IsVisible="{Binding CodeLookup.HasResult}">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel>
                        <TextBlock Classes="sectionTitle" Text="LẦN QUÉT GẦN NHẤT" />
                        <TextBlock Classes="label" VerticalAlignment="Center"
                                   Text="{Binding CodeLookup.TotalCount, StringFormat='Tổng: {0} lần'}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Classes="label"
                               VerticalAlignment="Center"
                               Text="{Binding CodeLookup.FilterSummary}" />
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Classes="overline" Text="MÃ / SERIAL" />
                        <TextBlock Classes="mono" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding CodeLookup.Latest.CodeText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Classes="overline" Text="GTIN" />
                        <TextBlock Classes="mono" FontSize="13"
                                   Foreground="{StaticResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding CodeLookup.Latest.GtinText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="3">
                        <TextBlock Classes="overline" Text="THỜI ĐIỂM QUÉT" />
                        <TextBlock Classes="mono" FontSize="13"
                                   Foreground="{StaticResource TextPrimary}"
                                   Text="{Binding CodeLookup.Latest.TimeText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Spacing="3">
                        <TextBlock Classes="overline" Text="KẾT QUẢ" />
                        <Border Classes="badge"
                                HorizontalAlignment="Left"
                                Classes.running="{Binding CodeLookup.Latest.IsPass}"
                                Classes.warning="{Binding CodeLookup.Latest.IsOverload}"
                                Classes.fault="{Binding CodeLookup.Latest.IsFail}">
                            <TextBlock Text="{Binding CodeLookup.Latest.StatusText}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Spacing="3">
                        <TextBlock Classes="overline" Text="XỬ LÝ" />
                        <TextBlock Classes="mono" FontSize="13"
                                   Foreground="{StaticResource TextPrimary}"
                                   Text="{Binding CodeLookup.Latest.ProcessingTimeText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="5" Spacing="3">
                        <TextBlock Classes="overline" Text="GỬI PLC" />
                        <Border Classes="badge"
                                HorizontalAlignment="Left"
                                Classes.running="{Binding CodeLookup.Latest.IsPlcOk}"
                                Classes.warning="{Binding CodeLookup.Latest.IsPlcSkipped}"
                                Classes.fault="{Binding CodeLookup.Latest.IsPlcFailed}">
                            <TextBlock Text="{Binding CodeLookup.Latest.PlcText}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Bảng lịch sử các lần quét của mã -->
        <Border Grid.Row="3" Classes="panel" Padding="0">
            <Grid RowDefinitions="Auto,*,Auto">

                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="12,10">
                    <TextBlock Classes="sectionTitle" Text="LỊCH SỬ QUÉT MÃ" />
                    <TextBlock Grid.Column="1"
                               Classes="label"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding CodeLookup.StatusMessage}" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CodeLookup.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CodeLookupRowViewModel">
                                <Border BorderBrush="{StaticResource LineColor}"
                                        BorderThickness="0,0,0,1"
                                        Padding="12,7">
                                    <Grid ColumnDefinitions="160,*,140,110,100,100" ColumnSpacing="10">
                                        <TextBlock Grid.Column="0"
                                                   Classes="mono"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding TimeText}" />
                                        <TextBlock Grid.Column="1"
                                                   Classes="mono"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding CodeText}" />
                                        <TextBlock Grid.Column="2"
                                                   Classes="mono"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding GtinText}" />
                                        <Border Grid.Column="3"
                                                Classes="badge"
                                                HorizontalAlignment="Left"
                                                Classes.running="{Binding IsPass}"
                                                Classes.warning="{Binding IsOverload}"
                                                Classes.fault="{Binding IsFail}">
                                            <TextBlock Text="{Binding StatusText}" />
                                        </Border>
                                        <TextBlock Grid.Column="4"
                                                   Classes="mono"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding ProcessingTimeText}" />
                                        <TextBlock Grid.Column="5"
                                                   Classes="label"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding PlcText}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Thông báo khi không có dữ liệu -->
                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="10"
                            IsVisible="{Binding CodeLookup.IsEmpty}">
                    <Border Width="52" Height="52"
                            CornerRadius="16"
                            Background="#FEF3C7"
                            BorderBrush="#F59E0B"
                            BorderThickness="1">
                        <Path Width="24" Height="24"
                              Stroke="#92400E"
                              StrokeThickness="1.8"
                              Data="{StaticResource Icon.Search}" />
                    </Border>
                    <TextBlock Text="Chưa có dữ liệu"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center" />
                    <TextBlock Classes="label"
                               FontSize="13"
                               Text="Nhập mã hoặc quét bằng handheld cầm tay để tra cứu."
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
