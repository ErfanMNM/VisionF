<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TanTienQR.ViewModels"
             xmlns:d="http://schemas.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="700"
             x:Class="TanTienQR.Views.CodeLookupView"
             x:DataType="vm:MainViewModel">

    <!-- Bố cục theo FScan.cs (dự án tham khảo): ô nhập + bảng thông tin
         mã vừa tra cứu. KHÔNG hiển thị danh sách lịch sử quét chung. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="18,6,18,18" RowSpacing="12">

        <!-- Tiêu đề -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="3">
                <TextBlock Text="Tra cứu mã đã quét"
                           Classes="pageTitle" />
                <TextBlock Classes="label"
                           FontSize="12"
                           Text="Tra cứu mã đã chạy qua hệ thống (camera hoặc handheld cầm tay). Nhập tay hoặc quét mã để xem thông tin." />
            </StackPanel>

            <Border Grid.Column="1"
                    Classes="pill"
                    Classes.ok="{Binding CodeLookup.HasResult}"
                    Classes.warn="{Binding !CodeLookup.HasResult}"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding CodeLookup.ScannerStatusText}" />
            </Border>
        </Grid>

        <!-- Thanh tra cứu -->
        <Border Grid.Row="1" Classes="filterBar" Padding="14,12">
            <!-- Chiều cao thống nhất 38px cho ô nhập + 2 nút (UI-006/UI-015):
                 trước đây ô nhập 44px còn nút 36px (bị MinHeight=38 đè) =>
                 viền dưới lệch 8px. -->
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">

                <TextBox Grid.Column="0"
                         Classes="field"
                         MinWidth="0"
                         Height="38"
                         HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Center"
                         FontSize="14"
                         PlaceholderText="Nhập chính xác toàn bộ nội dung mã..."
                         Text="{Binding CodeLookup.CodeInput}">
                    <TextBox.InnerLeftContent>
                        <Path Width="17" Height="17"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              Stroke="{StaticResource TextMuted}"
                              Data="{StaticResource Icon.Search}" />
                    </TextBox.InnerLeftContent>
                </TextBox>

                <Button Grid.Column="1"
                        Classes="primary"
                        Height="38" MinWidth="88" Padding="14,0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        IsEnabled="{Binding !CodeLookup.IsBusy}"
                        Command="{Binding CodeLookup.LookupCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Width="16" Height="16"
                              Stretch="Uniform"
                              Stroke="White"
                              StrokeThickness="1.9"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Data="{StaticResource Icon.Search}" />
                        <TextBlock Text="Tra cứu" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Classes="soft"
                        Height="38" MinWidth="80" Padding="14,0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Command="{Binding CodeLookup.ClearCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Width="16" Height="16"
                              Stretch="Uniform"
                              Stroke="{StaticResource TextPrimary}"
                              StrokeThickness="1.9"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Data="{StaticResource Icon.Close}" />
                        <TextBlock Text="Xoá" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ===== Bảng thông tin mã vừa tra cứu ===== -->
        <Border Grid.Row="2" Classes="panel" Padding="0">
            <Grid RowDefinitions="Auto,*,*">

                <!-- Header: tiêu đề + trạng thái kích hoạt -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="14,12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Width="16" Height="16"
                              Stretch="Uniform"
                              Stroke="{StaticResource TextPrimary}"
                              StrokeThickness="1.9"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Data="{StaticResource Icon.Table}" />
                        <TextBlock Classes="sectionTitle" Text="THÔNG TIN MÃ" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Classes="label"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding CodeLookup.StatusMessage}" />

                    <Border Grid.Column="2"
                            Classes="badge"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            IsVisible="{Binding CodeLookup.HasResult}"
                            Classes.running="{Binding CodeLookup.IsActivated}"
                            Classes.warning="{Binding CodeLookup.IsPendingActivation}"
                            Classes.fault="{Binding CodeLookup.HasResult}"
                            Classes.ok="{Binding CodeLookup.IsActivated}">
                        <TextBlock Text="{Binding CodeLookup.ActivationStatusText}" />
                    </Border>
                </Grid>

                <!-- Card tóm tắt: thông tin chính của mã vừa tra cứu -->
                <Border Grid.Row="1"
                        Classes="device"
                        Margin="14,0,14,12"
                        Padding="14,12"
                        IsVisible="{Binding CodeLookup.HasResult}">
                    <ScrollViewer MaxHeight="160"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">

                        <!-- Hàng 1: toàn bộ nội dung mã + PO -->
                        <Grid ColumnDefinitions="2*,*" ColumnSpacing="14">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Classes="overline" Text="NỘI DUNG MÃ" />
                                <TextBlock Classes="mono" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}"
                                           TextWrapping="Wrap"
                                           Text="{Binding CodeLookup.Latest.CodeText}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Classes="overline" Text="LỆNH SẢN XUẤT (PO)" />
                                <TextBlock Classes="mono" FontSize="14"
                                           Foreground="{StaticResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding CodeLookup.Latest.OrderNoText}" />
                            </StackPanel>
                        </Grid>

                        <!-- Hàng 2: kết quả + plc + số lần quét -->
                        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Classes="overline" Text="KẾT QUẢ" />
                                <Border Classes="badge"
                                        HorizontalAlignment="Left"
                                        Classes.running="{Binding CodeLookup.Latest.IsPass}"
                                        Classes.warning="{Binding CodeLookup.Latest.IsOverload}"
                                        Classes.fault="{Binding CodeLookup.Latest.IsFail}">
                                    <TextBlock Text="{Binding CodeLookup.Latest.StatusText}" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Classes="overline" Text="GỬI PLC" />
                                <Border Classes="badge"
                                        HorizontalAlignment="Left"
                                        Classes.running="{Binding CodeLookup.Latest.IsPlcOk}"
                                        Classes.warning="{Binding CodeLookup.Latest.IsPlcSkipped}"
                                        Classes.fault="{Binding CodeLookup.Latest.IsPlcFailed}">
                                    <TextBlock Text="{Binding CodeLookup.Latest.PlcText}" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="3">
                                <TextBlock Classes="overline" Text="THỜI ĐIỂM QUÉT" />
                                <TextBlock Classes="mono" FontSize="13"
                                           Foreground="{StaticResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding CodeLookup.Latest.TimeText}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Spacing="3">
                                <TextBlock Classes="overline" Text="SỐ LẦN QUÉT" />
                                <TextBlock FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           Text="{Binding CodeLookup.ScanCountText}" />
                            </StackPanel>
                        </Grid>

                        <!-- Hàng 3: dữ liệu gốc -->
                        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="14">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Classes="overline" Text="NỘI DUNG GỐC CAMERA" />
                                <TextBlock Classes="mono" FontSize="12"
                                           Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           Text="{Binding CodeLookup.Latest.RawText}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Classes="overline" Text="THỜI GIAN XỬ LÝ" />
                                <TextBlock Classes="mono" FontSize="13"
                                           Foreground="{StaticResource TextPrimary}"
                                           Text="{Binding CodeLookup.Latest.ProcessingTimeText}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                    </ScrollViewer>
                </Border>

                <!-- Bảng chi tiết các lần quét của mã vừa tra cứu -->
                <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="14,0,14,8"
                          IsVisible="{Binding CodeLookup.HasResult}">
                        <TextBlock Classes="overline" Text="CÁC LẦN QUÉT CỦA MÃ" />
                        <TextBlock Grid.Column="1"
                                   Classes="label"
                                   VerticalAlignment="Center"
                                   Text="{Binding CodeLookup.ScanCountText}" />
                    </Grid>

                    <!-- Tiêu đề cột -->
                    <Grid Grid.Row="1"
                          ColumnDefinitions="160,*,110,80,110,120,100"
                          ColumnSpacing="10"
                          Margin="14,0,14,4"
                          IsVisible="{Binding CodeLookup.HasResult}">
                        <TextBlock Classes="overline" Text="THỜI GIAN" />
                        <TextBlock Grid.Column="1" Classes="overline" Text="NỘI DUNG MÃ" />
                        <TextBlock Grid.Column="2" Classes="overline" Text="KẾT QUẢ" />
                        <TextBlock Grid.Column="3" Classes="overline" Text="PLC" />
                        <TextBlock Grid.Column="4" Classes="overline" Text="ĐƠN HÀNG" />
                        <TextBlock Grid.Column="5" Classes="overline" Text="THỜI GIAN XỬ LÝ" />
                        <TextBlock Grid.Column="6" Classes="overline" Text="CHECKEE" />
                    </Grid>

                    <ScrollViewer Grid.Row="2"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CodeLookup.Rows}"
                                      IsVisible="{Binding CodeLookup.HasResult}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CodeLookupRowViewModel">
                                    <Border BorderBrush="{StaticResource LineColor}"
                                            BorderThickness="0,0,0,1"
                                            Padding="14,7">
                                        <Grid ColumnDefinitions="160,*,110,80,110,120,100" ColumnSpacing="10">
                                            <TextBlock Grid.Column="0"
                                                       Classes="mono"
                                                       FontSize="11"
                                                       VerticalAlignment="Top"
                                                       Text="{Binding TimeText}" />
                                            <TextBlock Grid.Column="1"
                                                       Classes="mono"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       VerticalAlignment="Top"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding CodeText}" />
                                            <Border Grid.Column="2"
                                                    Classes="badge"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Classes.running="{Binding IsPass}"
                                                    Classes.warning="{Binding IsOverload}"
                                                    Classes.fault="{Binding IsFail}">
                                                <TextBlock Text="{Binding StatusText}" />
                                            </Border>
                                            <TextBlock Grid.Column="3"
                                                       Classes="label"
                                                       FontSize="11"
                                                       VerticalAlignment="Top"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding PlcText}" />
                                            <TextBlock Grid.Column="4"
                                                       Classes="mono"
                                                       FontSize="11"
                                                       VerticalAlignment="Top"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding OrderNoText}" />
                                            <TextBlock Grid.Column="5"
                                                       Classes="mono"
                                                       FontSize="11"
                                                       VerticalAlignment="Top"
                                                       Text="{Binding ProcessingTimeText}" />
                                            <!-- Trạng thái gửi lên Checkee -->
                                            <Border Grid.Column="6"
                                                    Classes="badge"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    ToolTip.Tip="{Binding SendDetailText}"
                                                    Classes.running="{Binding IsSendSent}"
                                                    Classes.warning="{Binding IsSendPending}"
                                                    Classes.fault="{Binding IsSendFailed}">
                                                <TextBlock Text="{Binding SendStatusText}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Trạng thái rỗng -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="10"
                                IsVisible="{Binding CodeLookup.IsEmpty}">
                        <Border Width="52" Height="52"
                                CornerRadius="16"
                                Background="{StaticResource WarnSoft}"
                                BorderBrush="{StaticResource Warn}"
                                BorderThickness="1">
                            <Path Width="24" Height="24"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource Warn}"
                                  StrokeThickness="1.8"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource Icon.Search}" />
                        </Border>
                        <TextBlock Text="Chưa có dữ liệu"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Classes="label"
                                   FontSize="13"
                                   Text="Nhập mã hoặc quét bằng handheld cầm tay để tra cứu."
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
<!-- ===== Bảng "Mã gửi lỗi" (mã bị Checkee từ chối) ===== -->
        <Border Grid.Row="3" Classes="panel" Padding="0">
            <Grid RowDefinitions="Auto,*">

                <!-- Header: tiêu đề + nút làm mới / gửi lại -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Margin="14,12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Width="16" Height="16"
                              Stretch="Uniform"
                              Stroke="{StaticResource TextPrimary}"
                              StrokeThickness="1.9"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Data="{StaticResource Icon.Alert}" />
                        <TextBlock Classes="sectionTitle" Text="MÃ GỬI LỖI" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Classes="label"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding CodeLookup.ErrorCountText}" />

                    <Button Grid.Column="2"
                            Classes="soft"
                            Height="32" MinWidth="96" Padding="12,0"
                            Margin="0,0,8,0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            IsEnabled="{Binding !CodeLookup.IsErrorTableBusy}"
                            Command="{Binding CodeLookup.LoadErrorRowsCommand}"
                            ToolTip.Tip="Tải lại danh sách mã bị lỗi khi gửi lên Checkee">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Width="15" Height="15"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource TextPrimary}"
                                  StrokeThickness="1.9"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource Icon.Refresh}" />
                            <TextBlock Text="Làm mới" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3"
                            Classes="primary"
                            Height="32" MinWidth="104" Padding="12,0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            IsEnabled="{Binding !CodeLookup.IsResending}"
                            IsVisible="{Binding CodeLookup.HasErrorRows}"
                            Command="{Binding CodeLookup.ResendFailedCommand}"
                            ToolTip.Tip="Đưa các mã lỗi về trạng thái chờ gửi rồi gửi lại lên Checkee ngay">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Width="15" Height="15"
                                  Stretch="Uniform"
                                  Stroke="White"
                                  StrokeThickness="1.9"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource Icon.Upload}" />
                            <TextBlock Text="Gửi lại" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Bảng danh sách mã lỗi -->
                <ScrollViewer Grid.Row="1"
                              MaxHeight="80"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CodeLookup.ErrorRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CodeSendErrorRowViewModel">
                                <Border BorderBrush="{StaticResource LineColor}"
                                        BorderThickness="0,0,0,1"
                                        Padding="14,7">
                                    <Grid ColumnDefinitions="2*,2*,120,110,*" ColumnSpacing="10">
                                        <TextBlock Grid.Column="0"
                                                   Classes="mono"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   VerticalAlignment="Top"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding CodeText}" />
                                        <TextBlock Grid.Column="1"
                                                   Classes="label"
                                                   FontSize="11"
                                                   VerticalAlignment="Top"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Message}" />
                                        <TextBlock Grid.Column="2"
                                                   Classes="mono"
                                                   FontSize="11"
                                                   VerticalAlignment="Top"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding BatchText}" />
                                        <Border Grid.Column="3"
                                                Classes="badge"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Classes.fault="True">
                                            <TextBlock Text="{Binding StatusCodeText}" />
                                        </Border>
                                        <TextBlock Grid.Column="4"
                                                   Classes="label"
                                                   FontSize="11"
                                                   VerticalAlignment="Top"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding LastAttemptText}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
