<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TanTienQR.ViewModels"
             xmlns:d="http://schemas.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="700"
             x:Class="TanTienQR.Views.CodeLookupView"
             x:DataType="vm:MainViewModel">

    <UserControl.Resources>
        <DataTemplate x:Key="SendMonitorRow" x:DataType="vm:CheckeeMonitorRowViewModel">
            <Border BorderBrush="{StaticResource LineColor}" BorderThickness="0,0,0,1" Padding="12,7">
                <Grid ColumnDefinitions="110,2*,100,110,2*" ColumnSpacing="10">
                    <TextBlock Classes="mono" FontSize="11" Text="{Binding TimeText}" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Classes="mono" FontSize="11" Text="{Binding CodeText}" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="2" Classes="label" FontSize="11" Text="{Binding OrderNoText}" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="3" Classes="label" FontSize="11" FontWeight="SemiBold" Text="{Binding StatusText}" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="4" Classes="label" FontSize="11" Text="{Binding DetailText}" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Bố cục theo FScan.cs (dự án tham khảo): ô nhập + bảng thông tin
         mã vừa tra cứu. KHÔNG hiển thị danh sách lịch sử quét chung. -->
    <Grid>
        <!-- Preserve usable section viewports on short displays; the page scrolls vertically. -->
        <ScrollViewer x:Name="CodeLookupPageScroll"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="18,6,18,18" RowSpacing="12">

        <!-- Tiêu đề -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="3">
                <TextBlock Text="Tra cứu mã đã quét"
                           Classes="pageTitle" />
                <TextBlock Classes="label"
                           FontSize="12"
                           Text="Tra cứu mã đã chạy qua hệ thống (camera hoặc handheld cầm tay). Nhập tay hoặc quét mã để xem thông tin." />
            </StackPanel>

            <Border Grid.Column="1"
                    Classes="pill"
                    Classes.ok="{Binding CodeLookup.HasResult}"
                    Classes.warn="{Binding !CodeLookup.HasResult}"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding CodeLookup.ScannerStatusText}" />
            </Border>
        </Grid>

        <!-- Thanh tra cứu -->
        <Border Grid.Row="1" Classes="filterBar" Padding="14,12">
            <!-- Chiều cao thống nhất 38px cho ô nhập + 2 nút (UI-006/UI-015):
                 trước đây ô nhập 44px còn nút 36px (bị MinHeight=38 đè) =>
                 viền dưới lệch 8px. -->
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">

                <TextBox Grid.Column="0"
                         Classes="field"
                         MinWidth="0"
                         Height="38"
                         HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Center"
                         FontSize="14"
                         PlaceholderText="Nhập chính xác toàn bộ nội dung mã..."
                         Text="{Binding CodeLookup.CodeInput}">
                    <TextBox.InnerLeftContent>
                        <Path Width="17" Height="17"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              Stroke="{StaticResource TextMuted}"
                              Data="{StaticResource Icon.Search}" />
                    </TextBox.InnerLeftContent>
                </TextBox>

                <Button Grid.Column="1"
                        Classes="primary"
                        Height="38" MinWidth="88" Padding="14,0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        IsEnabled="{Binding !CodeLookup.IsBusy}"
                        Command="{Binding CodeLookup.LookupCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Width="16" Height="16"
                              Stretch="Uniform"
                              Stroke="White"
                              StrokeThickness="1.9"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Data="{StaticResource Icon.Search}" />
                        <TextBlock Text="Tra cứu" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Classes="soft"
                        Height="38" MinWidth="80" Padding="14,0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Command="{Binding CodeLookup.ClearCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Width="16" Height="16"
                              Stretch="Uniform"
                              Stroke="{StaticResource TextPrimary}"
                              StrokeThickness="1.9"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Data="{StaticResource Icon.Close}" />
                        <TextBlock Text="Xoá" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ===== Bảng thông tin mã vừa tra cứu ===== -->
        <Border Grid.Row="2" Classes="panel" Padding="0" Height="350">
            <Grid RowDefinitions="Auto,Auto,*">

                <!-- Header: tiêu đề + trạng thái kích hoạt -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="14,12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Width="16" Height="16"
                              Stretch="Uniform"
                              Stroke="{StaticResource TextPrimary}"
                              StrokeThickness="1.9"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Data="{StaticResource Icon.Table}" />
                        <TextBlock Classes="sectionTitle" Text="THÔNG TIN MÃ" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Classes="label"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding CodeLookup.StatusMessage}" />

                    <Border Grid.Column="2"
                            Classes="badge"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            IsVisible="{Binding CodeLookup.HasResult}"
                            Classes.running="{Binding CodeLookup.IsActivated}"
                            Classes.warning="{Binding CodeLookup.IsPendingActivation}"
                            Classes.fault="{Binding CodeLookup.HasResult}"
                            Classes.ok="{Binding CodeLookup.IsActivated}">
                        <TextBlock Text="{Binding CodeLookup.ActivationStatusText}" />
                    </Border>
                </Grid>

                <!-- Card tóm tắt: thông tin chính của mã vừa tra cứu -->
                <Border Grid.Row="1"
                        Classes="device"
                        Margin="14,0,14,12"
                        Padding="14,12"
                        IsVisible="{Binding CodeLookup.HasResult}">
                    <ScrollViewer MaxHeight="160"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">

                        <!-- Hàng 1: toàn bộ nội dung mã + PO -->
                        <Grid ColumnDefinitions="2*,*" ColumnSpacing="14">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Classes="overline" Text="NỘI DUNG MÃ" />
                                <TextBlock Classes="mono" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}"
                                           TextWrapping="Wrap"
                                           Text="{Binding CodeLookup.Latest.CodeText}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Classes="overline" Text="LỆNH SẢN XUẤT (PO)" />
                                <TextBlock Classes="mono" FontSize="14"
                                           Foreground="{StaticResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding CodeLookup.Latest.OrderNoText}" />
                            </StackPanel>
                        </Grid>

                        <!-- Hàng 2: kết quả + plc + số lần quét -->
                        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Classes="overline" Text="KẾT QUẢ" />
                                <Border Classes="badge"
                                        HorizontalAlignment="Left"
                                        Classes.running="{Binding CodeLookup.Latest.IsPass}"
                                        Classes.warning="{Binding CodeLookup.Latest.IsOverload}"
                                        Classes.fault="{Binding CodeLookup.Latest.IsFail}">
                                    <TextBlock Text="{Binding CodeLookup.Latest.StatusText}" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Classes="overline" Text="GỬI PLC" />
                                <Border Classes="badge"
                                        HorizontalAlignment="Left"
                                        Classes.running="{Binding CodeLookup.Latest.IsPlcOk}"
                                        Classes.warning="{Binding CodeLookup.Latest.IsPlcSkipped}"
                                        Classes.fault="{Binding CodeLookup.Latest.IsPlcFailed}">
                                    <TextBlock Text="{Binding CodeLookup.Latest.PlcText}" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="3">
                                <TextBlock Classes="overline" Text="THỜI ĐIỂM QUÉT" />
                                <TextBlock Classes="mono" FontSize="13"
                                           Foreground="{StaticResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding CodeLookup.Latest.TimeText}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Spacing="3">
                                <TextBlock Classes="overline" Text="SỐ LẦN QUÉT" />
                                <TextBlock FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           Text="{Binding CodeLookup.ScanCountText}" />
                            </StackPanel>
                        </Grid>

                        <!-- Hàng 3: dữ liệu gốc -->
                        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="14">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Classes="overline" Text="NỘI DUNG GỐC CAMERA" />
                                <TextBlock Classes="mono" FontSize="12"
                                           Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           Text="{Binding CodeLookup.Latest.RawText}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Classes="overline" Text="THỜI GIAN XỬ LÝ" />
                                <TextBlock Classes="mono" FontSize="13"
                                           Foreground="{StaticResource TextPrimary}"
                                           Text="{Binding CodeLookup.Latest.ProcessingTimeText}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                    </ScrollViewer>
                </Border>

                <!-- Bảng chi tiết các lần quét của mã vừa tra cứu -->
                <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="14,0,14,8"
                          IsVisible="{Binding CodeLookup.HasResult}">
                        <TextBlock Classes="overline" Text="CÁC LẦN QUÉT CỦA MÃ" />
                        <TextBlock Grid.Column="1"
                                   Classes="label"
                                   VerticalAlignment="Center"
                                   Text="{Binding CodeLookup.ScanCountText}" />
                    </Grid>

                    <!-- Tiêu đề cột -->
                    <Grid Grid.Row="1"
                          ColumnDefinitions="160,*,110,80,110,120,100"
                          ColumnSpacing="10"
                          Margin="14,0,14,4"
                          IsVisible="{Binding CodeLookup.HasResult}">
                        <TextBlock Classes="overline" Text="THỜI GIAN" />
                        <TextBlock Grid.Column="1" Classes="overline" Text="NỘI DUNG MÃ" />
                        <TextBlock Grid.Column="2" Classes="overline" Text="KẾT QUẢ" />
                        <TextBlock Grid.Column="3" Classes="overline" Text="PLC" />
                        <TextBlock Grid.Column="4" Classes="overline" Text="ĐƠN HÀNG" />
                        <TextBlock Grid.Column="5" Classes="overline" Text="THỜI GIAN XỬ LÝ" />
                        <TextBlock Grid.Column="6" Classes="overline" Text="CHECKEE" />
                    </Grid>

                    <ScrollViewer x:Name="CodeLookupScanRowsScroll" Grid.Row="2" MinHeight="48"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CodeLookup.Rows}"
                                      IsVisible="{Binding CodeLookup.HasResult}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CodeLookupRowViewModel">
                                    <Border BorderBrush="{StaticResource LineColor}"
                                            BorderThickness="0,0,0,1"
                                            Padding="14,7">
                                        <Grid ColumnDefinitions="160,*,110,80,110,120,100" ColumnSpacing="10">
                                            <TextBlock Grid.Column="0"
                                                       Classes="mono"
                                                       FontSize="11"
                                                       VerticalAlignment="Top"
                                                       Text="{Binding TimeText}" />
                                            <TextBlock Grid.Column="1"
                                                       Classes="mono"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       VerticalAlignment="Top"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding CodeText}" />
                                            <Border Grid.Column="2"
                                                    Classes="badge"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Classes.running="{Binding IsPass}"
                                                    Classes.warning="{Binding IsOverload}"
                                                    Classes.fault="{Binding IsFail}">
                                                <TextBlock Text="{Binding StatusText}" />
                                            </Border>
                                            <TextBlock Grid.Column="3"
                                                       Classes="label"
                                                       FontSize="11"
                                                       VerticalAlignment="Top"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding PlcText}" />
                                            <TextBlock Grid.Column="4"
                                                       Classes="mono"
                                                       FontSize="11"
                                                       VerticalAlignment="Top"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding OrderNoText}" />
                                            <TextBlock Grid.Column="5"
                                                       Classes="mono"
                                                       FontSize="11"
                                                       VerticalAlignment="Top"
                                                       Text="{Binding ProcessingTimeText}" />
                                            <!-- Trạng thái gửi lên Checkee -->
                                            <Border Grid.Column="6"
                                                    Classes="badge"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    ToolTip.Tip="{Binding SendDetailText}"
                                                    Classes.running="{Binding IsSendSent}"
                                                    Classes.warning="{Binding IsSendPending}"
                                                    Classes.fault="{Binding IsSendFailed}">
                                                <TextBlock Text="{Binding SendStatusText}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Trạng thái rỗng -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="10"
                                IsVisible="{Binding CodeLookup.IsEmpty}">
                        <Border Width="52" Height="52"
                                CornerRadius="16"
                                Background="{StaticResource WarnSoft}"
                                BorderBrush="{StaticResource Warn}"
                                BorderThickness="1">
                            <Path Width="24" Height="24"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource Warn}"
                                  StrokeThickness="1.8"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="{StaticResource Icon.Search}" />
                        </Border>
                        <TextBlock Text="Chưa có dữ liệu"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Classes="label"
                                   FontSize="13"
                                   Text="Nhập mã hoặc quét bằng handheld cầm tay để tra cứu."
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <Border x:Name="CheckeeSendMonitorPanel" Grid.Row="3" Classes="panel" Padding="0" Height="260">
            <Grid RowDefinitions="Auto,Auto,*">
                <Grid Margin="14,8" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Classes="sectionTitle" Text="THEO DÕI GỬI CHECKEE" />
                        <TextBlock Classes="label" FontSize="11" Text="{Binding CodeLookup.SendMonitorSummary}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Content="Bật gửi" VerticalAlignment="Center"
                              IsChecked="{Binding CodeLookup.SendingEnabled, Mode=TwoWay}" />
                    <Button Grid.Column="2" Classes="soft" Content="Làm mới" Height="36" MinWidth="94"
                            VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                            IsEnabled="{Binding !CodeLookup.IsSendMonitorBusy}"
                            Command="{Binding CodeLookup.RefreshSendMonitorCommand}" />
                </Grid>
                <TextBlock Grid.Row="1" Classes="label" Margin="14,0,14,4" FontSize="11" TextWrapping="Wrap"
                           Text="{Binding CodeLookup.CheckeeStatusText}" />
                <TabControl x:Name="CheckeeSendMonitorTabs" Grid.Row="2">
                    <TabItem Header="{Binding CodeLookup.PendingSendCountText}">
                        <ScrollViewer x:Name="PendingSendScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CodeLookup.PendingSendRows}" ItemTemplate="{StaticResource SendMonitorRow}" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{Binding CodeLookup.SentSendCountText}">
                        <ScrollViewer x:Name="SentSendScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CodeLookup.SentSendRows}" ItemTemplate="{StaticResource SendMonitorRow}" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{Binding CodeLookup.FailedSendCountText}">
                        <ScrollViewer x:Name="FailedSendScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CodeLookup.FailedSendRows}" ItemTemplate="{StaticResource SendMonitorRow}" />
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
        <!-- Lịch sử là snapshot từng lần gửi, tối đa 60 lần mới nhất. -->
        <Border x:Name="CheckeeSendHistoryPanel" Grid.Row="4" Classes="panel" Padding="0" Height="220">
            <Grid RowDefinitions="Auto,Auto,*">
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="14,10" ColumnSpacing="8">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="sectionTitle" Text="LỊCH SỬ GỬI CHECKEE" />
                        <TextBlock Classes="label" FontSize="11" Text="{Binding CodeLookup.SendHistoryCountText}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="soft" Content="Làm mới" Height="36" MinWidth="94"
                            VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                            IsEnabled="{Binding !CodeLookup.IsSendHistoryBusy}"
                            Command="{Binding CodeLookup.LoadSendHistoryCommand}" />
                    <Button Grid.Column="2" Classes="soft" Content="Gửi lại mã lỗi" Height="36" MinWidth="132"
                            VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                            IsEnabled="{Binding CodeLookup.SendingEnabled}"
                            Command="{Binding CodeLookup.ResendFailedCommand}"
                            ToolTip.Tip="Đưa mã có trạng thái gửi lỗi về hàng đợi để gửi lại sau khi đối soát." />
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="155,*,190,145" ColumnSpacing="10" Margin="14,0,14,6">
                    <TextBlock Classes="overline" Text="THỜI GIAN" />
                    <TextBlock Grid.Column="1" Classes="overline" Text="MÃ LÔ" />
                    <TextBlock Grid.Column="2" Classes="overline" Text="SỐ MÃ OK / FAIL" />
                    <TextBlock Grid.Column="3" Classes="overline" Text="KẾT QUẢ" />
                </Grid>
                <Grid Grid.Row="2">
                    <TextBlock Classes="label" Margin="14" Text="Chưa có lịch sử gửi Checkee."
                               IsVisible="{Binding !CodeLookup.HasSendHistory}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CodeLookup.SendHistoryRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CheckeeSendHistoryRowViewModel">
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Background="Transparent" BorderThickness="0,0,0,1"
                                            BorderBrush="{StaticResource LineColor}" Padding="14,8" MinHeight="40"
                                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).CodeLookup.ShowSendAttemptCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="155,*,190,145" ColumnSpacing="10">
                                            <TextBlock Classes="mono" FontSize="11" Text="{Binding TimeText}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Classes="label" Text="{Binding BatchText}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Classes="label" Text="{Binding CountText}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="3" FontWeight="SemiBold" FontSize="11"
                                                       Foreground="{StaticResource TextPrimary}" Text="{Binding StatusText}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
        </ScrollViewer>
        <!-- Bảng chi tiết nổi: chiều cao hữu hạn, nội dung mã/lỗi luôn wrap và cuộn. -->
        <Border Background="#80000000" IsVisible="{Binding CodeLookup.IsSendDetailsOpen}"
                Padding="18" ZIndex="10">
            <Border Classes="panel" Padding="16" BoxShadow="0 8 30 0 #30000000">
                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock Classes="sectionTitle" Text="{Binding CodeLookup.SendDetailTitle}" TextWrapping="Wrap" />
                        <Button Grid.Column="1" Classes="soft" Content="Đóng" Command="{Binding CodeLookup.CloseSendDetailsCommand}" />
                    </Grid>
                    <TextBlock Grid.Row="1" Classes="label" TextWrapping="Wrap"
                               Text="Kết quả theo phản hồi batch Checkee. Lần chưa xác nhận không được tính OK; lỗi mạng có thể được thử lại ở lần tiếp theo." />
                    <Grid Grid.Row="2" ColumnDefinitions="2*,90,125,2*" ColumnSpacing="12">
                        <TextBlock Classes="overline" Text="NỘI DUNG MÃ" />
                        <TextBlock Grid.Column="1" Classes="overline" Text="PO" />
                        <TextBlock Grid.Column="2" Classes="overline" Text="KẾT QUẢ" />
                        <TextBlock Grid.Column="3" Classes="overline" Text="CHI TIẾT" />
                    </Grid>
                    <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CodeLookup.SendDetailRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CheckeeSendDetailRowViewModel">
                                    <Border BorderBrush="{StaticResource LineColor}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid ColumnDefinitions="2*,90,125,2*" ColumnSpacing="12">
                                            <TextBlock Classes="mono" FontSize="12" Text="{Binding CodeText}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Classes="label" Text="{Binding OrderNoText}" TextWrapping="Wrap" />
                                            <StackPanel Grid.Column="2" Spacing="4">
                                                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Text="{Binding StatusText}" TextWrapping="Wrap" />
                                                <TextBlock Classes="label" Text="{Binding HttpText}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Classes="label" Text="{Binding Message}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
