<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TanTienQR.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="700"
             x:Class="TanTienQR.Views.AccountsView"
             x:DataType="vm:MainViewModel">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*" Margin="18,6,18,18" RowSpacing="12">

        <!-- Tiêu đề + thanh công cụ -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="Tài khoản người dùng"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}" />
                <TextBlock Classes="label"
                           FontSize="12"
                           Text="Tạo, sửa, khoá tài khoản và phân quyền truy cập theo vai trò." />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="soft"
                        Height="36" MinWidth="92" Padding="14,0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Content="Làm mới"
                        Command="{Binding AccountsView.LoadCommand}" />
                <Button Classes="primary"
                        Height="36" MinWidth="110" Padding="14,0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Content="+ Tài khoản"
                        Command="{Binding AccountsView.AddUserCommand}" />
            </StackPanel>
        </Grid>

        <!-- Thông báo trạng thái -->
        <Border Grid.Row="1"
                Padding="12,9"
                CornerRadius="9"
                Background="{StaticResource BgRaised}"
                BorderBrush="{StaticResource LineColor}"
                BorderThickness="1">
            <TextBlock Text="{Binding AccountsView.StatusMessage}"
                       FontSize="12"
                       Foreground="{StaticResource TextMuted}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Bảng tài khoản -->
        <Border Grid.Row="2" Classes="panel" Padding="0">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Header cột -->
                <Border Grid.Row="0"
                        BorderBrush="{StaticResource LineColor}"
                        BorderThickness="0,0,0,1"
                        Padding="14,10"
                        Background="{StaticResource BgRaised}">
                    <Grid ColumnDefinitions="180,200,130,130,150,auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="TÊN ĐĂNG NHẬP" />
                        <TextBlock Grid.Column="1" Classes="fieldLabel" Text="TÊN HIỂN THỊ" />
                        <TextBlock Grid.Column="2" Classes="fieldLabel" Text="VAI TRÒ" />
                        <TextBlock Grid.Column="3" Classes="fieldLabel" Text="TRẠNG THÁI" />
                        <TextBlock Grid.Column="4" Classes="fieldLabel" Text="ĐĂNG NHẬP CUỐI" />
                        <TextBlock Grid.Column="5" Classes="fieldLabel" Text="THAO TÁC" />
                    </Grid>
                </Border>

                <!-- Các dòng tài khoản -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AccountsView.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:UserRowViewModel">
                                <Border BorderBrush="{StaticResource LineColor}"
                                        BorderThickness="0,0,0,1"
                                        Padding="14,9">
                                    <Grid ColumnDefinitions="180,200,130,130,150,auto" ColumnSpacing="10">

                                        <!-- Tên đăng nhập + avatar -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"
                                                    VerticalAlignment="Center">
                                            <Border Width="28" Height="28"
                                                    CornerRadius="14"
                                                    Background="{StaticResource AccentSoft}">
                                                <TextBlock Text="{Binding Initial}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource Accent}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Username}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Tên hiển thị -->
                                        <TextBlock Grid.Column="1"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding DisplayName}" />

                                        <!-- Vai trò -->
                                        <Border Grid.Column="2"
                                                Classes="badge"
                                                Classes.running="{Binding IsRoleOperator}"
                                                Classes.warning="{Binding IsRoleWorker}"
                                                Classes.accent="{Binding IsRoleAdministrator}"
                                                Classes.developer="{Binding IsRoleDeveloper}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RoleName}" />
                                        </Border>

                                        <!-- Trạng thái -->
                                        <Border Grid.Column="3"
                                                Classes="badge"
                                                Classes.running="{Binding IsActive}"
                                                Classes.warning="{Binding IsLocked}"
                                                Classes.fault="{Binding !IsActive}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" />
                                        </Border>

                                        <!-- Đăng nhập cuối -->
                                        <TextBlock Grid.Column="4"
                                                   Classes="mono"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMuted}"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding LastLoginText}" />

                                        <!-- Nút thao tác -->
                                        <StackPanel Grid.Column="5"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    VerticalAlignment="Center">
                                            <Button Classes="soft"
                                                    Height="30" MinWidth="52" Padding="10,0"
                                                    FontSize="11"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Content="Sửa"
                                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AccountsView.EditUserCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Classes="soft"
                                                    Height="30" MinWidth="76" Padding="10,0"
                                                    FontSize="11"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Content="Mật khẩu"
                                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AccountsView.ResetPasswordCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Classes="soft"
                                                    Height="30" MinWidth="58" Padding="10,0"
                                                    FontSize="11"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Content="Khoá"
                                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AccountsView.ToggleActiveCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Classes="soft"
                                                    Height="30" MinWidth="52" Padding="10,0"
                                                    FontSize="11"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Content="Xoá"
                                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AccountsView.DeleteCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Thông báo khi không có dữ liệu -->
                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="6"
                            IsVisible="{Binding !AccountsView.IsBusy}">
                    <TextBlock Text="Chưa có tài khoản nào"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center" />
                    <TextBlock Classes="label"
                               FontSize="11"
                               Text="Bấm “+ Tài khoản” để tạo tài khoản đầu tiên."
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
