<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TanTienQR.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="700"
             x:Class="TanTienQR.Views.AccountsView"
             x:DataType="vm:MainViewModel">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- Nút thao tác trong từng dòng bảng (UI-006):
             trước đây Height="30" ép cứng, thắng MinHeight=38 của style chung
             (Button.soft) => nội dung bị cắt. Dùng style riêng "rowbtn" 32px
             (đủ cho chữ 11px có dấu) thay vì ép chiều cao trực tiếp.

             UI-020: cột THAO TÁC bị chật, chữ nút "Xoá" bị cắt.
             Nguyên nhân: Button.iconbtn đặt Height="44" cứng (cao hơn hàng 32px
             => tràn dọc), và các nút bị gán MinWidth cứng nhỏ hơn bề rộng nội dung
             thật (icon 16 + spacing 7 + chữ + padding 20) => chữ bị cắt ngang.
             Fix: ghi đè Height (không chỉ MinHeight) về 32, và bỏ MinWidth/Padding
             cứng ở XAML để nút tự co giãn theo nội dung (không cắt chữ). -->
        <Style Selector="Button.rowbtn">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- Icon trong nút hàng: nhỏ lại cho vừa chiều cao 32px -->
        <Style Selector="Button.rowbtn Path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>
        <Style Selector="Button.rowbtn StackPanel">
            <Setter Property="Spacing" Value="6" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*" Margin="18,6,18,18" RowSpacing="12">

        <!-- Tiêu đề + thanh công cụ -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="Tài khoản người dùng"
                           Classes="pageTitle" />
                <TextBlock Classes="label"
                           FontSize="12"
                           Text="Tạo, sửa, khoá tài khoản và phân quyền truy cập theo vai trò." />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="soft,iconbtn"
                        Height="38" MinWidth="92" Padding="14,0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Command="{Binding AccountsView.LoadCommand}">
                    <StackPanel>
                        <Path
                              Stroke="{StaticResource TextPrimary}"
                              Data="{StaticResource Icon.Refresh}" />
                        <TextBlock Text="Làm mới" />
                    </StackPanel>
                </Button>
                <Button Classes="primary,iconbtn"
                        Height="38" MinWidth="110" Padding="14,0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Command="{Binding AccountsView.AddUserCommand}">
                    <StackPanel>
                        <Path
                              Stroke="White"
                              Data="{StaticResource Icon.Plus}" />
                        <TextBlock Text="Tài khoản" Foreground="White" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Thông báo trạng thái -->
        <Border Grid.Row="1"
                Padding="12,9"
                CornerRadius="12"
                Background="{StaticResource BgRaised}"
                BorderBrush="{StaticResource LineColor}"
                BorderThickness="1">
            <TextBlock Text="{Binding AccountsView.StatusMessage}"
                       FontSize="12"
                       Foreground="{StaticResource TextMuted}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Bảng tài khoản -->
        <Border Grid.Row="2" Classes="panel" Padding="0">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Header cột -->
                <!-- ScrollViewer bên dưới để VerticalScrollBarVisibility="Visible":
                     thanh cuộn dọc luôn chiếm 16px ở mép phải. Vì vậy header dùng
                     Padding phải = 14 + 16 = 30px để vùng nội dung của header và
                     dữ liệu có cùng mép trái/phải => các cột thẳng hàng (UI-002). -->
                <Border Grid.Row="0"
                        BorderBrush="{StaticResource LineColor}"
                        BorderThickness="0,0,0,1"
                        Padding="14,10,30,10"
                        Background="#F8F9FB">
                    <Grid ColumnDefinitions="180,200,130,130,150,auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Classes="overline" Text="TÊN ĐĂNG NHẬP" />
                        <TextBlock Grid.Column="1" Classes="overline" Text="TÊN HIỂN THỊ" />
                        <TextBlock Grid.Column="2" Classes="overline" Text="VAI TRÒ" />
                        <TextBlock Grid.Column="3" Classes="overline" Text="TRẠNG THÁI" />
                        <TextBlock Grid.Column="4" Classes="overline" Text="ĐĂNG NHẬP CUỐI" />
                        <TextBlock Grid.Column="5" Classes="overline" Text="THAO TÁC" />
                    </Grid>
                </Border>

                <!-- Các dòng tài khoản -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Visible">
                    <ItemsControl ItemsSource="{Binding AccountsView.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:UserRowViewModel">
                                <Border BorderBrush="{StaticResource LineColor}"
                                        BorderThickness="0,0,0,1"
                                        Padding="14,9,30,9">
                                    <Grid ColumnDefinitions="180,200,130,130,150,auto" ColumnSpacing="10">

                                        <!-- Tên đăng nhập + avatar -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"
                                                    VerticalAlignment="Center">
                                            <Border Width="28" Height="28"
                                                    CornerRadius="14"
                                                    Background="{StaticResource AccentSoft}">
                                                <TextBlock Text="{Binding Initial}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource Accent}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Username}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Tên hiển thị -->
                                        <TextBlock Grid.Column="1"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding DisplayName}" />

                                        <!-- Vai trò -->
                                        <Border Grid.Column="2"
                                                Classes="badge"
                                                Classes.running="{Binding IsRoleOperator}"
                                                Classes.warning="{Binding IsRoleWorker}"
                                                Classes.accent="{Binding IsRoleAdministrator}"
                                                Classes.developer="{Binding IsRoleDeveloper}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RoleName}" />
                                        </Border>

                                        <!-- Trạng thái -->
                                        <Border Grid.Column="3"
                                                Classes="badge"
                                                Classes.running="{Binding IsActive}"
                                                Classes.warning="{Binding IsLocked}"
                                                Classes.fault="{Binding !IsActive}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" />
                                        </Border>

                                        <!-- Đăng nhập cuối -->
                                        <TextBlock Grid.Column="4"
                                                   Classes="mono"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMuted}"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding LastLoginText}" />

                                        <!-- Nút thao tác -->
                                        <StackPanel Grid.Column="5"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    VerticalAlignment="Center">
                                            <Button Classes="soft,iconbtn,rowbtn"
                                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AccountsView.EditUserCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <Path
                                                          Stroke="{StaticResource TextPrimary}"
                                                          Data="{StaticResource Icon.File}" />
                                                    <TextBlock Text="Sửa" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="soft,iconbtn,rowbtn"
                                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AccountsView.ResetPasswordCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <Path
                                                          Stroke="{StaticResource TextPrimary}"
                                                          Data="{StaticResource Icon.Key}" />
                                                    <TextBlock Text="Mật khẩu" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="soft,iconbtn,rowbtn"
                                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AccountsView.ToggleActiveCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <Path
                                                          Stroke="{StaticResource TextPrimary}"
                                                          Data="{StaticResource Icon.Lock}" />
                                                    <TextBlock Text="Khoá" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="soft,iconbtn,rowbtn"
                                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AccountsView.DeleteCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <Path
                                                          Stroke="{StaticResource Danger}"
                                                          Data="{StaticResource Icon.Trash}" />
                                                    <TextBlock Text="Xoá" Foreground="{StaticResource Danger}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Thông báo khi không có dữ liệu -->
                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="10"
                            IsVisible="{Binding AccountsView.IsEmpty}">
                    <Border Width="52" Height="52"
                            CornerRadius="16"
                            Background="{StaticResource AccentSoft}">
                        <Path Width="24" Height="24"
                              Stroke="{StaticResource Accent}"
                              StrokeThickness="1.8"
                              Data="{StaticResource Icon.User}" />
                    </Border>
                    <TextBlock Text="Chưa có tài khoản nào"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center" />
                    <TextBlock Classes="label"
                               FontSize="13"
                               Text="Bấm “+ Tài khoản” để tạo tài khoản đầu tiên."
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
