<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TanTienQR.ViewModels"
             x:Class="TanTienQR.Views.SettingsV2SectionEditor"
             x:DataType="vm:ConfigSectionViewModel">
    <StackPanel Spacing="16">
        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12"
                   Foreground="#56617a" IsVisible="{Binding HasDescription}" />
        <ItemsControl ItemsSource="{Binding Fields}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ConfigFieldViewModel">
                    <StackPanel Margin="0,0,0,14" Spacing="5">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Text="{Binding Label}" Foreground="#111a2e" />
                            <TextBlock Grid.Column="1" Text="Đã sửa" FontSize="10" Foreground="#2456d6"
                                       IsVisible="{Binding IsDirty}" />
                        </Grid>
                        <ContentControl Content="{Binding}" HorizontalContentAlignment="Stretch">
                            <ContentControl.DataTemplates>
                                <DataTemplate DataType="vm:TextField">
                                    <TextBox MinHeight="40" PlaceholderText="{Binding Placeholder}"
                                             Text="{Binding TextValue, Mode=TwoWay}"
                                             AutomationProperties.Name="{Binding Label}" />
                                </DataTemplate>
                                <DataTemplate DataType="vm:NumberField">
                                    <NumericUpDown MinHeight="40" Minimum="{Binding Minimum}"
                                                   Maximum="{Binding Maximum}" Increment="{Binding Increment}"
                                                   FormatString="0" Value="{Binding Value, Mode=TwoWay}"
                                                   AutomationProperties.Name="{Binding Label}" />
                                </DataTemplate>
                                <DataTemplate DataType="vm:BoolField">
                                    <ToggleSwitch Theme="{StaticResource IosToggleSwitchTheme}"
                                                  IsChecked="{Binding Value, Mode=TwoWay}"
                                                  AutomationProperties.Name="{Binding Label}" />
                                </DataTemplate>
                                <DataTemplate DataType="vm:ComboField">
                                    <ComboBox MinHeight="40" ItemsSource="{Binding Options}"
                                              SelectedItem="{Binding Value, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="{Binding Label}" />
                                </DataTemplate>
                                <DataTemplate DataType="vm:PasswordField">
                                    <TextBox MinHeight="40" PasswordChar="●"
                                             PlaceholderText="{Binding Placeholder}"
                                             Text="{Binding TextValue, Mode=TwoWay}"
                                             AutomationProperties.Name="{Binding Label}" />
                                </DataTemplate>
                            </ContentControl.DataTemplates>
                        </ContentControl>
                        <TextBlock FontSize="11" Foreground="#56617a" TextWrapping="Wrap"
                                   Text="{Binding HelpText}" />
                        <TextBlock FontSize="11" Foreground="#b4202c" TextWrapping="Wrap"
                                   Text="{Binding Error}" IsVisible="{Binding HasError}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
