<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TanTienQR.ViewModels"
        xmlns:controls="using:TanTienQR.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="440"
        x:Class="TanTienQR.Views.PasswordChangeWindow"
        x:DataType="vm:PasswordChangeViewModel"
        Title="Đổi mật khẩu"
        Width="400" Height="440"
        MinWidth="360" MinHeight="420"
        CanResize="False"
        CanMinimize="False"
        CanMaximize="False"
        WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <vm:PasswordChangeViewModel />
    </Design.DataContext>

    <Border Background="{StaticResource BgBase}" Padding="26">
        <Grid>

        <StackPanel Spacing="16">

            <!-- Tiêu đề -->
            <StackPanel Spacing="10" HorizontalAlignment="Center">
                <Border Width="48" Height="48"
                        CornerRadius="15"
                        Background="{StaticResource WarnSoft}"
                        HorizontalAlignment="Center">
                    <TextBlock Text="🔒"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Đổi mật khẩu"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Bạn phải đổi mật khẩu trước khi sử dụng ứng dụng."
                           FontSize="11"
                           Foreground="{StaticResource TextMuted}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           MaxWidth="300" />
            </StackPanel>

            <!-- Tài khoản -->
            <Border Classes="device" Padding="12">
                <StackPanel Spacing="2">
                    <TextBlock Classes="fieldLabel" Text="TÀI KHOẢN" />
                    <TextBlock Text="{Binding Username}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" />
                </StackPanel>
            </Border>

            <!-- Mật khẩu hiện tại -->
            <StackPanel Spacing="6">
                <TextBlock Classes="fieldLabel" Text="MẬT KHẨU HIỆN TẠI" />
                <TextBox Classes="field"
                         Height="42"
                         PasswordChar="•"
                         PlaceholderText="Nhập mật khẩu hiện tại"
                         Text="{Binding CurrentPassword}" />
            </StackPanel>

            <!-- Mật khẩu mới -->
            <StackPanel Spacing="6">
                <TextBlock Classes="fieldLabel" Text="MẬT KHẨU MỚI" />
                <TextBox Classes="field"
                         Height="42"
                         PasswordChar="•"
                         PlaceholderText="Tối thiểu 6 ký tự"
                         Text="{Binding NewPassword}" />
            </StackPanel>

            <!-- Xác nhận -->
            <StackPanel Spacing="6">
                <TextBlock Classes="fieldLabel" Text="XÁC NHẬN MẬT KHẨU MỚI" />
                <TextBox Classes="field"
                         Height="42"
                         PasswordChar="•"
                         PlaceholderText="Nhập lại mật khẩu mới"
                         Text="{Binding ConfirmPassword}" />
            </StackPanel>

            <!-- Lỗi -->
            <Border IsVisible="{Binding HasError}"
                    Padding="11"
                    CornerRadius="10"
                    Background="{StaticResource DangerSoft}"
                    BorderBrush="{StaticResource Danger}"
                    BorderThickness="1">
                <TextBlock Text="{Binding ErrorMessage}"
                           FontSize="12"
                           Foreground="{StaticResource Danger}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Nút -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                <Button Grid.Column="0"
                        Classes="soft"
                        Height="44"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Content="Huỷ"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="1"
                        Classes="primary"
                        Height="44"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Content="Lưu mật khẩu"
                        IsEnabled="{Binding CanSubmit}"
                        Command="{Binding ConfirmCommand}" />
            </Grid>
        </StackPanel>

            <!-- Bàn phím ảo (máy cảm ứng): phủ lên đáy hộp thoại -->
            <controls:VirtualKeyboard VerticalAlignment="Bottom"
                                     DataContext="{Binding Keyboard}" />
        </Grid>
    </Border>
</Window>
