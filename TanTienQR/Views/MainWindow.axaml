<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TanTienQR.ViewModels"
        xmlns:views="using:TanTienQR.Views"
        xmlns:controls="using:TanTienQR.Controls"
        xmlns:prim="using:Avalonia.Controls.Primitives"
        xmlns:d="http://schemas.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="TanTienQR.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/tantien-logo.ico"
        Title="TanTienQR · Quét mã - PLC Omron"
        Width="1360" Height="820"
        MinWidth="1100" MinHeight="700"
        CanResize="True"
        CanMinimize="True"
        CanMaximize="True"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <!-- Chỉ dùng cho trình xem trước trong IDE; DataContext lúc chạy được gán trong App.axaml.cs -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Viền accent trên cùng của custom chrome -->
        <Border Grid.Row="0" Height="3" Background="{StaticResource Accent}" />

        <!-- ===== Thanh tiêu đề tự vẽ: logo + tab + trạng thái + nút cửa sổ ===== -->
        <Border Grid.Row="1" x:Name="HeaderBar"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource LineColor}"
                BorderThickness="0,0,0,1"
                Padding="16,8,8,8"
                PointerPressed="OnHeaderPointerPressed">
            <Grid RowDefinitions="Auto,Auto"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="18"
                  RowSpacing="8">

                <!-- Logo -->
                <StackPanel Grid.Row="0" Grid.Column="0"
                            Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="38" Height="38"
                            CornerRadius="11"
                            Background="White"
                            BorderBrush="{StaticResource LineAccent}"
                            BorderThickness="1">
                        <Image Source="/Assets/tantien-logo-tt.png"
                               Stretch="Uniform"
                               Margin="3" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="TanTienQR"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="Quét mã · PLC"
                                   Classes="label"
                                   FontSize="10" />
                    </StackPanel>
                </StackPanel>

                <!-- Tiêu đề trang (lấp khoảng trống giữa, giúp header cân đối) -->
                <StackPanel Grid.Row="0" Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="1"
                            Margin="8,0">
                    <TextBlock Text="{Binding PageTitle}"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding PageSubtitle}"
                               Classes="label"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Thanh tab: chiếm hết hàng riêng, nút co giãn theo noi dung
                     -> khong bao gio chong cheo voi logo / vung trang thai ben phai -->
                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                    <ScrollViewer Classes="segtabs"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <!-- Grid boc trong ScrollViewer: Border ben trong moi duoc canh giua
                             theo quy tac cua Grid (ScrollViewer khong ho tro canh giua noi dung). -->
                        <Grid>
                            <Border HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource BgRaised}"
                                    BorderBrush="{StaticResource LineColor}"
                                    BorderThickness="1"
                                    CornerRadius="999"
                                    Padding="4">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="segtab"
                                Classes.active="{Binding IsInfoVisible}"
                                Command="{Binding ShowInfoTabCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Classes="icon"
                                      Width="15" Height="15"
                                      Stretch="Uniform"
                                      StrokeThickness="2"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Data="M4,4 L12,4 L12,11 L4,11 Z M16,4 L20,4 L20,11 L16,11 Z M4,15 L12,15 L12,19 L4,19 Z M16,15 L20,15 L20,19 L16,19 Z" />
                                <TextBlock Text="Thông tin" />
                            </StackPanel>
                        </Button>

                        <Button Classes="segtab"
                                Classes.active="{Binding IsProductionVisible}"
                                Command="{Binding ShowProductionTabCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Classes="icon"
                                      Width="15" Height="15"
                                      Stretch="Uniform"
                                      StrokeThickness="2"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Data="M3,12 A9,9 0 1 0 3,4 M3,12 L12,12 M12,3 C8,7 8,17 12,21" />
                                <TextBlock Text="Sản xuất" />
                            </StackPanel>
                        </Button>

                        <Button Classes="segtab"
                                Classes.active="{Binding IsConfigVisible}"
                                Command="{Binding ShowConfigTabCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Classes="icon"
                                      Width="15" Height="15"
                                      Stretch="Uniform"
                                      StrokeThickness="2"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Data="M4,7 L8,7 M10,7 L20,7 M4,17 L12,17 M16,17 L20,17 M8,4 L8,10 M16,14 L16,20" />
                                <TextBlock Text="Cấu hình" />
                            </StackPanel>
                        </Button>

                        <Button Classes="segtab"
                                Classes.active="{Binding IsPlcSettingsVisible}"
                                IsVisible="{Binding CanEditPlc}"
                                Command="{Binding ShowPlcSettingsTabCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Classes="icon"
                                      Width="15" Height="15"
                                      Stretch="Uniform"
                                      StrokeThickness="2"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Data="M4,8 L8,8 M12,8 L20,8 M6,4 L6,12 M14,4 L14,12 M4,16 L20,16 M8,12 L8,20 M16,12 L16,20" />
                                <TextBlock Text="Chỉnh PLC" />
                            </StackPanel>
                        </Button>

                        <Button Classes="segtab"
                                Classes.active="{Binding IsHistoryVisible}"
                                IsVisible="{Binding CanViewHistory}"
                                Command="{Binding ShowHistoryTabCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Classes="icon"
                                      Width="15" Height="15"
                                      Stretch="Uniform"
                                      StrokeThickness="2"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Data="M4,5 L4,19 L7,19 L7,5 Z M9,5 L9,19 L12,19 L12,5 Z M14,5 L14,19 L17,19 L17,5 Z M20,9 L20,19 L20,19" />
                                <TextBlock Text="Lịch sử" />
                            </StackPanel>
                        </Button>

                        <Button Classes="segtab"
                                Classes.active="{Binding IsAccountsVisible}"
                                IsVisible="{Binding CanManageUsers}"
                                Command="{Binding ShowAccountsTabCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Classes="icon"
                                      Width="15" Height="15"
                                      Stretch="Uniform"
                                      StrokeThickness="2"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Data="M12,11 A4,4 0 1 0 12,3 A4,4 0 1 0 12,11 Z M4,21 C4,16.5 7.6,14 12,14 C16.4,14 20,16.5 20,21" />
                                <TextBlock Text="Tài khoản" />
                            </StackPanel>
                        </Button>

                        <!-- Dev: chỉ Lập trình viên -->
                        <Button Classes="segtab"
                                Classes.active="{Binding IsDevVisible}"
                                IsVisible="{Binding CanViewDev}"
                                Command="{Binding ShowDevTabCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Classes="icon"
                                      Width="15" Height="15"
                                      Stretch="Uniform"
                                      StrokeThickness="2"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Data="M8,4 L16,4 L20,8 L20,20 L4,20 L4,8 Z M8,4 L8,8 L20,8 M8,12 L16,12 M8,16 L16,16" />
                                <TextBlock Text="Dev" />
                            </StackPanel>
                        </Button>
                            </StackPanel>
                        </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- Trạng thái + đồng hồ (độ rộng ổn định, không phụ thuộc tab đang mở) -->
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Classes="pill" Classes.ok="{Binding IsReady}" Classes.warn="{Binding !IsReady}"
                            MinWidth="96">
                        <TextBlock Text="{Binding AppStateText}" HorizontalAlignment="Center" />
                    </Border>

                    <Border Width="1" Height="28"
                            Background="{StaticResource LineColor}"
                            VerticalAlignment="Center" />

                    <!-- Người dùng đang đăng nhập + vai trò -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Border Width="30" Height="30"
                                CornerRadius="15"
                                Background="{StaticResource AccentSoft}">
                            <TextBlock Text="{Binding CurrentUserInitial}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Accent}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="0" VerticalAlignment="Center" MaxWidth="130">
                            <TextBlock Text="{Binding CurrentUserDisplayName}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding CurrentUserDisplayName}" />
                            <Border Classes="badge"
                                    Classes.running="{Binding IsRoleOperator}"
                                    Classes.warning="{Binding IsRoleWorker}"
                                    Classes.accent="{Binding IsRoleAdministrator}"
                                    Classes.developer="{Binding IsRoleDeveloper}"
                                    HorizontalAlignment="Left"
                                    Padding="6,1"
                                    CornerRadius="5">
                                <TextBlock Text="{Binding CurrentRoleText}" FontSize="9" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Nút đăng xuất -->
                    <Button x:Name="LogoutButton"
                            Width="34" Height="34"
                            MinWidth="0" MinHeight="0"
                            Padding="0"
                            CornerRadius="17"
                            Background="{StaticResource BgRaised}"
                            BorderBrush="{StaticResource LineColor}"
                            BorderThickness="1"
                            Foreground="{StaticResource TextMuted}"
                            FontSize="13"
                            FontWeight="Bold"
                            Content="⏻"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Đăng xuất"
                            Command="{Binding LogoutCommand}" />

                    <StackPanel Spacing="0" MinWidth="124">
                        <TextBlock Classes="mono"
                                   Text="{Binding ClockText}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right" />
                        <TextBlock Classes="label" FontSize="10" Text="{Binding DateText}" HorizontalAlignment="Right" />
                    </StackPanel>

                    <!-- Nút ? mở nhanh thông tin license -->
                    <Button x:Name="LicenseInfoButton"
                            Width="34" Height="34"
                            MinWidth="0" MinHeight="0"
                            Padding="0"
                            CornerRadius="17"
                            Background="{StaticResource BgRaised}"
                            BorderBrush="{StaticResource LineColor}"
                            BorderThickness="1"
                            Foreground="{StaticResource TextMuted}"
                            FontSize="15"
                            FontWeight="Bold"
                            Content="?"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Thông tin license"
                            Command="{Binding ToggleLicensePanelCommand}" />

                    <!-- Menu cửa sổ (custom chrome): gộp thu nhỏ / phóng to / tắt vào 1 nút hamburger -->
                    <Button x:Name="WindowMenuButton"
                            Classes="windowmenu"
                            Width="34" Height="34"
                            MinWidth="0" MinHeight="0"
                            Padding="0,1,0,0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Tùy chọn cửa sổ"
                            Click="OnWindowMenuClick">
                        <Path Width="15" Height="15"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stretch="Uniform"
                              StrokeThickness="2"
                              StrokeLineCap="Round"
                              Data="M4,6 L20,6 M4,12 L20,12 M4,18 L20,18" />
                    </Button>
                </StackPanel>

                <!-- Menu cửa sổ thả xuống (overlay, popup tự vẽ đồng bộ với app) -->
                <Popup x:Name="WindowMenuPopup"
                       PlacementTarget="{Binding #WindowMenuButton}"
                       Placement="BottomEdgeAlignedRight"
                       VerticalOffset="8"
                       IsLightDismissEnabled="True"
                       Topmost="True">
                    <Border Width="250"
                            Padding="8"
                            CornerRadius="14"
                            Background="{StaticResource BgPanel}"
                            BorderBrush="{StaticResource LineColor}"
                            BorderThickness="1"
                            BoxShadow="0 12 32 0 #33000000">
                        <StackPanel Spacing="2">
                            <TextBlock Text="CỬA SỔ"
                                       Classes="label"
                                       FontSize="10"
                                       Margin="12,6,0,4" />
                            <Button Classes="menubtn" Click="OnMinimizeClick">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="30" Height="30" CornerRadius="9"
                                            Background="{StaticResource BgRaised}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="–" FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="0" VerticalAlignment="Center">
                                        <TextBlock Text="Thu nhỏ" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Ẩn xuống thanh tác vụ" FontSize="10" Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Classes="menubtn" Click="OnMaxRestoreClick">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="30" Height="30" CornerRadius="9"
                                            Background="{StaticResource BgRaised}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="▢" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="0" VerticalAlignment="Center">
                                        <TextBlock Text="Phóng to / khôi phục" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Chuyển chế độ toàn màn hình" FontSize="10" Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Border Height="1" Margin="12,6"
                                    Background="{StaticResource LineColor}" />
                            <Button Classes="menubtn danger" Click="OnShutdownClick">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="30" Height="30" CornerRadius="9"
                                            Background="{StaticResource DangerSoft}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="✕" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource Danger}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="0" VerticalAlignment="Center">
                                        <TextBlock Text="Tắt ứng dụng" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Đóng và dừng worker" FontSize="10" Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Hộp thoại license thu gọn (overlay, không chiếm layout) -->
                <Popup PlacementTarget="{Binding #LicenseInfoButton}"
                       Placement="BottomEdgeAlignedRight"
                       VerticalOffset="10"
                       IsOpen="{Binding IsLicensePanelOpen, Mode=TwoWay}"
                       IsLightDismissEnabled="True"
                       Topmost="True">
                    <Border Width="300"
                            Padding="16"
                            CornerRadius="14"
                            Background="{StaticResource BgPanel}"
                            BorderBrush="{StaticResource LineColor}"
                            BorderThickness="1"
                            BoxShadow="0 12 32 0 #33000000">
                        <StackPanel Spacing="12">
                            <!-- Tiêu đề + nút đóng -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border Width="32" Height="32"
                                        CornerRadius="10"
                                        Background="{StaticResource AccentSoft}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="◈"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource Accent}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="Giấy phép sử dụng"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="Trạng thái bản quyền phần mềm"
                                               FontSize="10"
                                               Foreground="{StaticResource TextMuted}" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Width="28" Height="28"
                                        CornerRadius="14"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Foreground="{StaticResource TextMuted}"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Content="✕"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Đóng"
                                        Command="{Binding ToggleLicensePanelCommand}" />
                            </Grid>

                            <!-- Trạng thái + thời hạn -->
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Classes="badge"
                                        Classes.running="{Binding IsLicenseRunning}"
                                        Classes.warning="{Binding IsLicenseWarning}"
                                        Classes.fault="{Binding IsLicenseFault}">
                                    <TextBlock Text="{Binding LicenseStatusText}" />
                                </Border>
                                <TextBlock FontSize="11"
                                           Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center"
                                           Text="{Binding LicenseDaysLeftText}" />
                            </StackPanel>

                            <!-- Thông tin chi tiết -->
                            <Border Classes="device" Padding="12">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                    <Grid ColumnDefinitions="86,*" ColumnSpacing="10">
                                        <TextBlock Classes="label" FontSize="10" Text="KHÁCH HÀNG" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding LicenseCustomerText}"
                                                   Text="{Binding LicenseCustomerText}" />
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnDefinitions="86,*" ColumnSpacing="10">
                                        <TextBlock Classes="label" FontSize="10" Text="HẾT HẠN" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Classes="mono" FontSize="12"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   Text="{Binding LicenseExpiryText}" />
                                    </Grid>
                                    <Grid Grid.Row="2" ColumnDefinitions="86,*" ColumnSpacing="10">
                                        <TextBlock Classes="label" FontSize="10" Text="MÃ MÁY" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" Classes="mono" FontSize="10"
                                                   Foreground="{StaticResource TextMuted}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding HwidText}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Cảnh báo khi license lỗi -->
                            <Border Padding="10"
                                    CornerRadius="9"
                                    Background="{StaticResource DangerSoft}"
                                    BorderBrush="{StaticResource Danger}"
                                    BorderThickness="1"
                                    IsVisible="{Binding !IsLicenseValid}">
                                <TextBlock Text="{Binding LicenseMessageText}"
                                           FontSize="11"
                                           Foreground="{StaticResource Danger}"
                                           TextWrapping="Wrap"
                                           MaxLines="3"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>

                            <!-- Hành động -->
                            <Button HorizontalAlignment="Stretch"
                                    MinHeight="40"
                                    CornerRadius="10"
                                    Background="{StaticResource Accent}"
                                    BorderBrush="{StaticResource Accent}"
                                    BorderThickness="1"
                                    Foreground="White"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Content="Quản lý license..."
                                    Command="{Binding ShowLicenseWindowCommand}" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <!-- ===== Nội dung: sidebar + vùng tab ===== -->
        <Grid Grid.Row="2" ColumnDefinitions="240,*">

            <!-- ===== Sidebar ===== -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource LineColor}"
                    BorderThickness="0,0,1,0"
                    Padding="16,18">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="18">

                    <!-- Trạng thái app -->
                    <Border Grid.Row="0" Classes="device" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="label" FontSize="10" Text="TRẠNG THÁI ỨNG DỤNG" />
                            <Border Classes="badge"
                                    Classes.running="{Binding IsReady}"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{Binding AppStateText}" />
                            </Border>
                            <TextBlock Text="{Binding AppStateDetail}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap"
                                       MaxLines="3" />
                        </StackPanel>
                    </Border>

                    <!-- Thiết bị -->
                    <StackPanel Grid.Row="1" Spacing="8">
                        <TextBlock Classes="label" FontSize="10" Text="THIẾT BỊ" Margin="2,0,0,0" />

                        <!-- Camera: viền + LED chớp khi mất kết nối -->
                        <Border Classes="deviceCard {Binding CameraCardClass}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Grid Width="11" Height="11">
                                    <Ellipse Classes="ledHalo"
                                             Classes.warn="{Binding !IsCameraConnected}"
                                             Classes.blink="{Binding IsCameraBlinking}" />
                                    <Ellipse Classes="led"
                                             Classes.on="{Binding IsCameraConnected}"
                                             Classes.warn="{Binding !IsCameraConnected}"
                                             Classes.blink="{Binding IsCameraBlinking}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="deviceTitle" Text="Camera RD" />
                                    <TextBlock Classes="deviceStatus" Text="{Binding CameraStatusText}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- PLC: viền + LED chớp khi mất kết nối -->
                        <Border Classes="deviceCard {Binding PlcCardClass}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Grid Width="11" Height="11">
                                    <Ellipse Classes="ledHalo"
                                             Classes.warn="{Binding !IsPlcConnected}"
                                             Classes.blink="{Binding IsPlcBlinking}" />
                                    <Ellipse Classes="led"
                                             Classes.on="{Binding IsPlcConnected}"
                                             Classes.warn="{Binding !IsPlcConnected}"
                                             Classes.blink="{Binding IsPlcBlinking}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="deviceTitle" Text="PLC Omron" />
                                    <TextBlock Classes="deviceStatus" Text="{Binding PlcStatusText}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Lối vào nhanh các tab -->
                    <StackPanel Grid.Row="2" Spacing="8" VerticalAlignment="Top">
                        <TextBlock Classes="label" FontSize="10" Text="MỤC LỤC" Margin="2,0,0,0" />

                        <Button Classes="chip"
                                HorizontalAlignment="Stretch"
                                FontSize="12"
                                HorizontalContentAlignment="Left"
                                Content="Thông tin"
                                Command="{Binding ShowInfoTabCommand}" />
                        <Button Classes="chip"
                                HorizontalAlignment="Stretch"
                                FontSize="12"
                                HorizontalContentAlignment="Left"
                                Content="Sản xuất"
                                Command="{Binding ShowProductionTabCommand}" />
                        <Button Classes="chip"
                                HorizontalAlignment="Stretch"
                                FontSize="12"
                                HorizontalContentAlignment="Left"
                                Content="Cấu hình"
                                Command="{Binding ShowConfigTabCommand}" />
                        <Button Classes="chip"
                                HorizontalAlignment="Stretch"
                                FontSize="12"
                                HorizontalContentAlignment="Left"
                                Content="Chỉnh PLC"
                                IsVisible="{Binding CanEditPlc}"
                                Command="{Binding ShowPlcSettingsTabCommand}" />

                        <!-- Nhóm nhà phát triển -->
                        <Border Classes="device"
                                Padding="8"
                                Margin="0,10,0,0"
                                IsVisible="{Binding CanViewHistory}">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="label"
                                           FontSize="9"
                                           Text="NHÀ PHÁT TRIỂN"
                                           Margin="2,0,0,2" />
                                <Button Classes="chip"
                                        HorizontalAlignment="Stretch"
                                        FontSize="12"
                                        HorizontalContentAlignment="Left"
                                        Content="Lịch sử thao tác"
                                        Command="{Binding ShowHistoryTabCommand}" />
                                <Button Classes="chip"
                                        HorizontalAlignment="Stretch"
                                        FontSize="12"
                                        HorizontalContentAlignment="Left"
                                        Content="Dev"
                                        IsVisible="{Binding CanViewDev}"
                                        Command="{Binding ShowDevTabCommand}" />
                            </StackPanel>
                        </Border>

                        <!-- Nhóm quản trị (chỉ Quản trị / Lập trình viên) -->
                        <Border Classes="device"
                                Padding="8"
                                Margin="0,10,0,0"
                                IsVisible="{Binding CanManageUsers}">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="label"
                                           FontSize="9"
                                           Text="QUẢN TRỊ"
                                           Margin="2,0,0,2" />
                                <Button Classes="chip"
                                        HorizontalAlignment="Stretch"
                                        FontSize="12"
                                        HorizontalContentAlignment="Left"
                                        Content="Tài khoản"
                                        Command="{Binding ShowAccountsTabCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Gợi ý: license quản lý qua nút "?" trên thanh trên cùng -->
                    <TextBlock Grid.Row="3"
                               Classes="label"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Text="Nhấn dấu ? ở góc trên bên phải để xem thông tin license." />
                </Grid>
            </Border>

            <!-- ===== Vùng nội dung tab ===== -->
            <Grid Grid.Column="1">
                <views:InfoView IsVisible="{Binding IsInfoVisible}" />
                <views:ProductionView IsVisible="{Binding IsProductionVisible}" />
                <views:ConfigView IsVisible="{Binding IsConfigVisible}" />
                <views:HistoryView IsVisible="{Binding IsHistoryVisible}" />
                <views:AccountsView IsVisible="{Binding IsAccountsVisible}" />
                <views:PlcSettingsView IsVisible="{Binding IsPlcSettingsVisible}" />
                <views:DevView IsVisible="{Binding IsDevVisible}" />
            </Grid>
        </Grid>

        <!-- ===== Bàn phím ảo (máy cảm ứng) =====
             Hiện ở đáy cửa sổ khi người dùng chạm vào một ô nhập.
             Grid.Row="2" -> phủ lên vùng nội dung tab. -->
        <controls:VirtualKeyboard Grid.Row="2"
                                 VerticalAlignment="Bottom"
                                 DataContext="{Binding Keyboard}" />
    </Grid>
</Window>
