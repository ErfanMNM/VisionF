<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TanTienQR.ViewModels"
        xmlns:views="using:TanTienQR.Views"
        xmlns:d="http://schemas.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="TanTienQR.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/tantien-logo.png"
        Title="TanTienQR · Quét mã - PLC Omron"
        Width="1360" Height="820"
        MinWidth="1100" MinHeight="700"
        CanResize="True"
        CanMinimize="False"
        CanMaximize="True"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <!-- Chỉ dùng cho trình xem trước trong IDE; DataContext lúc chạy được gán trong App.axaml.cs -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">

        <!-- ===== Thanh trên cùng: logo + tab + trạng thái ===== -->
        <Border Grid.Row="0"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource LineColor}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="36" Height="36"
                            CornerRadius="11"
                            Background="{StaticResource Accent}">
                        <TextBlock Text="TT"
                                   FontSize="14"
                                   FontWeight="Black"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="TanTienQR"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="Quét mã · PLC"
                                   Classes="label"
                                   FontSize="10" />
                    </StackPanel>
                </StackPanel>

                <!-- Thanh tab -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button Classes="tab"
                            Classes.active="{Binding IsInfoVisible}"
                            Command="{Binding ShowInfoTabCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  StrokeThickness="2"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="M4,4 L12,4 L12,11 L4,11 Z M16,4 L20,4 L20,11 L16,11 Z M4,15 L12,15 L12,19 L4,19 Z M16,15 L20,15 L20,19 L16,19 Z" />
                            <TextBlock Text="Thông tin" />
                        </StackPanel>
                    </Button>

                    <Button Classes="tab"
                            Classes.active="{Binding IsProductionVisible}"
                            Command="{Binding ShowProductionTabCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  StrokeThickness="2"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="M3,12 A9,9 0 1 0 3,4 M3,12 L12,12 M12,3 C8,7 8,17 12,21" />
                            <TextBlock Text="Sản xuất" />
                        </StackPanel>
                    </Button>

                    <Button Classes="tab"
                            Classes.active="{Binding IsConfigVisible}"
                            Command="{Binding ShowConfigTabCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  StrokeThickness="2"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="M4,7 L8,7 M10,7 L20,7 M4,17 L12,17 M16,17 L20,17 M8,4 L8,10 M16,14 L16,20" />
                            <TextBlock Text="Cấu hình" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Trạng thái + đồng hồ -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding PageTitle}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Classes="label" FontSize="10" Text="{Binding PageSubtitle}" />
                    </StackPanel>

                    <Border Classes="pill" Classes.ok="{Binding IsReady}" Classes.warn="{Binding !IsReady}">
                        <TextBlock Text="{Binding AppStateText}" />
                    </Border>

                    <StackPanel Spacing="0">
                        <TextBlock Classes="mono"
                                   Text="{Binding ClockText}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right" />
                        <TextBlock Classes="label" FontSize="10" Text="{Binding DateText}" />
                    </StackPanel>

                    <!-- Nút ? mở nhanh thông tin license -->
                    <Button Width="34" Height="34"
                            CornerRadius="17"
                            Background="{StaticResource BgRaised}"
                            BorderBrush="{StaticResource LineColor}"
                            BorderThickness="1"
                            Foreground="{StaticResource TextMuted}"
                            FontSize="15"
                            FontWeight="Bold"
                            Content="?"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Thông tin license"
                            IsVisible="{Binding !IsLicensePanelOpen}"
                            Command="{Binding ToggleLicensePanelCommand}" />

                    <!-- Nút tắt ứng dụng -->
                    <Button Width="34" Height="34"
                            CornerRadius="17"
                            Background="{StaticResource DangerSoft}"
                            BorderBrush="{StaticResource LineDanger}"
                            BorderThickness="1"
                            Foreground="{StaticResource Danger}"
                            FontSize="15"
                            FontWeight="Bold"
                            Content="✕"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Tắt ứng dụng"
                            Command="{Binding ShutdownAppCommand}" />
                </StackPanel>

                <!-- Hộp thoại license thu gọn (popup) -->
                <Panel Grid.Column="2"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0,52,60,0"
                       Width="250"
                       IsVisible="{Binding IsLicensePanelOpen}"
                       ZIndex="11">
                    <Border Padding="14"
                            CornerRadius="12"
                            Background="{StaticResource BgPanel}"
                            BorderBrush="{StaticResource LineColor}"
                            BorderThickness="1"
                            BoxShadow="0 8 24 0 #22000000">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="LICENSE"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Classes="chip small"
                                        MinHeight="26"
                                        Padding="10,0"
                                        FontSize="11"
                                        Content="✕"
                                        Command="{Binding ToggleLicensePanelCommand}" />
                            </Grid>

                            <Border Classes="badge"
                                    HorizontalAlignment="Left"
                                    Classes.running="{Binding IsLicenseRunning}"
                                    Classes.warning="{Binding IsLicenseWarning}"
                                    Classes.fault="{Binding IsLicenseFault}">
                                <TextBlock Text="{Binding LicenseStatusText}" />
                            </Border>

                            <TextBlock FontSize="11"
                                       Foreground="{StaticResource TextMuted}"
                                       Text="{Binding LicenseCustomerText}" />

                            <TextBlock FontSize="11"
                                       Foreground="{StaticResource TextMuted}"
                                       Text="{Binding LicenseDaysLeftText}" />

                            <Button Classes="chip small"
                                    HorizontalAlignment="Stretch"
                                    FontSize="11"
                                    Content="Quản lý license..."
                                    Command="{Binding ShowLicenseWindowCommand}" />
                        </StackPanel>
                    </Border>
                </Panel>
            </Grid>
        </Border>

        <!-- ===== Nội dung: sidebar + vùng tab ===== -->
        <Grid Grid.Row="1" ColumnDefinitions="240,*">

            <!-- ===== Sidebar ===== -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource LineColor}"
                    BorderThickness="0,0,1,0"
                    Padding="16,18">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="18">

                    <!-- Trạng thái app -->
                    <Border Grid.Row="0" Classes="device" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="label" FontSize="10" Text="TRẠNG THÁI ỨNG DỤNG" />
                            <Border Classes="badge"
                                    Classes.running="{Binding IsReady}"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{Binding AppStateText}" />
                            </Border>
                            <TextBlock Text="{Binding AppStateDetail}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap"
                                       MaxLines="3" />
                        </StackPanel>
                    </Border>

                    <!-- Thiết bị -->
                    <StackPanel Grid.Row="1" Spacing="8">
                        <TextBlock Classes="label" FontSize="10" Text="THIẾT BỊ" Margin="2,0,0,0" />

                        <!-- Camera: viền + LED chớp khi mất kết nối -->
                        <Border Classes="deviceCard {Binding CameraCardClass}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Grid Width="11" Height="11">
                                    <Ellipse Classes="ledHalo"
                                             Classes.warn="{Binding !IsCameraConnected}"
                                             Classes.blink="{Binding IsCameraBlinking}" />
                                    <Ellipse Classes="led"
                                             Classes.on="{Binding IsCameraConnected}"
                                             Classes.warn="{Binding !IsCameraConnected}"
                                             Classes.blink="{Binding IsCameraBlinking}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="deviceTitle" Text="Camera RD" />
                                    <TextBlock Classes="deviceStatus" Text="{Binding CameraStatusText}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- PLC: viền + LED chớp khi mất kết nối -->
                        <Border Classes="deviceCard {Binding PlcCardClass}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Grid Width="11" Height="11">
                                    <Ellipse Classes="ledHalo"
                                             Classes.warn="{Binding !IsPlcConnected}"
                                             Classes.blink="{Binding IsPlcBlinking}" />
                                    <Ellipse Classes="led"
                                             Classes.on="{Binding IsPlcConnected}"
                                             Classes.warn="{Binding !IsPlcConnected}"
                                             Classes.blink="{Binding IsPlcBlinking}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="deviceTitle" Text="PLC Omron" />
                                    <TextBlock Classes="deviceStatus" Text="{Binding PlcStatusText}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Lối vào nhanh các tab -->
                    <StackPanel Grid.Row="2" Spacing="8" VerticalAlignment="Top">
                        <TextBlock Classes="label" FontSize="10" Text="MỤC LỤC" Margin="2,0,0,0" />

                        <Button Classes="chip"
                                HorizontalAlignment="Stretch"
                                FontSize="12"
                                HorizontalContentAlignment="Left"
                                Content="Thông tin"
                                Command="{Binding ShowInfoTabCommand}" />
                        <Button Classes="chip"
                                HorizontalAlignment="Stretch"
                                FontSize="12"
                                HorizontalContentAlignment="Left"
                                Content="Sản xuất"
                                Command="{Binding ShowProductionTabCommand}" />
                        <Button Classes="chip"
                                HorizontalAlignment="Stretch"
                                FontSize="12"
                                HorizontalContentAlignment="Left"
                                Content="Cấu hình"
                                Command="{Binding ShowConfigTabCommand}" />
                    </StackPanel>

                    <!-- Gợi ý: license quản lý qua nút "?" trên thanh trên cùng -->
                    <TextBlock Grid.Row="3"
                               Classes="label"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Text="Nhấn dấu ? ở góc trên bên phải để xem thông tin license." />
                </Grid>
            </Border>

            <!-- ===== Vùng nội dung tab ===== -->
            <Grid Grid.Column="1">
                <views:InfoView IsVisible="{Binding IsInfoVisible}" />
                <views:ProductionView IsVisible="{Binding IsProductionVisible}" />
                <views:ConfigView IsVisible="{Binding IsConfigVisible}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
