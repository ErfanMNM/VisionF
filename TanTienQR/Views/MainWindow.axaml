<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TanTienQR.ViewModels"
        xmlns:views="using:TanTienQR.Views"
        xmlns:controls="using:TanTienQR.Controls"
        xmlns:prim="using:Avalonia.Controls.Primitives"
        xmlns:d="http://schemas.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="TanTienQR.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/tantien-logo.ico"
        Title="TanTienQR · Quét mã - PLC Omron"
        Width="1360" Height="820"
        MinWidth="1100" MinHeight="700"
        CanResize="True"
        CanMinimize="True"
        CanMaximize="True"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <!-- Chỉ dùng cho trình xem trước trong IDE; DataContext lúc chạy được gán trong App.axaml.cs -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Viền accent trên cùng của custom chrome -->
        <Border Grid.Row="0" Height="3" Background="{StaticResource Accent}" />

        <!-- ===== Hàng 1: logo + đồng hồ + người dùng + nút cửa sổ ===== -->
        <Border Grid.Row="1" x:Name="HeaderBar"
                Background="{StaticResource BgPanel}"
                Padding="20,8"
                PointerPressed="OnHeaderPointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">

                <!-- Logo + tên app -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="36" Height="36"
                            CornerRadius="10"
                            Background="White"
                            BorderBrush="{StaticResource LineAccent}"
                            BorderThickness="1">
                        <Image Source="/Assets/tantien-logo-tt.png"
                               Stretch="Uniform"
                               Margin="2" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="TanTienQR"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="Quét mã · PLC"
                                   Classes="label"
                                   FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <!-- Trạng thái + đồng hồ + người dùng + nút cửa sổ -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">

                    <Border Classes="pill" Classes.ok="{Binding IsReady}" Classes.warn="{Binding !IsReady}"
                            MinWidth="96" Height="34" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppStateText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <Border Width="1" Height="34"
                            Background="{StaticResource LineColor}"
                            VerticalAlignment="Center" />

                    <!-- Đồng hồ + ngày -->
                    <StackPanel Spacing="0" MinWidth="124">
                        <TextBlock Classes="mono"
                                   Text="{Binding ClockText}"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right" />
                        <TextBlock Classes="label" FontSize="11" Text="{Binding DateText}" HorizontalAlignment="Right" />
                        <TextBlock Classes="label" FontSize="10" Text="{Binding AppVersionText}" HorizontalAlignment="Right" />
                    </StackPanel>

                    <!-- Người dùng đang đăng nhập + vai trò -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">
                        <Border Width="36" Height="36"
                                CornerRadius="18"
                                Background="#FEF3C7"
                                BorderBrush="#FCD34D"
                                BorderThickness="1">
                            <TextBlock Text="{Binding CurrentUserInitial}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#92400E"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="3" VerticalAlignment="Center" MaxWidth="150">
                            <TextBlock Text="{Binding CurrentUserDisplayName}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding CurrentUserDisplayName}" />
                            <Border Classes="badge"
                                    Classes.running="{Binding IsRoleOperator}"
                                    Classes.warning="{Binding IsRoleWorker}"
                                    Classes.accent="{Binding IsRoleAdministrator}"
                                    Classes.developer="{Binding IsRoleDeveloper}"
                                    HorizontalAlignment="Left"
                                    Padding="8,2"
                                    CornerRadius="8">
                                <TextBlock Text="{Binding CurrentRoleText}" FontSize="11" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Nút nguồn -->
                    <Button x:Name="PowerButton"
                            Width="44" Height="44"
                            MinWidth="0" MinHeight="0"
                            Padding="0"
                            CornerRadius="12"
                            Background="{StaticResource BgPanel}"
                            BorderBrush="#D2D7E0"
                            BorderThickness="1"
                            ToolTip.Tip="Nguồn"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Path Width="18" Height="18"
                              Stretch="Uniform"
                              Stroke="{StaticResource TextPrimary}"
                              StrokeThickness="2"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Data="{StaticResource Icon.Power}" />
                    </Button>

                    <!-- Nút ? mở nhanh thông tin license -->
                    <Button x:Name="LicenseInfoButton"
                            Width="44" Height="44"
                            MinWidth="0" MinHeight="0"
                            Padding="0"
                            CornerRadius="12"
                            Background="{StaticResource BgPanel}"
                            BorderBrush="#D2D7E0"
                            BorderThickness="1"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextPrimary}"
                            Content="?"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Thông tin license"
                            Command="{Binding ToggleLicensePanelCommand}" />

                    <!-- Menu cửa sổ (custom chrome): gộp thu nhỏ / phóng to / tắt vào 1 nút -->
                    <Button x:Name="WindowMenuButton"
                            Width="44" Height="44"
                            MinWidth="0" MinHeight="0"
                            Padding="0"
                            CornerRadius="12"
                            Background="{StaticResource BgPanel}"
                            BorderBrush="#D2D7E0"
                            BorderThickness="1"
                            ToolTip.Tip="Tùy chọn cửa sổ"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Click="OnWindowMenuClick">
                        <Path Width="18" Height="18"
                              Stretch="Uniform"
                              Stroke="{StaticResource TextPrimary}"
                              StrokeThickness="2"
                              StrokeLineCap="Round"
                              Data="{StaticResource Icon.Menu}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Hàng 2: thanh điều hướng (tab gạch chân) ===== -->
        <Border Grid.Row="2"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource LineColor}"
                BorderThickness="0,0,0,1"
                Padding="20,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="tabbar"
                            Classes.active="{Binding IsInfoVisible}"
                            Command="{Binding ShowInfoTabCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Classes="icon" Width="16" Height="16" Stretch="Uniform"
                                  Data="{StaticResource Icon.Grid}" />
                            <TextBlock Text="Thông tin" />
                        </StackPanel>
                    </Button>

                    <Button Classes="tabbar"
                            Classes.active="{Binding IsProductionVisible}"
                            Command="{Binding ShowProductionTabCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Classes="icon" Width="16" Height="16" Stretch="Uniform"
                                  Data="{StaticResource Icon.Chart}" />
                            <TextBlock Text="Sản xuất" />
                        </StackPanel>
                    </Button>

                    <Button Classes="tabbar"
                            Classes.active="{Binding IsConfigVisible}"
                            Command="{Binding ShowConfigTabCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Classes="icon" Width="16" Height="16" Stretch="Uniform"
                                  Data="{StaticResource Icon.Sliders}" />
                            <TextBlock Text="Cấu hình" />
                        </StackPanel>
                    </Button>

                    <Button Classes="tabbar"
                            Classes.active="{Binding IsPlcSettingsVisible}"
                            IsVisible="{Binding CanEditPlc}"
                            Command="{Binding ShowPlcSettingsTabCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Classes="icon" Width="16" Height="16" Stretch="Uniform"
                                  Data="{StaticResource Icon.Cpu}" />
                            <TextBlock Text="Chỉnh PLC" />
                        </StackPanel>
                    </Button>

                    <Button Classes="tabbar"
                            Classes.active="{Binding IsHistoryVisible}"
                            IsVisible="{Binding CanViewHistory}"
                            Command="{Binding ShowHistoryTabCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Classes="icon" Width="16" Height="16" Stretch="Uniform"
                                  Data="{StaticResource Icon.Bars}" />
                            <TextBlock Text="Lịch sử" />
                        </StackPanel>
                    </Button>

                    <!-- Truy xuất sản xuất (Local): mọi vai trò xem được -->
                    <Button Classes="tabbar"
                            Classes.active="{Binding IsProductionOrdersVisible}"
                            IsVisible="{Binding CanViewProduction}"
                            Command="{Binding ShowProductionOrdersTabCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Classes="icon" Width="16" Height="16" Stretch="Uniform"
                                  Data="{StaticResource Icon.Clipboard}" />
                            <TextBlock Text="Truy xuất SX" />
                        </StackPanel>
                    </Button>

                    <!-- Tra cứu mã: mọi vai trò đều xem được -->
                    <Button Classes="tabbar"
                            Classes.active="{Binding IsCodeLookupVisible}"
                            Command="{Binding ShowCodeLookupTabCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Classes="icon" Width="16" Height="16" Stretch="Uniform"
                                  Data="{StaticResource Icon.Search}" />
                            <TextBlock Text="Tra cứu mã" />
                        </StackPanel>
                    </Button>

                    <Button Classes="tabbar"
                            Classes.active="{Binding IsAccountsVisible}"
                            IsVisible="{Binding CanManageUsers}"
                            Command="{Binding ShowAccountsTabCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Classes="icon" Width="16" Height="16" Stretch="Uniform"
                                  Data="{StaticResource Icon.User}" />
                            <TextBlock Text="Tài khoản" />
                        </StackPanel>
                    </Button>

                    <!-- Dev: chỉ Lập trình viên -->
                    <Button Classes="tabbar"
                            Classes.active="{Binding IsDevVisible}"
                            IsVisible="{Binding CanViewDev}"
                            Command="{Binding ShowDevTabCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Classes="icon" Width="16" Height="16" Stretch="Uniform"
                                  Data="{StaticResource Icon.File}" />
                            <TextBlock Text="Dev" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Lớp overlay: 2 popup (menu cửa sổ + hộp thoại license).
             Đặt trong Grid riêng để không ảnh hưởng flow của layout chính. -->
        <Grid Grid.Row="0">
                <!-- Menu cửa sổ thả xuống (overlay, popup tự vẽ đồng bộ với app) -->
                <Popup x:Name="WindowMenuPopup"
                       PlacementTarget="{Binding #WindowMenuButton}"
                       Placement="BottomEdgeAlignedRight"
                       VerticalOffset="8"
                       IsLightDismissEnabled="True"
                       Topmost="True">
                    <Border Width="250"
                            Padding="8"
                            CornerRadius="14"
                            Background="{StaticResource BgPanel}"
                            BorderBrush="{StaticResource LineColor}"
                            BorderThickness="1"
                            BoxShadow="0 12 32 0 #33000000">
                        <StackPanel Spacing="2">
                            <TextBlock Text="CỬA SỔ"
                                       Classes="label"
                                       FontSize="10"
                                       Margin="12,6,0,4" />
                            <Button Classes="menubtn" Click="OnMinimizeClick">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="30" Height="30" CornerRadius="9"
                                            Background="{StaticResource BgRaised}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="–" FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="0" VerticalAlignment="Center">
                                        <TextBlock Text="Thu nhỏ" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Ẩn xuống thanh tác vụ" FontSize="10" Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Classes="menubtn" Click="OnMaxRestoreClick">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="30" Height="30" CornerRadius="9"
                                            Background="{StaticResource BgRaised}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="▢" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="0" VerticalAlignment="Center">
                                        <TextBlock Text="Phóng to / khôi phục" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Chuyển chế độ toàn màn hình" FontSize="10" Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <!-- ===== Toàn màn hình (F11) =====
                                 App mở ra đã ở chế độ toàn màn hình thật.
                                 Nút này + phím F11 / Esc là đường thoát cho
                                 người dùng (không bị kẹt ở chế độ kiosk). -->
                            <Button Classes="menubtn" Click="OnFullScreenClick">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="30" Height="30" CornerRadius="9"
                                            Background="{StaticResource BgRaised}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="⛶" FontSize="13" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="0" VerticalAlignment="Center">
                                        <TextBlock Text="Toàn màn hình" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Phím F11 / Esc để thoát" FontSize="10" Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Border Height="1" Margin="12,6"
                                    Background="{StaticResource LineColor}" />
                            <Button Classes="menubtn danger" Click="OnShutdownClick">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="30" Height="30" CornerRadius="9"
                                            Background="{StaticResource DangerSoft}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="✕" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource Danger}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="0" VerticalAlignment="Center">
                                        <TextBlock Text="Tắt ứng dụng" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Đóng và dừng worker" FontSize="10" Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Hộp thoại license thu gọn (overlay, không chiếm layout) -->
                <Popup PlacementTarget="{Binding #LicenseInfoButton}"
                       Placement="BottomEdgeAlignedRight"
                       VerticalOffset="10"
                       IsOpen="{Binding IsLicensePanelOpen, Mode=TwoWay}"
                       IsLightDismissEnabled="True"
                       Topmost="True">
                    <Border Width="300"
                            Padding="16"
                            CornerRadius="14"
                            Background="{StaticResource BgPanel}"
                            BorderBrush="{StaticResource LineColor}"
                            BorderThickness="1"
                            BoxShadow="0 12 32 0 #33000000">
                        <StackPanel Spacing="12">
                            <!-- Tiêu đề + nút đóng -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border Width="32" Height="32"
                                        CornerRadius="10"
                                        Background="{StaticResource AccentSoft}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="◈"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource Accent}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="Giấy phép sử dụng"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="Trạng thái bản quyền phần mềm"
                                               FontSize="10"
                                               Foreground="{StaticResource TextMuted}" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Width="28" Height="28"
                                        CornerRadius="14"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Foreground="{StaticResource TextMuted}"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Content="✕"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Đóng"
                                        Command="{Binding ToggleLicensePanelCommand}" />
                            </Grid>

                            <!-- Trạng thái + thời hạn -->
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Classes="badge"
                                        Classes.running="{Binding IsLicenseRunning}"
                                        Classes.warning="{Binding IsLicenseWarning}"
                                        Classes.fault="{Binding IsLicenseFault}">
                                    <TextBlock Text="{Binding LicenseStatusText}" />
                                </Border>
                                <TextBlock FontSize="11"
                                           Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center"
                                           Text="{Binding LicenseDaysLeftText}" />
                            </StackPanel>

                            <!-- Thông tin chi tiết -->
                            <Border Classes="device" Padding="12">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                    <Grid ColumnDefinitions="86,*" ColumnSpacing="10">
                                        <TextBlock Classes="label" FontSize="10" Text="KHÁCH HÀNG" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding LicenseCustomerText}"
                                                   Text="{Binding LicenseCustomerText}" />
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnDefinitions="86,*" ColumnSpacing="10">
                                        <TextBlock Classes="label" FontSize="10" Text="HẾT HẠN" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Classes="mono" FontSize="12"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   Text="{Binding LicenseExpiryText}" />
                                    </Grid>
                                    <Grid Grid.Row="2" ColumnDefinitions="86,*" ColumnSpacing="10">
                                        <TextBlock Classes="label" FontSize="10" Text="MÃ MÁY" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" Classes="mono" FontSize="10"
                                                   Foreground="{StaticResource TextMuted}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding HwidText}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Cảnh báo khi license lỗi -->
                            <Border Padding="10"
                                    CornerRadius="9"
                                    Background="{StaticResource DangerSoft}"
                                    BorderBrush="{StaticResource Danger}"
                                    BorderThickness="1"
                                    IsVisible="{Binding !IsLicenseValid}">
                                <TextBlock Text="{Binding LicenseMessageText}"
                                           FontSize="11"
                                           Foreground="{StaticResource Danger}"
                                           TextWrapping="Wrap"
                                           MaxLines="3"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>

                            <!-- Hành động -->
                            <Button HorizontalAlignment="Stretch"
                                    MinHeight="40"
                                    CornerRadius="10"
                                    Background="{StaticResource Accent}"
                                    BorderBrush="{StaticResource Accent}"
                                    BorderThickness="1"
                                    Foreground="White"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Content="Quản lý license..."
                                    Command="{Binding ShowLicenseWindowCommand}" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

        <!-- ===== Nội dung: sidebar + vùng tab ===== -->
        <Grid Grid.Row="3" ColumnDefinitions="232,*">

            <!-- ===== Sidebar ===== -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource LineColor}"
                    BorderThickness="0,0,1,0"
                    Padding="16,18">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">

                    <!-- Trạng thái app -->
                    <Border Grid.Row="0" Classes="device" Padding="14,16">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="overline" Text="TRẠNG THÁI ỨNG DỤNG" />
                            <Border Classes="badge"
                                    Classes.running="{Binding IsReady}"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{Binding AppStateText}" />
                            </Border>
                            <TextBlock Text="{Binding AppStateDetail}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextPrimary}"
                                       TextWrapping="Wrap"
                                       MaxLines="3" />
                        </StackPanel>
                    </Border>

                    <!-- Thiết bị -->
                    <StackPanel Grid.Row="1" Spacing="12">
                        <TextBlock Classes="overline" Text="THIẾT BỊ" Margin="2,0,0,0" />

                        <!-- Camera: viền + LED chớp khi mất kết nối -->
                        <Border Classes="deviceCard {Binding CameraCardClass}" Padding="12,16">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Grid Width="10" Height="10" VerticalAlignment="Center">
                                    <Ellipse Classes="ledHalo"
                                             Classes.warn="{Binding !IsCameraConnected}"
                                             Classes.blink="{Binding IsCameraBlinking}" />
                                    <Ellipse Classes="led"
                                             Classes.on="{Binding IsCameraConnected}"
                                             Classes.warn="{Binding !IsCameraConnected}"
                                             Classes.blink="{Binding IsCameraBlinking}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="deviceTitle" Text="Camera RD" />
                                    <TextBlock Classes="deviceStatus" Text="{Binding CameraStatusText}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- PLC: viền + LED chớp khi mất kết nối -->
                        <Border Classes="deviceCard {Binding PlcCardClass}" Padding="12,16">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Grid Width="10" Height="10" VerticalAlignment="Center">
                                    <Ellipse Classes="ledHalo"
                                             Classes.warn="{Binding !IsPlcConnected}"
                                             Classes.blink="{Binding IsPlcBlinking}" />
                                    <Ellipse Classes="led"
                                             Classes.on="{Binding IsPlcConnected}"
                                             Classes.warn="{Binding !IsPlcConnected}"
                                             Classes.blink="{Binding IsPlcBlinking}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="deviceTitle" Text="PLC Omron" />
                                    <TextBlock Classes="deviceStatus" Text="{Binding PlcStatusText}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Gợi ý: license quản lý qua nút "?" trên thanh trên cùng -->
                    <TextBlock Grid.Row="2"
                               VerticalAlignment="Bottom"
                               Classes="label"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Text="Nhấn dấu ? ở góc trên bên phải để xem thông tin license." />
                </Grid>
            </Border>

            <!-- ===== Vùng nội dung tab ===== -->
            <Grid Grid.Column="1">
                <views:InfoView IsVisible="{Binding IsInfoVisible}" />
                <views:ProductionView IsVisible="{Binding IsProductionVisible}" />
                <views:ConfigView IsVisible="{Binding IsConfigVisible}" />
                <views:HistoryView IsVisible="{Binding IsHistoryVisible}" />
                <views:AccountsView IsVisible="{Binding IsAccountsVisible}" />
                <views:PlcSettingsView IsVisible="{Binding IsPlcSettingsVisible}" />
                <views:DevView IsVisible="{Binding IsDevVisible}" />
                <views:CodeLookupView IsVisible="{Binding IsCodeLookupVisible}" />
                <views:ProductionOrdersView IsVisible="{Binding IsProductionOrdersVisible}" />
            </Grid>
        </Grid>

        <!-- ===== Bàn phím ảo (máy cảm ứng) =====
             Hiện ở đáy cửa sổ khi người dùng chạm vào một ô nhập.
             Nằm ở HÀNG RIÊNG (Grid.Row="3") -> bàn phím "đẩy" nội dung
             tab lên thay vì phủ lên, để ô nhập gốc luôn nhìn thấy.

             Control tự quản lý IsVisible: chỉ cửa sổ đang sở hữu ô nhập
             mới hiện bàn phím. Khi ẩn, hàng này co về 0 và nội dung lấy
             lại toàn bộ chỗ. -->
        <controls:VirtualKeyboard Grid.Row="4"
                                 DataContext="{Binding Keyboard}" />
    </Grid>
</Window>
