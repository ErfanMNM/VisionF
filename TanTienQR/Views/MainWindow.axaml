<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TanTienQR.ViewModels"
        xmlns:views="using:TanTienQR.Views"
        xmlns:controls="using:TanTienQR.Controls"
        xmlns:prim="using:Avalonia.Controls.Primitives"
        xmlns:d="http://schemas.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="TanTienQR.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/tantien-logo.ico"
        Title="TanTienQR · Quét mã - PLC Omron"
        Width="1360" Height="820"
        MinWidth="1100" MinHeight="700"
        CanResize="True"
        CanMinimize="True"
        CanMaximize="True"
        WindowDecorations="None"
        WindowState="FullScreen"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="Border.deviceCard.printerDisabled">
            <Setter Property="Background" Value="#EEF0F3" />
            <Setter Property="BorderBrush" Value="#D3D8DF" />
        </Style>
        <Style Selector="Border.deviceCard.printerDisabled TextBlock.deviceTitle">
            <Setter Property="Foreground" Value="#7B8490" />
        </Style>
        <Style Selector="Border.deviceCard.printerDisabled TextBlock.deviceStatus">
            <Setter Property="Foreground" Value="#7B8490" />
        </Style>
        <Style Selector="Border.deviceCard.printerDisabled Ellipse.led">
            <Setter Property="Fill" Value="#9CA3AF" />
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <!-- Chỉ dùng cho trình xem trước trong IDE; DataContext lúc chạy được gán trong App.axaml.cs -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Viền accent trên cùng của custom chrome -->
        <Border Grid.Row="0" Height="3" Background="{StaticResource Accent}" />

        <!-- ===== Hàng 1: logo + đồng hồ + người dùng + nút cửa sổ ===== -->
        <Border Grid.Row="1" x:Name="HeaderBar"
                Background="{StaticResource BgPanel}"
                Padding="20,8"
                PointerPressed="OnHeaderPointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">

                <!-- Logo + tên app -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="36" Height="36"
                            CornerRadius="10"
                            Background="White"
                            BorderBrush="{StaticResource LineAccent}"
                            BorderThickness="1">
                        <Image Source="/Assets/tantien-logo-tt.png"
                               Stretch="Uniform"
                               Margin="2" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="TanTienQR"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="Quét mã · PLC"
                                   Classes="label"
                                   FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <!-- Trạng thái + đồng hồ + người dùng + nút cửa sổ -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">

                    <Border Classes="pill" Classes.ok="{Binding IsReady}" Classes.warn="{Binding !IsReady}"
                            MinWidth="96" Height="34" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppStateText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <Border Width="1" Height="34"
                            Background="{StaticResource LineColor}"
                            VerticalAlignment="Center" />

                    <!-- Đồng hồ + ngày -->
                    <StackPanel Spacing="0" MinWidth="124">
                        <TextBlock Classes="mono"
                                   Text="{Binding ClockText}"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right" />
                        <TextBlock Classes="label" FontSize="11" Text="{Binding DateText}" HorizontalAlignment="Right" />
                        <TextBlock Classes="label" FontSize="10" Text="{Binding AppVersionText}" HorizontalAlignment="Right" />
                    </StackPanel>

                    <!-- Người dùng đang đăng nhập + vai trò -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">
                        <Border Width="36" Height="36"
                                CornerRadius="18"
                                Background="#FEF3C7"
                                BorderBrush="#FCD34D"
                                BorderThickness="1">
                            <TextBlock Text="{Binding CurrentUserInitial}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#92400E"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="3" VerticalAlignment="Center" MaxWidth="150">
                            <TextBlock Text="{Binding CurrentUserDisplayName}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding CurrentUserDisplayName}" />
                            <Border Classes="badge"
                                    Classes.running="{Binding IsRoleOperator}"
                                    Classes.warning="{Binding IsRoleWorker}"
                                    Classes.accent="{Binding IsRoleAdministrator}"
                                    Classes.developer="{Binding IsRoleDeveloper}"
                                    HorizontalAlignment="Left"
                                    Padding="8,2"
                                    CornerRadius="8">
                                <TextBlock Text="{Binding CurrentRoleText}" FontSize="11" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Nút nguồn -->
                    <Button x:Name="PowerButton"
                            Width="44" Height="44"
                            MinWidth="0" MinHeight="0"
                            Padding="0"
                            CornerRadius="12"
                            Background="{StaticResource BgPanel}"
                            BorderBrush="#D2D7E0"
                            BorderThickness="1"
                            ToolTip.Tip="Nguồn"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Path Width="18" Height="18"
                              Stretch="Uniform"
                              Stroke="{StaticResource TextPrimary}"
                              StrokeThickness="2"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Data="{StaticResource Icon.Power}" />
                    </Button>

                    <!-- Nút ? mở nhanh tab Giới thiệu (license + cập nhật) -->
                    <Button x:Name="AboutButton"
                            Width="44" Height="44"
                            MinWidth="0" MinHeight="0"
                            Padding="0"
                            CornerRadius="12"
                            Background="{StaticResource BgPanel}"
                            BorderBrush="#D2D7E0"
                            BorderThickness="1"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextPrimary}"
                            Content="?"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Giới thiệu · License &amp; cập nhật"
                            Command="{Binding ShowAboutTabCommand}" />

                    <!-- Menu cửa sổ (custom chrome): gộp thu nhỏ / phóng to / tắt vào 1 nút -->
                    <Button x:Name="WindowMenuButton"
                            Width="44" Height="44"
                            MinWidth="0" MinHeight="0"
                            Padding="0"
                            CornerRadius="12"
                            Background="{StaticResource BgPanel}"
                            BorderBrush="#D2D7E0"
                            BorderThickness="1"
                            ToolTip.Tip="Tùy chọn cửa sổ"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Click="OnWindowMenuClick">
                        <Path Width="18" Height="18"
                              Stretch="Uniform"
                              Stroke="{StaticResource TextPrimary}"
                              StrokeThickness="2"
                              StrokeLineCap="Round"
                              Data="{StaticResource Icon.Menu}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Hàng 2: thanh điều hướng (tab gạch chân) ===== -->
        <Border Grid.Row="2"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource LineColor}"
                BorderThickness="0,0,0,1"
                Padding="20,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="tabbar"
                            Classes.active="{Binding IsInfoVisible}"
                            Command="{Binding ShowInfoTabCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Classes="icon" Width="16" Height="16" Stretch="Uniform"
                                  Data="{StaticResource Icon.Grid}" />
                            <TextBlock Text="Thông tin" />
                        </StackPanel>
                    </Button>

                    <Button Classes="tabbar"
                            Classes.active="{Binding IsProductionVisible}"
                            Command="{Binding ShowProductionTabCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Classes="icon" Width="16" Height="16" Stretch="Uniform"
                                  Data="{StaticResource Icon.Chart}" />
                            <TextBlock Text="Sản xuất" />
                        </StackPanel>
                    </Button>

                    <Button Classes="tabbar"
                            Classes.active="{Binding IsPlcSettingsVisible}"
                            IsVisible="{Binding CanEditPlc}"
                            Command="{Binding ShowPlcSettingsTabCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Classes="icon" Width="16" Height="16" Stretch="Uniform"
                                  Data="{StaticResource Icon.Cpu}" />
                            <TextBlock Text="Chỉnh PLC" />
                        </StackPanel>
                    </Button>

                    <!-- Mục "Thêm": gom các tab ít dùng vào menu xổ xuống -->
                    <Button x:Name="MoreMenuButton"
                            Classes="tabbar"
                            Classes.active="{Binding IsMoreActive}"
                            Click="OnMoreMenuClick">
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Classes="icon" Width="16" Height="16" Stretch="Uniform"
                                  Data="{StaticResource Icon.Menu}" />
                            <TextBlock Text="Thêm" />
                            <TextBlock Text="▾" FontSize="11" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Lớp overlay: 2 popup (menu cửa sổ + hộp thoại license).
             Đặt trong Grid riêng để không ảnh hưởng flow của layout chính. -->
        <Grid Grid.Row="0">
                <!-- Menu cửa sổ thả xuống (overlay, popup tự vẽ đồng bộ với app) -->
                <Popup x:Name="WindowMenuPopup"
                       PlacementTarget="{Binding #WindowMenuButton}"
                       Placement="BottomEdgeAlignedRight"
                       VerticalOffset="8"
                       IsLightDismissEnabled="True"
                       Topmost="True">
                    <Border Width="250"
                            Padding="8"
                            CornerRadius="14"
                            Background="{StaticResource BgPanel}"
                            BorderBrush="{StaticResource LineColor}"
                            BorderThickness="1"
                            BoxShadow="0 12 32 0 #33000000">
                        <StackPanel Spacing="2">
                            <TextBlock Text="CỬA SỔ"
                                       Classes="label"
                                       FontSize="10"
                                       Margin="12,6,0,4" />
                            <Button Classes="menubtn" Click="OnMinimizeClick">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="30" Height="30" CornerRadius="9"
                                            Background="{StaticResource BgRaised}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="–" FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="0" VerticalAlignment="Center">
                                        <TextBlock Text="Thu nhỏ" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Ẩn xuống thanh tác vụ" FontSize="10" Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Classes="menubtn" Click="OnMaxRestoreClick">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="30" Height="30" CornerRadius="9"
                                            Background="{StaticResource BgRaised}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="▢" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="0" VerticalAlignment="Center">
                                        <TextBlock Text="Phóng to / khôi phục" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Chuyển chế độ toàn màn hình" FontSize="10" Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <!-- ===== Toàn màn hình (F11) =====
                                 App mở ra đã ở chế độ toàn màn hình thật.
                                 Nút này + phím F11 / Esc là đường thoát cho
                                 người dùng (không bị kẹt ở chế độ kiosk). -->
                            <Button Classes="menubtn" Click="OnFullScreenClick">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="30" Height="30" CornerRadius="9"
                                            Background="{StaticResource BgRaised}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="⛶" FontSize="13" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="0" VerticalAlignment="Center">
                                        <TextBlock Text="Toàn màn hình" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Phím F11 / Esc để thoát" FontSize="10" Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Border Height="1" Margin="12,6"
                                    Background="{StaticResource LineColor}" />
                            <Button Classes="menubtn danger" Click="OnShutdownClick">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="30" Height="30" CornerRadius="9"
                                            Background="{StaticResource DangerSoft}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="✕" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource Danger}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="0" VerticalAlignment="Center">
                                        <TextBlock Text="Tắt ứng dụng" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Đóng và dừng worker" FontSize="10" Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Menu "Thêm" (overlay): các tab ít dùng -->
                <Popup x:Name="MoreMenuPopup"
                       PlacementTarget="{Binding #MoreMenuButton}"
                       Placement="BottomEdgeAlignedLeft"
                       IsLightDismissEnabled="True"
                       Topmost="True">
                    <Border Width="220"
                            Padding="8"
                            CornerRadius="14"
                            Background="{StaticResource BgPanel}"
                            BorderBrush="{StaticResource LineColor}"
                            BorderThickness="1"
                            BoxShadow="0 12 32 0 #33000000">
                        <StackPanel Spacing="2">
                            <Button Classes="menubtn"
                                    Classes.active="{Binding IsConfigVisible}"
                            IsVisible="{Binding CanEditConfig}"
                                    Command="{Binding ShowConfigTabCommand}"
                                    Click="OnMoreItemClick">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{StaticResource TextMuted}" StrokeThickness="1.9"
                                          StrokeLineCap="Round" StrokeJoin="Round"
                                          VerticalAlignment="Center"
                                          Data="{StaticResource Icon.Sliders}" />
                                    <TextBlock Text="Cấu hình" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="menubtn"
                                    Classes.active="{Binding IsSettingsV2Visible}"
                                    IsVisible="{Binding CanEditConfig}"
                                    Command="{Binding ShowSettingsV2TabCommand}"
                                    Click="OnMoreItemClick">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{StaticResource TextMuted}" StrokeThickness="1.9"
                                          StrokeLineCap="Round" StrokeJoin="Round"
                                          VerticalAlignment="Center" Data="{StaticResource Icon.CpuChip}" />
                                    <TextBlock Text="Cài đặt V2" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="menubtn"
                                    Classes.active="{Binding IsHistoryVisible}"
                            IsVisible="{Binding CanViewHistory}"
                                    Command="{Binding ShowHistoryTabCommand}"
                                    Click="OnMoreItemClick">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{StaticResource TextMuted}" StrokeThickness="1.9"
                                          StrokeLineCap="Round" StrokeJoin="Round"
                                          VerticalAlignment="Center"
                                          Data="{StaticResource Icon.Bars}" />
                                    <TextBlock Text="Lịch sử" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="menubtn"
                                    Classes.active="{Binding IsProductionOrdersVisible}"
                            IsVisible="{Binding CanViewProduction}"
                                    Command="{Binding ShowProductionOrdersTabCommand}"
                                    Click="OnMoreItemClick">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{StaticResource TextMuted}" StrokeThickness="1.9"
                                          StrokeLineCap="Round" StrokeJoin="Round"
                                          VerticalAlignment="Center"
                                          Data="{StaticResource Icon.Clipboard}" />
                                    <TextBlock Text="Truy xuất SX" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="menubtn"
                                    Classes.active="{Binding IsCodeLookupVisible}"
                                    Command="{Binding ShowCodeLookupTabCommand}"
                                    Click="OnMoreItemClick">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{StaticResource TextMuted}" StrokeThickness="1.9"
                                          StrokeLineCap="Round" StrokeJoin="Round"
                                          VerticalAlignment="Center"
                                          Data="{StaticResource Icon.Search}" />
                                    <TextBlock Text="Tra cứu mã" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="menubtn"
                                    Classes.active="{Binding IsManualActivationVisible}"
                                    Command="{Binding ShowManualActivationTabCommand}"
                                    Click="OnMoreItemClick">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{StaticResource TextMuted}" StrokeThickness="1.9"
                                          StrokeLineCap="Round" StrokeJoin="Round"
                                          VerticalAlignment="Center" Data="{StaticResource Icon.Clipboard}" />
                                    <TextBlock Text="Thêm mã" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="menubtn"
                                    Classes.active="{Binding IsPrintVisible}"
                                    Command="{Binding ShowPrintTabCommand}"
                                    Click="OnMoreItemClick">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Width="16" Text="▣" FontSize="15" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                    <TextBlock Text="Máy in" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="menubtn"
                                    Classes.active="{Binding IsAccountsVisible}"
                            IsVisible="{Binding CanManageUsers}"
                                    Command="{Binding ShowAccountsTabCommand}"
                                    Click="OnMoreItemClick">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{StaticResource TextMuted}" StrokeThickness="1.9"
                                          StrokeLineCap="Round" StrokeJoin="Round"
                                          VerticalAlignment="Center"
                                          Data="{StaticResource Icon.User}" />
                                    <TextBlock Text="Tài khoản" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="menubtn"
                                    Classes.active="{Binding IsDevVisible}"
                            IsVisible="{Binding CanViewDev}"
                                    Command="{Binding ShowDevTabCommand}"
                                    Click="OnMoreItemClick">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{StaticResource TextMuted}" StrokeThickness="1.9"
                                          StrokeLineCap="Round" StrokeJoin="Round"
                                          VerticalAlignment="Center"
                                          Data="{StaticResource Icon.File}" />
                                    <TextBlock Text="Dev" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="menubtn"
                                    Classes.active="{Binding IsMultiConnectVisible}"
                                    Command="{Binding ShowMultiConnectTabCommand}"
                                    Click="OnMoreItemClick">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{StaticResource TextMuted}" StrokeThickness="1.9"
                                          StrokeLineCap="Round" StrokeJoin="Round"
                                          VerticalAlignment="Center"
                                          Data="{StaticResource Icon.Link}" />
                                    <TextBlock Text="MultiConnect" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border Height="1" Margin="12,6"
                                    Background="{StaticResource LineColor}" />
                            <Button Classes="menubtn"
                                    Classes.active="{Binding IsAboutVisible}"
                                    Command="{Binding ShowAboutTabCommand}"
                                    Click="OnMoreItemClick">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{StaticResource TextMuted}" StrokeThickness="1.9"
                                          StrokeLineCap="Round" StrokeJoin="Round"
                                          VerticalAlignment="Center"
                                          Data="{StaticResource Icon.InfoCircle}" />
                                    <TextBlock Text="Giới thiệu" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>

            </Grid>

        <!-- ===== Nội dung: sidebar + vùng tab ===== -->
        <Grid Grid.Row="3" ColumnDefinitions="232,*">

            <!-- ===== Sidebar ===== -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource LineColor}"
                    BorderThickness="0,0,1,0"
                    Padding="16,18">
                <ScrollViewer x:Name="DeviceSidebarScroll"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16"
                      MinHeight="{Binding #DeviceSidebarScroll.Viewport.Height}">

                    <!-- Trạng thái app -->
                    <Border Grid.Row="0" Classes="device" Padding="14,16">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="overline" Text="TRẠNG THÁI ỨNG DỤNG" />
                            <Border Classes="badge"
                                    Classes.running="{Binding IsReady}"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{Binding AppStateText}" />
                            </Border>
                            <TextBlock Text="{Binding AppStateDetail}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextPrimary}"
                                       TextWrapping="Wrap"
                                       MaxLines="3" />
                        </StackPanel>
                    </Border>

                    <!-- Thiết bị -->
                    <StackPanel Grid.Row="1" Spacing="12">
                        <TextBlock Classes="overline" Text="THIẾT BỊ" Margin="2,0,0,0" />

                        <!-- Camera: viền + LED chớp khi mất kết nối -->
                        <Border Classes="deviceCard {Binding CameraCardClass}" Padding="12,16">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Grid Width="10" Height="10" VerticalAlignment="Center">
                                    <Ellipse Classes="ledHalo"
                                             Classes.warn="{Binding !IsCameraConnected}"
                                             Classes.blink="{Binding IsCameraBlinking}" />
                                    <Ellipse Classes="led"
                                             Classes.on="{Binding IsCameraConnected}"
                                             Classes.warn="{Binding !IsCameraConnected}"
                                             Classes.blink="{Binding IsCameraBlinking}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="deviceTitle" Text="Camera RD" />
                                    <TextBlock Classes="deviceStatus" Text="{Binding CameraStatusText}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- PLC: viền + LED chớp khi mất kết nối -->
                        <Border Classes="deviceCard {Binding PlcCardClass}" Padding="12,16">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Grid Width="10" Height="10" VerticalAlignment="Center">
                                    <Ellipse Classes="ledHalo"
                                             Classes.warn="{Binding !IsPlcConnected}"
                                             Classes.blink="{Binding IsPlcBlinking}" />
                                    <Ellipse Classes="led"
                                             Classes.on="{Binding IsPlcConnected}"
                                             Classes.warn="{Binding !IsPlcConnected}"
                                             Classes.blink="{Binding IsPlcBlinking}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="deviceTitle" Text="PLC Omron" />
                                    <TextBlock Classes="deviceStatus" Text="{Binding PlcStatusText}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Module máy in tắt: toàn bộ card xám, không cảnh báo kết nối. -->
                        <Border x:Name="PrinterStatusCard"
                                Classes="deviceCard {Binding Print.PrinterCardClass}"
                                Classes.printerDisabled="{Binding Print.IsPrinterDisabled}"
                                Padding="12,16">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Grid Width="10" Height="10" VerticalAlignment="Center">
                                    <Ellipse Classes="ledHalo"
                                             IsVisible="{Binding !Print.IsPrinterDisabled}"
                                             Classes.warn="{Binding Print.IsPrinterWarning}"
                                             Classes.blink="{Binding Print.IsPrinterBlinking}" />
                                    <Ellipse Classes="led"
                                             Classes.on="{Binding Print.IsPrinterConnected}"
                                             Classes.warn="{Binding Print.IsPrinterWarning}"
                                             Classes.blink="{Binding Print.IsPrinterBlinking}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="deviceTitle" Text="Máy in G10" />
                                    <TextBlock Classes="deviceStatus" Text="{Binding Print.ConnectionText}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <views:InternetStatusCard x:Name="InternetStatusCard"
                                                  DataContext="{Binding Internet}" />
                    </StackPanel>

                    <!-- Gợi ý: license và cập nhật nằm trong tab Giới thiệu -->
                    <TextBlock Grid.Row="2"
                               VerticalAlignment="Bottom"
                               Classes="label"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Text="Mở tab Giới thiệu (dấu ? hoặc menu Thêm) để xem license và cập nhật phần mềm." />
                </Grid>
                </ScrollViewer>
            </Border>

            <!-- ===== Vùng nội dung tab =====
                 Lazy: mỗi tab là 1 LazyTabHost, chỉ dựng view khi người
                 dùng mở tab lần đầu (sau đó cache lại). Nhờ vậy frame đầu
                 tiên chỉ phải dựng InfoView, không dựng sẵn 9 view + 2
                 WebView2 như trước. -->
            <Grid Grid.Column="1">
                <views:LazyTabHost x:Name="InfoTab"
                                   IsVisible="{Binding IsInfoVisible}"
                                   Factory="{x:Static views:LazyTabFactories.Info}" />
                <views:LazyTabHost x:Name="ProductionTab"
                                   IsVisible="{Binding IsProductionVisible}"
                                   Factory="{x:Static views:LazyTabFactories.Production}" />
                <views:LazyTabHost x:Name="ConfigTab"
                                   IsVisible="{Binding IsConfigVisible}"
                                   Factory="{x:Static views:LazyTabFactories.Config}" />
                <views:LazyTabHost x:Name="SettingsV2Tab"
                                   IsVisible="{Binding IsSettingsV2Visible}"
                                   Factory="{x:Static views:LazyTabFactories.SettingsV2}" />
                <views:LazyTabHost x:Name="HistoryTab"
                                   IsVisible="{Binding IsHistoryVisible}"
                                   Factory="{x:Static views:LazyTabFactories.History}" />
                <views:LazyTabHost x:Name="AccountsTab"
                                   IsVisible="{Binding IsAccountsVisible}"
                                   Factory="{x:Static views:LazyTabFactories.Accounts}" />
                <views:LazyTabHost x:Name="PlcSettingsTab"
                                   IsVisible="{Binding IsPlcSettingsVisible}"
                                   Factory="{x:Static views:LazyTabFactories.PlcSettings}" />
                <views:LazyTabHost x:Name="DevTab"
                                   IsVisible="{Binding IsDevVisible}"
                                   Factory="{x:Static views:LazyTabFactories.Dev}" />
                <views:LazyTabHost x:Name="CodeLookupTab"
                                   IsVisible="{Binding IsCodeLookupVisible}"
                                   Factory="{x:Static views:LazyTabFactories.CodeLookup}" />
                <views:LazyTabHost x:Name="ManualActivationTab"
                                   IsVisible="{Binding IsManualActivationVisible}"
                                   Factory="{x:Static views:LazyTabFactories.ManualActivation}" />
                <views:LazyTabHost x:Name="ProductionOrdersTab"
                                   IsVisible="{Binding IsProductionOrdersVisible}"
                                   Factory="{x:Static views:LazyTabFactories.ProductionOrders}" />
                <views:LazyTabHost x:Name="PrintTab"
                                   IsVisible="{Binding IsPrintVisible}"
                                   Factory="{x:Static views:LazyTabFactories.Print}" />
                <views:LazyTabHost x:Name="AboutTab"
                                   IsVisible="{Binding IsAboutVisible}"
                                   Factory="{x:Static views:LazyTabFactories.About}" />
                <views:LazyTabHost x:Name="MultiConnectTab"
                                   IsVisible="{Binding IsMultiConnectVisible}"
                                   Factory="{x:Static views:LazyTabFactories.MultiConnect}" />
            </Grid>
        </Grid>

        <!-- ===== Bàn phím ảo (máy cảm ứng) =====
             Hiện ở đáy cửa sổ khi người dùng chạm vào một ô nhập.
             Nằm ở HÀNG RIÊNG (Grid.Row="3") -> bàn phím "đẩy" nội dung
             tab lên thay vì phủ lên, để ô nhập gốc luôn nhìn thấy.

             Control tự quản lý IsVisible: chỉ cửa sổ đang sở hữu ô nhập
             mới hiện bàn phím. Khi ẩn, hàng này co về 0 và nội dung lấy
             lại toàn bộ chỗ. -->
        <controls:VirtualKeyboard Grid.Row="4"
                                 DataContext="{Binding Keyboard}" />

        <!-- ===== OVERLAY ĐĂNG NHẬP =====
             Phủ lên cửa sổ chính (ZIndex cao, nằm SAU CÙNG trong Grid).
             Nhờ vậy app chỉ có MỘT cửa sổ: bấm "Đăng nhập" chỉ fade overlay,
             không tạo/đóng cửa sổ -> hết giật (1 frame trống) và không
             chuyển WindowState 2 lần.

             Hiệu ứng mờ: Opacity gắn với LoginOverlayOpacity (0 -> 1),
             Transition 180ms. Khi ẩn, MainViewModel đợi hết hiệu ứng rồi mới
             tắt IsVisible -> overlay không chặn chuột/bàn phím.
             Nền ngoài overlay được làm mờ (dim) để tách khỏi giao diện chính. -->
        <Border Grid.Row="0"
                Grid.RowSpan="5"
                Grid.Column="0"
                ZIndex="1000"
                Background="#66000000"
                Opacity="{Binding LoginOverlayOpacity}"
                IsVisible="{Binding IsLoginOverlayVisible}">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="0:0:0.18"
                                      Easing="CubicEaseOut" />
                </Transitions>
            </Border.Transitions>
            <views:LoginView x:Name="LoginOverlay"
                             DataContext="{Binding Login}" />
        </Border>
    </Grid>
</Window>
