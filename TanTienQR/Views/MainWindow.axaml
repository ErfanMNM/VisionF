<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TanTienQR.ViewModels"
        xmlns:d="http://schemas.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="TanTienQR.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/tantien-logo.png"
        Title="TanTienQR · Bảng điều khiển quét mã"
        Width="1280" Height="800"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <!-- Chỉ dùng cho trình xem trước trong IDE; DataContext lúc chạy được gán trong App.axaml.cs -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="240,*">

        <!-- ===== Sidebar ===== -->
        <Border Grid.Column="0"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource LineColor}"
                BorderThickness="0,0,1,0"
                Padding="16,18">
            <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="18">

                <!-- Logo -->
                <StackPanel Grid.Row="0" Spacing="10" HorizontalAlignment="Center">
                    <Border Width="62" Height="62"
                            CornerRadius="18"
                            Background="{StaticResource Accent}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="TT"
                                   FontSize="22"
                                   FontWeight="Black"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="TanTienQR"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Quét mã · PLC"
                               Classes="label"
                               FontSize="11"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Trạng thái app -->
                <Border Grid.Row="1" Classes="device" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="label" FontSize="10" Text="TRẠNG THÁI ỨNG DỤNG" />
                        <Border Classes="badge"
                                Classes.running="{Binding IsReady}"
                                HorizontalAlignment="Left"
                                Padding="10,4">
                            <TextBlock Text="{Binding AppStateText}" />
                        </Border>
                        <TextBlock Text="{Binding AppStateDetail}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMuted}"
                                   TextWrapping="Wrap"
                                   MaxLines="3" />
                    </StackPanel>
                </Border>

                <!-- Thiết bị -->
                <StackPanel Grid.Row="2" Spacing="8">
                    <TextBlock Classes="label" FontSize="10" Text="THIẾT BỊ" Margin="2,0,0,0" />

                    <Border Classes="device" Padding="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Ellipse Classes="led" Classes.on="{Binding IsCameraConnected}" Classes.off="{Binding !IsCameraConnected}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Camera RD" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CameraStatusText}" FontSize="11" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Classes="device" Padding="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Ellipse Classes="led" Classes.on="{Binding IsPlcConnected}" Classes.off="{Binding !IsPlcConnected}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="PLC Omron" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PlcStatusText}" FontSize="11" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- License: nút mở hộp thoại quản lý -->
                <Border Grid.Row="3" Classes="device" Padding="12">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="label" FontSize="10" Text="LICENSE" />
                            <Border Grid.Column="1" Classes="badge"
                                    Classes.running="{Binding IsLicenseRunning}"
                                    Classes.warning="{Binding IsLicenseWarning}"
                                    Classes.fault="{Binding IsLicenseFault}">
                                <TextBlock Text="{Binding LicenseStatusText}" />
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding LicenseDaysLeftText}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMuted}" />

                        <Button Classes="chip small"
                                HorizontalAlignment="Stretch"
                                FontSize="11"
                                Content="Quản lý license..."
                                Command="{Binding ShowLicenseWindowCommand}" />
                    </StackPanel>
                </Border>

                <!-- Đồng hồ -->
                <StackPanel Grid.Row="4" VerticalAlignment="Bottom" Spacing="4">
                    <TextBlock Text="{Binding ClockText}"
                               Classes="mono"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{StaticResource Accent}" />
                    <TextBlock Text="{Binding DateText}"
                               Classes="label"
                               FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Khu vực chính ===== -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="18,18,18,18" RowSpacing="14">

            <!-- Tiêu đề -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="3">
                    <TextBlock Text="Bảng điều khiển quét mã"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="Nhận tín hiệu camera và gửi kết quả xuống PLC Omron (D12 = kết quả, D16 = Ready)"
                               Classes="label"
                               FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Classes="pill" Classes.ok="{Binding IsReady}" Classes.warn="{Binding !IsReady}">
                        <TextBlock Text="{Binding AppStateText}" />
                    </Border>
                    <Border Classes="pill" Classes.ok="{Binding IsPlcConnected}" Classes.danger="{Binding !IsPlcConnected}">
                        <TextBlock Text="{Binding PlcStatusText}" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- KPI -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                <Border Grid.Column="0" Classes="kpi">
                    <StackPanel Spacing="3">
                        <TextBlock Classes="label" FontSize="11" Text="TỔNG SỐ LẦN QUÉT" />
                        <TextBlock Classes="kpiValue" Text="{Binding TotalScans}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="kpi">
                    <StackPanel Spacing="3">
                        <TextBlock Classes="label" FontSize="11" Text="PASS" />
                        <TextBlock Classes="kpiValue" Foreground="{StaticResource Ok}" Text="{Binding PassCount}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Classes="kpi">
                    <StackPanel Spacing="3">
                        <TextBlock Classes="label" FontSize="11" Text="FAIL" />
                        <TextBlock Classes="kpiValue" Foreground="{StaticResource Danger}" Text="{Binding FailCount}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Classes="kpi">
                    <StackPanel Spacing="3">
                        <TextBlock Classes="label" FontSize="11" Text="TỶ LỆ ĐẠT" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="kpiValue" Text="{Binding PassRate}" />
                            <TextBlock Classes="unit" VerticalAlignment="Bottom" Margin="0,0,0,6" Text="%" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bảng quét + sự kiện -->
            <Grid Grid.Row="2" ColumnDefinitions="*,330" ColumnSpacing="12">

                <!-- Bảng mã quét -->
                <Border Grid.Column="0" Classes="panel" Padding="14,12">
                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <TextBlock Classes="sectionTitle" Text="LỊCH SỬ MÃ QUÉT" />
                                <TextBlock Classes="label" VerticalAlignment="Center" Text="{Binding TotalScans, StringFormat='Tổng: {0}'}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="label" VerticalAlignment="Center" Text="Mã cuối:" />
                                <TextBlock Classes="reading" Text="{Binding LastScanText}" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="label mono" VerticalAlignment="Center" Text="{Binding LastScanTimeText}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="6">
                            <!-- Header -->
                            <Grid Grid.Row="0" ColumnDefinitions="80,*,140,110,90" ColumnSpacing="8"
                                  Margin="4,0,4,0">
                                <TextBlock Classes="label" FontSize="10" Text="GIỜ" />
                                <TextBlock Grid.Column="1" Classes="label" FontSize="10" Text="MÃ / SERIAL" />
                                <TextBlock Grid.Column="2" Classes="label" FontSize="10" Text="GTIN" />
                                <TextBlock Grid.Column="3" Classes="label" FontSize="10" Text="KẾT QUẢ" />
                                <TextBlock Grid.Column="4" Classes="label" FontSize="10" Text="GỬI PLC" />
                            </Grid>

                            <!-- Dữ liệu -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Scans}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ScanRowViewModel">
                                            <Border Classes="event" Margin="0,1" Padding="10,7">
                                                <Grid ColumnDefinitions="80,*,140,110,90" ColumnSpacing="8">
                                                    <TextBlock Classes="mono" FontSize="11" VerticalAlignment="Center" Text="{Binding TimeText}" />
                                                    <TextBlock Grid.Column="1" Classes="mono" FontSize="12" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" Text="{Binding CodeText}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Classes="mono" FontSize="11"
                                                               VerticalAlignment="Center" Text="{Binding GtinText}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Border Grid.Column="3" Classes="badge" Classes.running="{Binding IsPass}" Classes.warning="{Binding IsNoRead}" Classes.fault="{Binding IsInvalid}">
                                                        <TextBlock Text="{Binding OutcomeText}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="4" Classes="label" FontSize="11" VerticalAlignment="Center" Text="{Binding PlcText}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Sự kiện gần đây -->
                <Border Grid.Column="1" Classes="panel" Padding="14,12">
                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <TextBlock Classes="sectionTitle" Text="SỰ KIỆN GẦN ĐÂY" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Events}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScanEvent">
                                        <Border Classes="event" Margin="0,2" Padding="9,7">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                                <Border Classes="stripe" Classes.warning="{Binding IsWarning}" Classes.critical="{Binding IsCritical}" />
                                                <TextBlock Grid.Column="1" FontSize="11" TextWrapping="Wrap" MaxLines="2"
                                                           VerticalAlignment="Center" Text="{Binding Message}" />
                                                <TextBlock Grid.Column="2" Classes="label mono" FontSize="10"
                                                           VerticalAlignment="Center" Text="{Binding TimeText}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
