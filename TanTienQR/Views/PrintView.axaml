<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TanTienQR.ViewModels"
             xmlns:controls="using:TanTienQR.Controls"
             xmlns:print="using:ClassLibraryMT.Print"
             x:Class="TanTienQR.Views.PrintView" x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.printValue">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.printStat">
            <Setter Property="Background" Value="{StaticResource BgRaised}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="Button.remoteTool">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.printAction">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <Grid Margin="18,6,18,18" RowDefinitions="Auto,*" RowSpacing="14">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border Width="42" Height="42" CornerRadius="14" Background="{StaticResource AccentSoft}"
                    BorderBrush="{StaticResource LineAccent}" BorderThickness="1" VerticalAlignment="Center">
                <Path Width="20" Height="20" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.9"
                      StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="{StaticResource Icon.Print}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock Classes="pageTitle" Text="Máy in" />
                <TextBlock Classes="label" Text="{Binding Print.PrinterName}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Border Grid.Column="2" Classes="deviceCard {Binding Print.PrinterCardClass}" Padding="12,8"
                    VerticalAlignment="Center" IsVisible="{Binding Print.CanUse}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Grid Width="10" Height="10" VerticalAlignment="Center">
                        <Ellipse Classes="ledHalo" Classes.warn="{Binding !Print.IsPrinterConnected}" Classes.blink="{Binding Print.IsPrinterBlinking}" />
                        <Ellipse Classes="led" Classes.on="{Binding Print.IsPrinterConnected}" Classes.warn="{Binding !Print.IsPrinterConnected}" Classes.blink="{Binding Print.IsPrinterBlinking}" />
                    </Grid>
                    <StackPanel Grid.Column="1" Spacing="2" MaxWidth="220">
                        <TextBlock Classes="deviceTitle" Text="KẾT NỐI DỮ LIỆU" />
                        <TextBlock Classes="deviceStatus" Text="{Binding Print.ConnectionText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- Chỉ vùng thao tác cuộn. Surface native luôn nhận kích thước hữu hạn. -->
        <Grid x:Name="WorkArea" Grid.Row="1" ColumnDefinitions="*,316" ColumnSpacing="14" IsVisible="{Binding Print.CanUse}">
            <Border x:Name="RemoteCard" Grid.Column="0" Classes="panel" Padding="12">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="overline" Text="MÀN HÌNH MÁY IN" />
                            <TextBlock Classes="label" Text="{Binding Print.Remote.EndpointText}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button Classes="chip remoteTool" Content="Mật khẩu" Click="OnOpenCredentials"
                                    ToolTip.Tip="Nhập hoặc đổi mật khẩu máy in trên máy tính này" />
                            <Button Classes="soft remoteTool" Content="Kết nối" IsEnabled="{Binding Print.Remote.CanConnect}" Command="{Binding Print.Remote.ConnectCommand}" />
                            <Button Classes="chip remoteTool" Content="Ngắt" IsEnabled="{Binding Print.Remote.CanDisconnect}" Command="{Binding Print.Remote.DisconnectCommand}" />
                            <Button Classes="chip remoteTool" Command="{Binding Print.Remote.ToggleExpandedCommand}">
                                <Panel>
                                    <TextBlock Text="Phóng to" IsVisible="{Binding !Print.Remote.IsExpanded}" />
                                    <TextBlock Text="Thu gọn" IsVisible="{Binding Print.Remote.IsExpanded}" />
                                </Panel>
                            </Button>
                        </WrapPanel>
                    </Grid>
                    <!-- Bố trí bằng bounds thật; không scale HWND bằng Viewbox. -->
                    <controls:AspectRatioPanel x:Name="RemoteAspectPanel" Grid.Row="1">
                        <Border x:Name="RemoteScreen" Background="#0B1623" ClipToBounds="True">
                            <Grid>
                                <controls:PrinterRemoteHost x:Name="PrinterScreen" Remote="{Binding Print.Remote}" />
                                <Grid x:Name="PlaceholderArea" IsVisible="{Binding !Print.Remote.IsSurfaceVisible}" Margin="20">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="400">
                                        <Path x:Name="PlaceholderIcon" Width="34" Height="34" Stretch="Uniform" Stroke="#B7CBDF" StrokeThickness="1.5"
                                              StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" Data="{StaticResource Icon.Print}" />
                                        <TextBlock x:Name="PlaceholderTitle" Text="Giao diện máy in" Foreground="#E8F1F8" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="PlaceholderStatus" Text="{Binding Print.Remote.StatusText}" Foreground="#B7CBDF" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />
                                        <ProgressBar Width="140" IsIndeterminate="True" IsVisible="{Binding Print.Remote.IsConnecting}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </controls:AspectRatioPanel>
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Idle}" VerticalAlignment="Center" IsVisible="{Binding !Print.Remote.IsConnected}" />
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Ok}" VerticalAlignment="Center" IsVisible="{Binding Print.Remote.IsConnected}" />
                        <TextBlock Grid.Column="1" Classes="label" Text="{Binding Print.Remote.StatusText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Print.Remote.StatusText}" />
                    </Grid>
                </Grid>
            </Border>
            <Grid x:Name="OperationPanel" Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="10">
                <!-- Bật/tạm dừng luôn nằm ngoài vùng cuộn để người vận hành truy cập ngay. -->
                <StackPanel IsEnabled="{Binding Print.IsPrinterConnected}">
                    <Button Classes="primary printAction" Content="Bật in" IsVisible="{Binding !Print.IsPrinting}" IsEnabled="{Binding !Print.IsControlBusy}" Command="{Binding Print.TogglePrintingCommand}" />
                    <Button Classes="whitebtn printAction" Content="Tạm dừng in" IsVisible="{Binding Print.IsPrinting}" IsEnabled="{Binding !Print.IsControlBusy}" Command="{Binding Print.TogglePrintingCommand}" />
                </StackPanel>
            <ScrollViewer x:Name="OperationScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">
                    <Border Classes="panel" Padding="16">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="overline" Text="PO ĐANG CHẠY" />
                                <TextBlock Classes="printValue" FontWeight="SemiBold" Text="{Binding Print.OrderText}" />
                            </StackPanel>
                            <StackPanel Spacing="6" IsEnabled="{Binding Print.CanConnect}">
                                <TextBlock Classes="fieldLabel" Text="SỐ LƯỢNG MÃ" />
                                <NumericUpDown Minimum="1" Maximum="1000" Increment="1" FormatString="0" MinHeight="40" HorizontalAlignment="Stretch" Value="{Binding Print.Quantity, Mode=TwoWay}" />
                                <Button Classes="primary printAction" Content="Gửi mã vào máy in" Command="{Binding Print.SendCommand}" IsEnabled="{Binding !Print.IsBusy}" />
                                <ProgressBar IsIndeterminate="True" IsVisible="{Binding Print.IsBusy}" />
                            </StackPanel>
                            <Border Classes="printStat"><TextBlock Classes="printValue" Text="{Binding Print.StatusText}" /></Border>
                            <Border Background="{StaticResource WarnSoft}" Padding="10" CornerRadius="10" IsVisible="{Binding !Print.CanConnect}">
                                <TextBlock Text="{Binding Print.ModuleMessage}" Foreground="{StaticResource Warn}" FontSize="12" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Classes="panel" Padding="16">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Classes="overline" Text="TRẠNG THÁI MÁY IN" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="chip" Content="Làm mới" Command="{Binding Print.RefreshCommand}" IsEnabled="{Binding Print.CanConnect}" />
                            </Grid>
                            <TextBlock Classes="printValue" Text="{Binding Print.PrinterStatusText}" />
                            <StackPanel Spacing="5">
                                <TextBlock Classes="fieldLabel" Text="BẢN TIN HIỆN TẠI" />
                                <TextBlock Classes="printValue" FontWeight="SemiBold" Text="{Binding Print.JobText}" />
                            </StackPanel>
                            <Border Classes="printStat">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="printValue mono" Text="{Binding Print.InkText}" />
                                    <TextBlock Classes="printValue" Text="{Binding Print.QueueText}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Classes="label mono" FontSize="11" Text="{Binding Print.PrinterEndpoint}" TextWrapping="Wrap" />
                            <Button Classes="chip printAction" Content="Kết nối lại dữ liệu" Command="{Binding Print.ConnectCommand}" IsEnabled="{Binding Print.CanConnect}" />
                            <TextBlock Classes="printValue" Text="{Binding Print.ControlMessage}" IsVisible="{Binding Print.HasControlMessage}" />
                        </StackPanel>
                    </Border>
                    <Border Classes="panel" Padding="16">
                        <Expander x:Name="CredentialExpander" Header="Đăng nhập máy in" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="10" Margin="0,10,0,0">
                                <TextBlock Classes="label" TextWrapping="Wrap" Text="Đặt địa chỉ và tài khoản trong Cấu hình → Máy in. Lưu mật khẩu để kết nối trên máy tính này." />
                                <TextBox x:Name="PasswordInput" PasswordChar="●" PlaceholderText="Mật khẩu máy in" Text="{Binding Print.Remote.Password, Mode=TwoWay}" />
                                <Button Classes="soft printAction" Content="Lưu mật khẩu trên máy này" Command="{Binding Print.Remote.SaveCredentialCommand}" IsEnabled="{Binding Print.Remote.CanSaveCredential}" />
                                <TextBlock Classes="label" Text="{Binding Print.Remote.CredentialMessage}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </Border>
                    <Border Classes="panel" Padding="16">
                        <Expander Header="Bảo trì máy in" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="8" Margin="0,10,0,0" IsEnabled="{Binding Print.IsPrinterConnected}">
                                <Button Classes="chip printAction" Content="Xóa buffer" Command="{Binding Print.ClearDataCommand}" />
                                <Button Classes="chip printAction" Content="Reset số đếm" Command="{Binding Print.ResetCounterCommand}" />
                                <Button Classes="chip printAction" Content="Vệ sinh đầu in" Command="{Binding Print.CleanNozzleCommand}" />
                                <Button Classes="chip printAction" Content="Test phun JET" Command="{Binding Print.TriggerJetCommand}" />
                                <Button Classes="chip printAction" Content="Đọc danh sách bản tin" Command="{Binding Print.RefreshFilesCommand}" />
                            </StackPanel>
                        </Expander>
                    </Border>
                    <Border Classes="panel" Padding="16">
                        <Expander Header="Lịch sử lệnh" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="10" Margin="0,10,0,0">
                                <Button Classes="chip" Content="Xóa lịch sử" HorizontalAlignment="Left" Command="{Binding Print.ClearHistoryCommand}" IsEnabled="{Binding Print.HasCommandHistory}" />
                                <ListBox ItemsSource="{Binding Print.CommandHistory}" MaxHeight="260" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="print:PrinterCommandLog">
                                            <StackPanel Spacing="3" Margin="0,0,0,8">
                                                <TextBlock Classes="mono" FontSize="12" Text="{Binding Command}" TextWrapping="Wrap" />
                                                <TextBlock Classes="printValue" FontSize="11" Text="{Binding Response}" />
                                                <TextBlock Classes="label mono" FontSize="10" Text="{Binding At, StringFormat='HH:mm:ss'}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Classes="label" Text="Chưa có lệnh nào." IsVisible="{Binding !Print.HasCommandHistory}" />
                            </StackPanel>
                        </Expander>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            </Grid>
        </Grid>
        <Border Grid.Row="1" Classes="panel" Padding="24" IsVisible="{Binding !Print.CanUse}">
            <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="sectionTitle" Text="MÁY IN CHƯA ĐƯỢC MỞ KHÓA" HorizontalAlignment="Center" />
                <TextBlock Classes="label" Text="{Binding Print.LicenseMessage}" TextWrapping="Wrap" TextAlignment="Center" />
                <TextBlock Classes="label" Text="Nhập license có quyền printer để sử dụng máy in." TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
