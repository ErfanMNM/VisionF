<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TanTienQR.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="360"
             x:Class="TanTienQR.Controls.VirtualKeyboard"
             x:DataType="vm:VirtualKeyboardViewModel">
    <!-- IsVisible được code-behind quản lý: bàn phím chỉ hiện trong đúng
         cửa sổ đang có ô nhập được focus (cửa sổ cha ẩn khi mở hộp thoại con). -->

  <UserControl.Styles>
    <!-- ===== Phím cơ bản =====
         Focusable=False để bấm phím KHÔNG cướp focus khỏi ô nhập — nếu không,
         bàn phím sẽ tự đóng ngay khi người dùng gõ ký tự đầu tiên. -->
    <Style Selector="Button.key">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="RenderTransform" Value="none" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.06" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.key /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BgPanel}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
      <Setter Property="BorderThickness" Value="1,1,1,2" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BoxShadow" Value="0 1 3 0 #14000000" />
    </Style>
    <Style Selector="Button.key:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>
    <!-- Hiệu ứng nhấn: phím lún nhẹ + đổi màu -->
    <Style Selector="Button.key:pressed">
      <Setter Property="RenderTransform" Value="scale(0.95)" />
    </Style>
    <Style Selector="Button.key:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="BoxShadow" Value="none" />
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>

    <!-- ===== Phím chức năng (Shift, Backspace, Space, 123...) ===== -->
    <Style Selector="Button.key.fn">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>
    <Style Selector="Button.key.fn /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BgRaised}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
    </Style>
    <Style Selector="Button.key.fn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="Button.key.fn:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>

    <!-- ===== Phím Enter nổi bật ===== -->
    <Style Selector="Button.key.enter">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.key.enter /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="BoxShadow" Value="0 2 6 0 #33000000" />
    </Style>
    <Style Selector="Button.key.enter:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.9" />
      <Setter Property="Background" Value="{StaticResource Accent}" />
    </Style>

    <!-- ===== Phím Shift đang bật ===== -->
    <Style Selector="Button.key.active">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.key.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>

    <!-- ===== Phím dấu tiếng Việt: gọn, nền nhạt ===== -->
    <Style Selector="Button.key.mark">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="Margin" Value="1.5" />
    </Style>
    <Style Selector="Button.key.mark /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineAccent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Button.key.mark:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BgPanel}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="Button.key.mark:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent}" />
    </Style>

    <!-- Phím nguyên âm KHÔNG dấu ở hàng tiêu đề bảng tiếng Việt:
         nền trung tính để phân biệt với các phím có dấu. -->
    <Style Selector="Button.key.mark.base">
      <Setter Property="Background" Value="{StaticResource BgRaised}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.key.mark.base /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BgRaised}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
    </Style>
    <Style Selector="Button.key.mark.base:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BgPanel}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>

    <!-- ===== Nút nhỏ trên thanh trên cùng (dạng "pill") ===== -->
    <Style Selector="Button.key.pill">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.key.pill /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>

    <!-- ===== Ô nhập mirror (ô nhập trên bàn phím) =====
         Hiển thị nội dung đang nhập để người dùng không bị mất dõi khi
         bàn phím che mất ô nhập gốc. Gõ trực tiếp được. -->
    <Style Selector="TextBox.kbmirror">
      <Setter Property="Background" Value="{StaticResource BgPanel}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineAccent}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="TextBox.kbmirror:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="TextBox.kbmirror /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource BgPanel}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineAccent}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>

    <!-- ===== Nút bật/tắt hàng phím tiếng Việt =====
         Hàng phím tiếng Việt rất nhiều phím nên mặc định ẨN cho gọn;
         người dùng bấm nút này để bật/tắt. -->
    <Style Selector="ToggleButton.kbvn">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="Background" Value="{StaticResource BgRaised}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="MinWidth" Value="92" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.kbvn:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="ToggleButton.kbvn:checked">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ToggleButton.kbvn:checked:pointerover">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Opacity" Value="0.9" />
    </Style>

    <!-- Nhãn nhóm trong bảng phím tiếng Việt -->
    <Style Selector="TextBlock.kbgroup">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Nút "con mắt" hiện/ẩn mật khẩu trong ô mirror -->
    <Style Selector="ToggleButton.kbeye">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Width" Value="38" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="ToggleButton.kbeye:pointerover">
      <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="ToggleButton.kbeye:checked">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ToggleButton.kbeye /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.kbeye:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Nút xoá nhanh trong ô mirror -->
    <Style Selector="Button.kbclear">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Width" Value="38" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="Button.kbclear:pointerover">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource Danger}" />
    </Style>
    <Style Selector="Button.kbclear /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>

  <!-- Khung ngoài: bo góc phía trên + đổ bóng nhẹ để nổi lên khỏi nội dung -->
  <Border Background="{StaticResource BgRaised}"
          BorderBrush="{StaticResource LineColor}"
          BorderThickness="0,1,0,0"
          CornerRadius="16,16,0,0"
          BoxShadow="0 -4 16 0 #1A000000"
          Padding="12,8,12,12">

    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">

      <!-- ===== Thanh trên: gợi ý ô đang nhập + nút chức năng ===== -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="2,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="26" Height="26" CornerRadius="13"
                  Background="{StaticResource AccentSoft}">
            <Path Width="12" Height="12"
                  Stretch="Uniform"
                  Stroke="{StaticResource Accent}"
                  StrokeThickness="2"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Data="M2,12 L2,6 M2,6 L7,2 L12,6 L12,12 Z" />
          </Border>
          <TextBlock VerticalAlignment="Center"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextMuted}"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding TargetHint}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <!-- Bật/tắt hàng phím tiếng Việt (mặc định ẩn).
               IsChecked OneWay + Click handler: tránh vòng lặp hai chiều
               (ToggleButton tự lật IsChecked rồi binding ghi đè ngược lại). -->
          <ToggleButton Classes="kbvn"
                        IsVisible="{Binding IsAlphaLayout}"
                        IsChecked="{Binding IsVietnameseKeysVisible, Mode=OneWay}"
                        Click="OnVietnameseToggleClick"
                        ToolTip.Tip="Bật / tắt hàng phím tiếng Việt">
            <TextBlock Text="Tiếng Việt" />
          </ToggleButton>
          <Button Classes="key fn pill"
                  Height="32" MinWidth="64"
                  Click="OnLayoutClick"
                  Content="123 / ABC" />
          <Button Classes="key fn pill"
                  Height="32" MinWidth="80"
                  Click="OnClearClick"
                  Content="Xoá hết" />
          <Button Classes="key fn pill"
                  Height="32" Width="40"
                  Click="OnCloseClick"
                  Content="✕" />
        </StackPanel>
      </Grid>

      <!-- ===== Ô nhập mirror: hiển thị nội dung đang nhập =====
           Bàn phím có thể che mất ô nhập gốc, nên ô này cho người dùng
           nhìn thấy mình đang gõ gì. Gõ trực tiếp được.

           Dùng 2 TextBox chồng nhau vì PasswordChar là kiểu char (không
           bind được):
           - kbmirrorMask : hiện khi ô gốc là mật khẩu và chưa bật con mắt
           - kbmirrorPlain: hiện khi ô gốc không phải mật khẩu, hoặc đã bật con mắt -->
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">

        <!-- Bản hiển thị rõ (ô thường hoặc đã bật con mắt) -->
        <TextBox x:Name="MirrorPlainBox"
                 Grid.Column="0"
                 Classes="kbmirror"
                 Height="44"
                 PlaceholderText="{Binding TargetHint}"
                 Text="{Binding MirrorText, Mode=OneWay}"
                 IsVisible="{Binding IsMirrorPlainVisible}"
                 TextChanged="OnMirrorTextChanged"
                 GotFocus="OnMirrorGotFocus">
          <TextBox.InnerRightContent>
            <Grid ColumnDefinitions="Auto,Auto">
              <!-- Con mắt: chỉ hiện với ô mật khẩu -->
              <ToggleButton Grid.Column="0"
                            Classes="kbeye"
                            IsVisible="{Binding CanReveal}"
                            IsChecked="{Binding IsRevealed, Mode=OneWay}"
                            Command="{Binding ToggleRevealCommand}"
                            ToolTip.Tip="Hiện / ẩn mật khẩu">
                <Path Width="16" Height="16"
                      Stretch="Uniform"
                      Stroke="{StaticResource TextMuted}"
                      StrokeThickness="1.8"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Data="M2,12 C5,6 9.5,4 12,4 C14.5,4 19,6 22,12 C19,18 14.5,20 12,20 C9.5,20 5,18 2,12 Z M12,12 M12,9.5 A2.5,2.5 0 1 0 12,14.5 A2.5,2.5 0 1 0 12,9.5 Z" />
              </ToggleButton>

              <!-- Xoá nhanh -->
              <Button Grid.Column="1"
                      Classes="kbclear"
                      ToolTip.Tip="Xoá nội dung"
                      Click="OnClearClick">
                <TextBlock Text="✕" FontSize="15" />
              </Button>
            </Grid>
          </TextBox.InnerRightContent>
        </TextBox>

        <!-- Bản mask (ô mật khẩu, chưa bật con mắt) -->
        <TextBox x:Name="MirrorMaskBox"
                 Grid.Column="0"
                 Classes="kbmirror"
                 Height="44"
                 PasswordChar="•"
                 PlaceholderText="{Binding TargetHint}"
                 Text="{Binding MirrorText, Mode=OneWay}"
                 IsVisible="{Binding IsMirrorMaskVisible}"
                 TextChanged="OnMirrorTextChanged"
                 GotFocus="OnMirrorGotFocus">
          <TextBox.InnerRightContent>
            <Grid ColumnDefinitions="Auto,Auto">
              <!-- Con mắt: bật để hiện rõ mật khẩu -->
              <ToggleButton Grid.Column="0"
                            Classes="kbeye"
                            IsChecked="{Binding IsRevealed, Mode=OneWay}"
                            Command="{Binding ToggleRevealCommand}"
                            ToolTip.Tip="Hiện / ẩn mật khẩu">
                <Path Width="16" Height="16"
                      Stretch="Uniform"
                      Stroke="{StaticResource TextMuted}"
                      StrokeThickness="1.8"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Data="M2,12 C5,6 9.5,4 12,4 C14.5,4 19,6 22,12 C19,18 14.5,20 12,20 C9.5,20 5,18 2,12 Z M12,12 M12,9.5 A2.5,2.5 0 1 0 12,14.5 A2.5,2.5 0 1 0 12,9.5 Z" />
              </ToggleButton>

              <!-- Xoá nhanh -->
              <Button Grid.Column="1"
                      Classes="kbclear"
                      ToolTip.Tip="Xoá nội dung"
                      Click="OnClearClick">
                <TextBlock Text="✕" FontSize="15" />
              </Button>
            </Grid>
          </TextBox.InnerRightContent>
        </TextBox>
      </Grid>

      <!-- ===== Bàn phím chữ ===== -->
      <Grid Grid.Row="2" IsVisible="{Binding IsAlphaLayout}"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="5">

        <!-- Hàng số -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*,*,*,*,*,*,*" ColumnSpacing="5">
          <Button Grid.Column="0" Classes="key" Height="42" Content="1" Click="OnKeyClick" />
          <Button Grid.Column="1" Classes="key" Height="42" Content="2" Click="OnKeyClick" />
          <Button Grid.Column="2" Classes="key" Height="42" Content="3" Click="OnKeyClick" />
          <Button Grid.Column="3" Classes="key" Height="42" Content="4" Click="OnKeyClick" />
          <Button Grid.Column="4" Classes="key" Height="42" Content="5" Click="OnKeyClick" />
          <Button Grid.Column="5" Classes="key" Height="42" Content="6" Click="OnKeyClick" />
          <Button Grid.Column="6" Classes="key" Height="42" Content="7" Click="OnKeyClick" />
          <Button Grid.Column="7" Classes="key" Height="42" Content="8" Click="OnKeyClick" />
          <Button Grid.Column="8" Classes="key" Height="42" Content="9" Click="OnKeyClick" />
          <Button Grid.Column="9" Classes="key" Height="42" Content="0" Click="OnKeyClick" />
        </Grid>

        <!-- Hàng 1: QWERTY -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*,*,*,*,*,*" ColumnSpacing="5">
          <Button Grid.Column="0" Classes="key" Height="48" Content="Q" Click="OnKeyClick" />
          <Button Grid.Column="1" Classes="key" Height="48" Content="W" Click="OnKeyClick" />
          <Button Grid.Column="2" Classes="key" Height="48" Content="E" Click="OnKeyClick" />
          <Button Grid.Column="3" Classes="key" Height="48" Content="R" Click="OnKeyClick" />
          <Button Grid.Column="4" Classes="key" Height="48" Content="T" Click="OnKeyClick" />
          <Button Grid.Column="5" Classes="key" Height="48" Content="Y" Click="OnKeyClick" />
          <Button Grid.Column="6" Classes="key" Height="48" Content="U" Click="OnKeyClick" />
          <Button Grid.Column="7" Classes="key" Height="48" Content="I" Click="OnKeyClick" />
          <Button Grid.Column="8" Classes="key" Height="48" Content="O" Click="OnKeyClick" />
          <Button Grid.Column="9" Classes="key" Height="48" Content="P" Click="OnKeyClick" />
        </Grid>

        <!-- Hàng 2: ASDF + Enter (10 cột: 9 chữ + Enter) -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*,*,*,*,*,*,*" ColumnSpacing="5">
          <Button Grid.Column="0" Classes="key" Height="48" Content="A" Click="OnKeyClick" />
          <Button Grid.Column="1" Classes="key" Height="48" Content="S" Click="OnKeyClick" />
          <Button Grid.Column="2" Classes="key" Height="48" Content="D" Click="OnKeyClick" />
          <Button Grid.Column="3" Classes="key" Height="48" Content="F" Click="OnKeyClick" />
          <Button Grid.Column="4" Classes="key" Height="48" Content="G" Click="OnKeyClick" />
          <Button Grid.Column="5" Classes="key" Height="48" Content="H" Click="OnKeyClick" />
          <Button Grid.Column="6" Classes="key" Height="48" Content="J" Click="OnKeyClick" />
          <Button Grid.Column="7" Classes="key" Height="48" Content="K" Click="OnKeyClick" />
          <Button Grid.Column="8" Classes="key" Height="48" Content="L" Click="OnKeyClick" />
          <Button Grid.Column="9" Classes="key enter" Height="48" Click="OnEnterClick" Content="⏎" />
        </Grid>

        <!-- Hàng 3: Shift + ZXCV + Backspace -->
        <Grid Grid.Row="3" ColumnDefinitions="1.5*,*,*,*,*,*,*,*,1.5*" ColumnSpacing="5">
          <Button Grid.Column="0"
                  x:Name="ShiftButton"
                  Classes="key fn"
                  Height="48"
                  Click="OnShiftClick"
                  FontSize="20"
                  Content="⇧" />
          <Button Grid.Column="1" Classes="key" Height="48" Content="Z" Click="OnKeyClick" />
          <Button Grid.Column="2" Classes="key" Height="48" Content="X" Click="OnKeyClick" />
          <Button Grid.Column="3" Classes="key" Height="48" Content="C" Click="OnKeyClick" />
          <Button Grid.Column="4" Classes="key" Height="48" Content="V" Click="OnKeyClick" />
          <Button Grid.Column="5" Classes="key" Height="48" Content="B" Click="OnKeyClick" />
          <Button Grid.Column="6" Classes="key" Height="48" Content="N" Click="OnKeyClick" />
          <Button Grid.Column="7" Classes="key" Height="48" Content="M" Click="OnKeyClick" />
          <Button Grid.Column="8" Classes="key fn" Height="48" Click="OnBackspaceClick" FontSize="20" Content="⌫" />
        </Grid>

        <!-- ===== Hàng 4: bảng phím tiếng Việt (mặc định ẨN) =====
             Bố cục dạng bảng: CỘT = nguyên âm, HÀNG = dấu thanh
             (huyền, sắc, hỏi, ngã, nặng). Hàng tiêu đề là chính các nguyên
             âm (bấm được để gõ nguyên âm không dấu).

             Cách này nhớ dễ hơn lưới phẳng 39 phím, và đầy đủ mọi tổ hợp
             a/ă/â, e/ê, i, o/ô/ơ, u/ư, y.

             Bảng có chiều rộng cố định + cuộn ngang: trong hộp thoại hẹp
             thì cuộn thay vì bóp méo phím.

             Chỉ hiện khi người dùng bấm nút "Tiếng Việt" trên thanh trên cùng. -->
        <Border Grid.Row="4"
                IsVisible="{Binding IsVietnameseRowVisible}"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource LineColor}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="6,4">
          <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        HorizontalContentAlignment="Center">
            <Grid Width="454"
                  ColumnDefinitions="46,34,34,34,34,34,34,34,34,34,34,34,34"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                  RowSpacing="3">

              <!-- Cột nhãn dấu -->
              <TextBlock Grid.Row="0" Grid.Column="0" Classes="kbgroup" Text="Dấu" />

              <!-- Hàng tiêu đề: 12 nguyên âm (bấm để gõ không dấu) -->
              <Button Grid.Row="0" Grid.Column="1" Classes="key mark base" Height="30" Content="a" Click="OnKeyClick" />
              <Button Grid.Row="0" Grid.Column="2" Classes="key mark base" Height="30" Content="ă" Click="OnKeyClick" />
              <Button Grid.Row="0" Grid.Column="3" Classes="key mark base" Height="30" Content="â" Click="OnKeyClick" />
              <Button Grid.Row="0" Grid.Column="4" Classes="key mark base" Height="30" Content="e" Click="OnKeyClick" />
              <Button Grid.Row="0" Grid.Column="5" Classes="key mark base" Height="30" Content="ê" Click="OnKeyClick" />
              <Button Grid.Row="0" Grid.Column="6" Classes="key mark base" Height="30" Content="i" Click="OnKeyClick" />
              <Button Grid.Row="0" Grid.Column="7" Classes="key mark base" Height="30" Content="o" Click="OnKeyClick" />
              <Button Grid.Row="0" Grid.Column="8" Classes="key mark base" Height="30" Content="ô" Click="OnKeyClick" />
              <Button Grid.Row="0" Grid.Column="9" Classes="key mark base" Height="30" Content="ơ" Click="OnKeyClick" />
              <Button Grid.Row="0" Grid.Column="10" Classes="key mark base" Height="30" Content="u" Click="OnKeyClick" />
              <Button Grid.Row="0" Grid.Column="11" Classes="key mark base" Height="30" Content="ư" Click="OnKeyClick" />
              <Button Grid.Row="0" Grid.Column="12" Classes="key mark base" Height="30" Content="y" Click="OnKeyClick" />

              <!-- Huyền -->
              <TextBlock Grid.Row="1" Grid.Column="0" Classes="kbgroup" Text="Huyền" />
              <Button Grid.Row="1" Grid.Column="1" Classes="key mark" Height="30" Content="à" Click="OnKeyClick" />
              <Button Grid.Row="1" Grid.Column="2" Classes="key mark" Height="30" Content="ằ" Click="OnKeyClick" />
              <Button Grid.Row="1" Grid.Column="3" Classes="key mark" Height="30" Content="ầ" Click="OnKeyClick" />
              <Button Grid.Row="1" Grid.Column="4" Classes="key mark" Height="30" Content="è" Click="OnKeyClick" />
              <Button Grid.Row="1" Grid.Column="5" Classes="key mark" Height="30" Content="ề" Click="OnKeyClick" />
              <Button Grid.Row="1" Grid.Column="6" Classes="key mark" Height="30" Content="ì" Click="OnKeyClick" />
              <Button Grid.Row="1" Grid.Column="7" Classes="key mark" Height="30" Content="ò" Click="OnKeyClick" />
              <Button Grid.Row="1" Grid.Column="8" Classes="key mark" Height="30" Content="ồ" Click="OnKeyClick" />
              <Button Grid.Row="1" Grid.Column="9" Classes="key mark" Height="30" Content="ờ" Click="OnKeyClick" />
              <Button Grid.Row="1" Grid.Column="10" Classes="key mark" Height="30" Content="ù" Click="OnKeyClick" />
              <Button Grid.Row="1" Grid.Column="11" Classes="key mark" Height="30" Content="ừ" Click="OnKeyClick" />
              <Button Grid.Row="1" Grid.Column="12" Classes="key mark" Height="30" Content="ỳ" Click="OnKeyClick" />

              <!-- Sắc -->
              <TextBlock Grid.Row="2" Grid.Column="0" Classes="kbgroup" Text="Sắc" />
              <Button Grid.Row="2" Grid.Column="1" Classes="key mark" Height="30" Content="á" Click="OnKeyClick" />
              <Button Grid.Row="2" Grid.Column="2" Classes="key mark" Height="30" Content="ắ" Click="OnKeyClick" />
              <Button Grid.Row="2" Grid.Column="3" Classes="key mark" Height="30" Content="ấ" Click="OnKeyClick" />
              <Button Grid.Row="2" Grid.Column="4" Classes="key mark" Height="30" Content="é" Click="OnKeyClick" />
              <Button Grid.Row="2" Grid.Column="5" Classes="key mark" Height="30" Content="ế" Click="OnKeyClick" />
              <Button Grid.Row="2" Grid.Column="6" Classes="key mark" Height="30" Content="í" Click="OnKeyClick" />
              <Button Grid.Row="2" Grid.Column="7" Classes="key mark" Height="30" Content="ó" Click="OnKeyClick" />
              <Button Grid.Row="2" Grid.Column="8" Classes="key mark" Height="30" Content="ố" Click="OnKeyClick" />
              <Button Grid.Row="2" Grid.Column="9" Classes="key mark" Height="30" Content="ớ" Click="OnKeyClick" />
              <Button Grid.Row="2" Grid.Column="10" Classes="key mark" Height="30" Content="ú" Click="OnKeyClick" />
              <Button Grid.Row="2" Grid.Column="11" Classes="key mark" Height="30" Content="ứ" Click="OnKeyClick" />
              <Button Grid.Row="2" Grid.Column="12" Classes="key mark" Height="30" Content="ý" Click="OnKeyClick" />

              <!-- Hỏi -->
              <TextBlock Grid.Row="3" Grid.Column="0" Classes="kbgroup" Text="Hỏi" />
              <Button Grid.Row="3" Grid.Column="1" Classes="key mark" Height="30" Content="ả" Click="OnKeyClick" />
              <Button Grid.Row="3" Grid.Column="2" Classes="key mark" Height="30" Content="ẳ" Click="OnKeyClick" />
              <Button Grid.Row="3" Grid.Column="3" Classes="key mark" Height="30" Content="ẩ" Click="OnKeyClick" />
              <Button Grid.Row="3" Grid.Column="4" Classes="key mark" Height="30" Content="ẻ" Click="OnKeyClick" />
              <Button Grid.Row="3" Grid.Column="5" Classes="key mark" Height="30" Content="ể" Click="OnKeyClick" />
              <Button Grid.Row="3" Grid.Column="6" Classes="key mark" Height="30" Content="ỉ" Click="OnKeyClick" />
              <Button Grid.Row="3" Grid.Column="7" Classes="key mark" Height="30" Content="ỏ" Click="OnKeyClick" />
              <Button Grid.Row="3" Grid.Column="8" Classes="key mark" Height="30" Content="ổ" Click="OnKeyClick" />
              <Button Grid.Row="3" Grid.Column="9" Classes="key mark" Height="30" Content="ở" Click="OnKeyClick" />
              <Button Grid.Row="3" Grid.Column="10" Classes="key mark" Height="30" Content="ủ" Click="OnKeyClick" />
              <Button Grid.Row="3" Grid.Column="11" Classes="key mark" Height="30" Content="ử" Click="OnKeyClick" />
              <Button Grid.Row="3" Grid.Column="12" Classes="key mark" Height="30" Content="ỷ" Click="OnKeyClick" />

              <!-- Ngã -->
              <TextBlock Grid.Row="4" Grid.Column="0" Classes="kbgroup" Text="Ngã" />
              <Button Grid.Row="4" Grid.Column="1" Classes="key mark" Height="30" Content="ã" Click="OnKeyClick" />
              <Button Grid.Row="4" Grid.Column="2" Classes="key mark" Height="30" Content="ẵ" Click="OnKeyClick" />
              <Button Grid.Row="4" Grid.Column="3" Classes="key mark" Height="30" Content="ẫ" Click="OnKeyClick" />
              <Button Grid.Row="4" Grid.Column="4" Classes="key mark" Height="30" Content="ẽ" Click="OnKeyClick" />
              <Button Grid.Row="4" Grid.Column="5" Classes="key mark" Height="30" Content="ễ" Click="OnKeyClick" />
              <Button Grid.Row="4" Grid.Column="6" Classes="key mark" Height="30" Content="ĩ" Click="OnKeyClick" />
              <Button Grid.Row="4" Grid.Column="7" Classes="key mark" Height="30" Content="õ" Click="OnKeyClick" />
              <Button Grid.Row="4" Grid.Column="8" Classes="key mark" Height="30" Content="ỗ" Click="OnKeyClick" />
              <Button Grid.Row="4" Grid.Column="9" Classes="key mark" Height="30" Content="ỡ" Click="OnKeyClick" />
              <Button Grid.Row="4" Grid.Column="10" Classes="key mark" Height="30" Content="ũ" Click="OnKeyClick" />
              <Button Grid.Row="4" Grid.Column="11" Classes="key mark" Height="30" Content="ữ" Click="OnKeyClick" />
              <Button Grid.Row="4" Grid.Column="12" Classes="key mark" Height="30" Content="ỹ" Click="OnKeyClick" />

              <!-- Nặng -->
              <TextBlock Grid.Row="5" Grid.Column="0" Classes="kbgroup" Text="Nặng" />
              <Button Grid.Row="5" Grid.Column="1" Classes="key mark" Height="30" Content="ạ" Click="OnKeyClick" />
              <Button Grid.Row="5" Grid.Column="2" Classes="key mark" Height="30" Content="ặ" Click="OnKeyClick" />
              <Button Grid.Row="5" Grid.Column="3" Classes="key mark" Height="30" Content="ậ" Click="OnKeyClick" />
              <Button Grid.Row="5" Grid.Column="4" Classes="key mark" Height="30" Content="ẹ" Click="OnKeyClick" />
              <Button Grid.Row="5" Grid.Column="5" Classes="key mark" Height="30" Content="ệ" Click="OnKeyClick" />
              <Button Grid.Row="5" Grid.Column="6" Classes="key mark" Height="30" Content="ị" Click="OnKeyClick" />
              <Button Grid.Row="5" Grid.Column="7" Classes="key mark" Height="30" Content="ọ" Click="OnKeyClick" />
              <Button Grid.Row="5" Grid.Column="8" Classes="key mark" Height="30" Content="ộ" Click="OnKeyClick" />
              <Button Grid.Row="5" Grid.Column="9" Classes="key mark" Height="30" Content="ợ" Click="OnKeyClick" />
              <Button Grid.Row="5" Grid.Column="10" Classes="key mark" Height="30" Content="ụ" Click="OnKeyClick" />
              <Button Grid.Row="5" Grid.Column="11" Classes="key mark" Height="30" Content="ự" Click="OnKeyClick" />
              <Button Grid.Row="5" Grid.Column="12" Classes="key mark" Height="30" Content="ỵ" Click="OnKeyClick" />
            </Grid>
          </ScrollViewer>
        </Border>

        <!-- Hàng 5: ký tự đặc biệt + Space -->
        <Grid Grid.Row="5" ColumnDefinitions="*,*,*,*,*,6*" ColumnSpacing="5">
          <Button Grid.Column="0" Classes="key" Height="44" Content="." Click="OnKeyClick" />
          <Button Grid.Column="1" Classes="key" Height="44" Content="-" Click="OnKeyClick" />
          <Button Grid.Column="2" Classes="key" Height="44" Content="/" Click="OnKeyClick" />
          <Button Grid.Column="3" Classes="key" Height="44" Content="_" Click="OnKeyClick" />
          <Button Grid.Column="4" Classes="key" Height="44" Content="đ" Click="OnKeyClick" />
          <Button Grid.Column="5" Classes="key fn" Height="44" Click="OnSpaceClick" Content="Khoảng trắng" />
        </Grid>
      </Grid>

      <!-- ===== Bàn phím số (dạng máy POS) ===== -->
      <Grid Grid.Row="2" IsVisible="{Binding IsNumericLayout}"
            ColumnDefinitions="*,Auto" ColumnSpacing="8"
            HorizontalAlignment="Center" MaxWidth="560">

        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" MinWidth="320">
          <Grid Grid.Row="0" ColumnDefinitions="*,*,*" ColumnSpacing="6">
            <Button Grid.Column="0" Classes="key" Height="56" FontSize="22" Content="1" Click="OnKeyClick" />
            <Button Grid.Column="1" Classes="key" Height="56" FontSize="22" Content="2" Click="OnKeyClick" />
            <Button Grid.Column="2" Classes="key" Height="56" FontSize="22" Content="3" Click="OnKeyClick" />
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="6">
            <Button Grid.Column="0" Classes="key" Height="56" FontSize="22" Content="4" Click="OnKeyClick" />
            <Button Grid.Column="1" Classes="key" Height="56" FontSize="22" Content="5" Click="OnKeyClick" />
            <Button Grid.Column="2" Classes="key" Height="56" FontSize="22" Content="6" Click="OnKeyClick" />
          </Grid>
          <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="6">
            <Button Grid.Column="0" Classes="key" Height="56" FontSize="22" Content="7" Click="OnKeyClick" />
            <Button Grid.Column="1" Classes="key" Height="56" FontSize="22" Content="8" Click="OnKeyClick" />
            <Button Grid.Column="2" Classes="key" Height="56" FontSize="22" Content="9" Click="OnKeyClick" />
          </Grid>
          <Grid Grid.Row="3" ColumnDefinitions="*,*,*" ColumnSpacing="6">
            <Button Grid.Column="0" Classes="key" Height="56" FontSize="22" Content="0" Click="OnKeyClick" />
            <Button Grid.Column="1" Classes="key" Height="56" FontSize="22" Content="." Click="OnKeyClick" />
            <Button Grid.Column="2" Classes="key fn" Height="56" FontSize="20" Click="OnBackspaceClick" Content="⌫" />
          </Grid>
        </Grid>

        <!-- Cột phải: Space + Enter cao bằng bàn số -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="6" MinWidth="130">
          <Button Grid.Row="0" Classes="key fn" Height="56" Click="OnSpaceClick" Content="Khoảng trắng" />
          <Button Grid.Row="1" Classes="key enter" VerticalAlignment="Stretch" Click="OnEnterClick" Content="⏎ Nhập" />
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
