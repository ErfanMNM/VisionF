<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TanTienQR.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="360"
             x:Class="TanTienQR.Controls.VirtualKeyboard"
             x:DataType="vm:VirtualKeyboardViewModel">
    <!-- IsVisible được code-behind quản lý: bàn phím chỉ hiện trong đúng
         cửa sổ đang có ô nhập được focus (cửa sổ cha ẩn khi mở hộp thoại con). -->

  <UserControl.Styles>
    <!-- ===== Phím cơ bản =====
         Focusable=False để bấm phím KHÔNG cướp focus khỏi ô nhập — nếu không,
         bàn phím sẽ tự đóng ngay khi người dùng gõ ký tự đầu tiên. -->
    <Style Selector="Button.key">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="RenderTransform" Value="none" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.06" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.key /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BgPanel}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
      <Setter Property="BorderThickness" Value="1,1,1,2" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BoxShadow" Value="0 1 3 0 #14000000" />
    </Style>
    <Style Selector="Button.key:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>
    <!-- Hiệu ứng nhấn: phím lún nhẹ + đổi màu -->
    <Style Selector="Button.key:pressed">
      <Setter Property="RenderTransform" Value="scale(0.95)" />
    </Style>
    <Style Selector="Button.key:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="BoxShadow" Value="none" />
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>

    <!-- ===== Phím chức năng (Shift, Backspace, Space, 123...) ===== -->
    <Style Selector="Button.key.fn">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>
    <Style Selector="Button.key.fn /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BgRaised}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
    </Style>
    <Style Selector="Button.key.fn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="Button.key.fn:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>

    <!-- ===== Phím Enter nổi bật ===== -->
    <Style Selector="Button.key.enter">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.key.enter /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="BoxShadow" Value="0 2 6 0 #33000000" />
    </Style>
    <Style Selector="Button.key.enter:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.9" />
      <Setter Property="Background" Value="{StaticResource Accent}" />
    </Style>

    <!-- ===== Phím Shift đang bật ===== -->
    <Style Selector="Button.key.active">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.key.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>

    <!-- ===== Phím dấu tiếng Việt: gọn, nền nhạt ===== -->
    <Style Selector="Button.key.mark">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="Margin" Value="1.5" />
    </Style>
    <Style Selector="Button.key.mark /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineAccent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Button.key.mark:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BgPanel}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="Button.key.mark:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent}" />
    </Style>

    <!-- ===== Nút nhỏ trên thanh trên cùng (dạng "pill") ===== -->
    <Style Selector="Button.key.pill">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.key.pill /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
  </UserControl.Styles>

  <!-- Khung ngoài: bo góc phía trên + đổ bóng nhẹ để nổi lên khỏi nội dung -->
  <Border Background="{StaticResource BgRaised}"
          BorderBrush="{StaticResource LineColor}"
          BorderThickness="0,1,0,0"
          CornerRadius="16,16,0,0"
          BoxShadow="0 -4 16 0 #1A000000"
          Padding="12,8,12,12">

    <Grid RowDefinitions="Auto,Auto" RowSpacing="8">

      <!-- ===== Thanh trên: gợi ý ô đang nhập + nút chức năng ===== -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="2,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="26" Height="26" CornerRadius="13"
                  Background="{StaticResource AccentSoft}">
            <Path Width="12" Height="12"
                  Stretch="Uniform"
                  Stroke="{StaticResource Accent}"
                  StrokeThickness="2"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Data="M2,12 L2,6 M2,6 L7,2 L12,6 L12,12 Z" />
          </Border>
          <TextBlock VerticalAlignment="Center"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextMuted}"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding TargetHint}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <Button Classes="key fn pill"
                  Height="32" MinWidth="64"
                  Click="OnLayoutClick"
                  Content="123 / ABC" />
          <Button Classes="key fn pill"
                  Height="32" MinWidth="80"
                  Click="OnClearClick"
                  Content="Xoá hết" />
          <Button Classes="key fn pill"
                  Height="32" Width="40"
                  Click="OnCloseClick"
                  Content="✕" />
        </StackPanel>
      </Grid>

      <!-- ===== Bàn phím chữ ===== -->
      <Grid Grid.Row="1" IsVisible="{Binding IsAlphaLayout}"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="5">

        <!-- Hàng số -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*,*,*,*,*,*,*" ColumnSpacing="5">
          <Button Grid.Column="0" Classes="key" Height="42" Content="1" Click="OnKeyClick" />
          <Button Grid.Column="1" Classes="key" Height="42" Content="2" Click="OnKeyClick" />
          <Button Grid.Column="2" Classes="key" Height="42" Content="3" Click="OnKeyClick" />
          <Button Grid.Column="3" Classes="key" Height="42" Content="4" Click="OnKeyClick" />
          <Button Grid.Column="4" Classes="key" Height="42" Content="5" Click="OnKeyClick" />
          <Button Grid.Column="5" Classes="key" Height="42" Content="6" Click="OnKeyClick" />
          <Button Grid.Column="6" Classes="key" Height="42" Content="7" Click="OnKeyClick" />
          <Button Grid.Column="7" Classes="key" Height="42" Content="8" Click="OnKeyClick" />
          <Button Grid.Column="8" Classes="key" Height="42" Content="9" Click="OnKeyClick" />
          <Button Grid.Column="9" Classes="key" Height="42" Content="0" Click="OnKeyClick" />
        </Grid>

        <!-- Hàng 1: QWERTY -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*,*,*,*,*,*" ColumnSpacing="5">
          <Button Grid.Column="0" Classes="key" Height="48" Content="Q" Click="OnKeyClick" />
          <Button Grid.Column="1" Classes="key" Height="48" Content="W" Click="OnKeyClick" />
          <Button Grid.Column="2" Classes="key" Height="48" Content="E" Click="OnKeyClick" />
          <Button Grid.Column="3" Classes="key" Height="48" Content="R" Click="OnKeyClick" />
          <Button Grid.Column="4" Classes="key" Height="48" Content="T" Click="OnKeyClick" />
          <Button Grid.Column="5" Classes="key" Height="48" Content="Y" Click="OnKeyClick" />
          <Button Grid.Column="6" Classes="key" Height="48" Content="U" Click="OnKeyClick" />
          <Button Grid.Column="7" Classes="key" Height="48" Content="I" Click="OnKeyClick" />
          <Button Grid.Column="8" Classes="key" Height="48" Content="O" Click="OnKeyClick" />
          <Button Grid.Column="9" Classes="key" Height="48" Content="P" Click="OnKeyClick" />
        </Grid>

        <!-- Hàng 2: ASDF + Enter (10 cột: 9 chữ + Enter) -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*,*,*,*,*,*,*" ColumnSpacing="5">
          <Button Grid.Column="0" Classes="key" Height="48" Content="A" Click="OnKeyClick" />
          <Button Grid.Column="1" Classes="key" Height="48" Content="S" Click="OnKeyClick" />
          <Button Grid.Column="2" Classes="key" Height="48" Content="D" Click="OnKeyClick" />
          <Button Grid.Column="3" Classes="key" Height="48" Content="F" Click="OnKeyClick" />
          <Button Grid.Column="4" Classes="key" Height="48" Content="G" Click="OnKeyClick" />
          <Button Grid.Column="5" Classes="key" Height="48" Content="H" Click="OnKeyClick" />
          <Button Grid.Column="6" Classes="key" Height="48" Content="J" Click="OnKeyClick" />
          <Button Grid.Column="7" Classes="key" Height="48" Content="K" Click="OnKeyClick" />
          <Button Grid.Column="8" Classes="key" Height="48" Content="L" Click="OnKeyClick" />
          <Button Grid.Column="9" Classes="key enter" Height="48" Click="OnEnterClick" Content="⏎" />
        </Grid>

        <!-- Hàng 3: Shift + ZXCV + Backspace -->
        <Grid Grid.Row="3" ColumnDefinitions="1.5*,*,*,*,*,*,*,*,1.5*" ColumnSpacing="5">
          <Button Grid.Column="0"
                  x:Name="ShiftButton"
                  Classes="key fn"
                  Height="48"
                  Click="OnShiftClick"
                  FontSize="20"
                  Content="⇧" />
          <Button Grid.Column="1" Classes="key" Height="48" Content="Z" Click="OnKeyClick" />
          <Button Grid.Column="2" Classes="key" Height="48" Content="X" Click="OnKeyClick" />
          <Button Grid.Column="3" Classes="key" Height="48" Content="C" Click="OnKeyClick" />
          <Button Grid.Column="4" Classes="key" Height="48" Content="V" Click="OnKeyClick" />
          <Button Grid.Column="5" Classes="key" Height="48" Content="B" Click="OnKeyClick" />
          <Button Grid.Column="6" Classes="key" Height="48" Content="N" Click="OnKeyClick" />
          <Button Grid.Column="7" Classes="key" Height="48" Content="M" Click="OnKeyClick" />
          <Button Grid.Column="8" Classes="key fn" Height="48" Click="OnBackspaceClick" FontSize="20" Content="⌫" />
        </Grid>

        <!-- Hàng 4: phím tổ hợp tiếng Việt (3 hàng x 15 cột, đều nhau) -->
        <Border Grid.Row="4"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource LineColor}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="4,3">
          <UniformGrid Columns="15">
            <Button Classes="key mark" Height="34" Content="ă" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="â" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ê" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ô" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="đ" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ơ" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ư" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="à" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="á" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ả" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ã" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ạ" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ằ" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ắ" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ẳ" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ẵ" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ặ" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ầ" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ấ" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ẩ" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ẫ" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ậ" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ề" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ế" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ể" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ễ" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ệ" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ỉ" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ị" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ọ" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ỏ" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ố" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ổ" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ỗ" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ộ" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ờ" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ớ" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ở" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ỡ" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ợ" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ừ" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ứ" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ử" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ữ" Click="OnKeyClick" />
            <Button Classes="key mark" Height="34" Content="ự" Click="OnKeyClick" />
          </UniformGrid>
        </Border>

        <!-- Hàng 5: ký tự đặc biệt + Space -->
        <Grid Grid.Row="5" ColumnDefinitions="*,*,*,*,6*" ColumnSpacing="5">
          <Button Grid.Column="0" Classes="key" Height="44" Content="." Click="OnKeyClick" />
          <Button Grid.Column="1" Classes="key" Height="44" Content="-" Click="OnKeyClick" />
          <Button Grid.Column="2" Classes="key" Height="44" Content="/" Click="OnKeyClick" />
          <Button Grid.Column="3" Classes="key" Height="44" Content="_" Click="OnKeyClick" />
          <Button Grid.Column="4" Classes="key fn" Height="44" Click="OnSpaceClick" Content="Khoảng trắng" />
        </Grid>
      </Grid>

      <!-- ===== Bàn phím số (dạng máy POS) ===== -->
      <Grid Grid.Row="1" IsVisible="{Binding IsNumericLayout}"
            ColumnDefinitions="*,Auto" ColumnSpacing="8"
            HorizontalAlignment="Center" MaxWidth="560">

        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" MinWidth="320">
          <Grid Grid.Row="0" ColumnDefinitions="*,*,*" ColumnSpacing="6">
            <Button Grid.Column="0" Classes="key" Height="56" FontSize="22" Content="1" Click="OnKeyClick" />
            <Button Grid.Column="1" Classes="key" Height="56" FontSize="22" Content="2" Click="OnKeyClick" />
            <Button Grid.Column="2" Classes="key" Height="56" FontSize="22" Content="3" Click="OnKeyClick" />
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="6">
            <Button Grid.Column="0" Classes="key" Height="56" FontSize="22" Content="4" Click="OnKeyClick" />
            <Button Grid.Column="1" Classes="key" Height="56" FontSize="22" Content="5" Click="OnKeyClick" />
            <Button Grid.Column="2" Classes="key" Height="56" FontSize="22" Content="6" Click="OnKeyClick" />
          </Grid>
          <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="6">
            <Button Grid.Column="0" Classes="key" Height="56" FontSize="22" Content="7" Click="OnKeyClick" />
            <Button Grid.Column="1" Classes="key" Height="56" FontSize="22" Content="8" Click="OnKeyClick" />
            <Button Grid.Column="2" Classes="key" Height="56" FontSize="22" Content="9" Click="OnKeyClick" />
          </Grid>
          <Grid Grid.Row="3" ColumnDefinitions="*,*,*" ColumnSpacing="6">
            <Button Grid.Column="0" Classes="key" Height="56" FontSize="22" Content="0" Click="OnKeyClick" />
            <Button Grid.Column="1" Classes="key" Height="56" FontSize="22" Content="." Click="OnKeyClick" />
            <Button Grid.Column="2" Classes="key fn" Height="56" FontSize="20" Click="OnBackspaceClick" Content="⌫" />
          </Grid>
        </Grid>

        <!-- Cột phải: Space + Enter cao bằng bàn số -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="6" MinWidth="130">
          <Button Grid.Row="0" Classes="key fn" Height="56" Click="OnSpaceClick" Content="Khoảng trắng" />
          <Button Grid.Row="1" Classes="key enter" VerticalAlignment="Stretch" Click="OnEnterClick" Content="⏎ Nhập" />
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
