<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TanTienQR.App"
             xmlns:local="using:TanTienQR"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <!-- Bo icon SVG dung chung (Controls/Icons.axaml) -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://TanTienQR/Controls/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Bang mau phong cach Google 2026: nen sang, xanh duong primary
                 (theo logo cong ty Tan Tien). -->
            <SolidColorBrush x:Key="BgBase">#F6F9FB</SolidColorBrush>
            <SolidColorBrush x:Key="BgPanel">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="BgRaised">#EDF4F7</SolidColorBrush>
            <SolidColorBrush x:Key="LineColor">#D8E6EC</SolidColorBrush>
            <SolidColorBrush x:Key="TextPrimary">#0F2A38</SolidColorBrush>
            <SolidColorBrush x:Key="TextMuted">#5C7683</SolidColorBrush>
            <SolidColorBrush x:Key="Accent">#1A56DB</SolidColorBrush>
            <SolidColorBrush x:Key="AccentSoft">#DCE7FD</SolidColorBrush>
            <SolidColorBrush x:Key="Ok">#12A150</SolidColorBrush>
            <SolidColorBrush x:Key="OkSoft">#DFF6E7</SolidColorBrush>
            <SolidColorBrush x:Key="Warn">#E08600</SolidColorBrush>
            <SolidColorBrush x:Key="WarnSoft">#FFF3DC</SolidColorBrush>
            <SolidColorBrush x:Key="Danger">#D93025</SolidColorBrush>
            <SolidColorBrush x:Key="DangerSoft">#FCE8E6</SolidColorBrush>
            <SolidColorBrush x:Key="Idle">#708494</SolidColorBrush>
            <SolidColorBrush x:Key="IdleSoft">#E7EDF1</SolidColorBrush>
            <SolidColorBrush x:Key="LineDanger">#F5C6C2</SolidColorBrush>
            <SolidColorBrush x:Key="LineWarn">#F5D9A8</SolidColorBrush>
            <SolidColorBrush x:Key="LineOk">#A8E0BE</SolidColorBrush>
            <SolidColorBrush x:Key="LineAccent">#A9C4F5</SolidColorBrush>

            <!-- Font: Space Grotesk cho UI (khớp mẫu Dashboard 4),
                 JetBrains Mono cho số liệu / mã đơn / đồng hồ.
                 Cả hai đều nhúng trong app (Assets/Fonts) -> không cần cài
                 font vào máy, chạy được trên máy khách không có font.
                 Inter là fallback cho ký tự không có trong font chính. -->
            <FontFamily x:Key="UiFont">Space Grotesk, Inter, Segoe UI</FontFamily>
            <FontFamily x:Key="MonoFont">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>

            <!-- Bo goc dung chung (mẫu Dashboard 4 dung 16px cho card lon) -->
            <CornerRadius x:Key="RadiusCard">16</CornerRadius>
            <CornerRadius x:Key="RadiusSmall">14</CornerRadius>
            <CornerRadius x:Key="RadiusField">10</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- ===== Nen tang ===== -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Background" Value="{StaticResource BgBase}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <!-- UserControl: ke thua font UI de moi manh dong nhat -->
        <Style Selector="UserControl">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <!-- ===== Van ban ===== -->
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        </Style>
        <Style Selector="TextBlock.kpiValue">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.unit">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="TextBlock.reading">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- ===== Khung panel ===== -->
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{StaticResource BgPanel}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="Border.kpi">
            <Setter Property="Background" Value="{StaticResource BgPanel}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16,14" />
        </Style>

        <!-- Nhan uppercase kieu mau: 11px, letter-spacing 0.12em -->
        <Style Selector="TextBlock.overline">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.12" />
        </Style>

        <!-- Segment thanh tien trinh: 24 o bo goc 2px -->
        <Style Selector="Border.segment">
            <Setter Property="Height" Value="12" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{StaticResource LineColor}" />
        </Style>
        <Style Selector="Border.segment.on">
            <Setter Property="Background" Value="{StaticResource Accent}" />
        </Style>

        <!-- Dong moc thoi gian: border-top 1px (mau mau dung dashed) -->
        <Style Selector="Border.dashedRow">
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>

        <!-- ===== Tab thanh duoi header: cao 44px, gach chan 3px khi active ===== -->
        <Style Selector="Button.tabbar">
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tabbar /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,3" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <Style Selector="Button.tabbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BgRaised}" />
        </Style>
        <Style Selector="Button.tabbar:pointerover TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="Button.tabbar.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Button.tabbar.active TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Button.tabbar Path.icon">
            <Setter Property="Stroke" Value="{StaticResource TextMuted}" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="1.9" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
        <Style Selector="Button.tabbar.active Path.icon">
            <Setter Property="Stroke" Value="{StaticResource Accent}" />
        </Style>

        <!-- ===== Nút hamburger + hàng trong menu cửa sổ (custom chrome, popup tự vẽ) ===== -->
        <Style Selector="Button.windowmenu">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Background" Value="{StaticResource BgRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.windowmenu Path">
            <Setter Property="Stroke" Value="{StaticResource TextPrimary}" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>
        <Style Selector="Button.windowmenu /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BgRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="17" />
        </Style>
        <Style Selector="Button.windowmenu:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BgPanel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Button.windowmenu:pointerover Path">
            <Setter Property="Stroke" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="Button.menubtn">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.menubtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style Selector="Button.menubtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BgRaised}" />
        </Style>
        <Style Selector="Button.menubtn.danger TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Danger}" />
        </Style>

        <!-- ===== Field / thanh bo loc ===== -->
        <Style Selector="Border.filterBar">
            <Setter Property="Background" Value="{StaticResource BgPanel}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="Border.iconBadge">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
        </Style>
        <Style Selector="Border.iconBadge Path">
            <Setter Property="Stroke" Value="{StaticResource Accent}" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- O nhap trong thanh bo loc: vien nhat, bo goc mem, hover len vien accent -->
        <Style Selector="TextBox.field">
            <Setter Property="Background" Value="{StaticResource BgPanel}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <!-- Canh giữa theo chiều dọc: mặc định của Avalonia là Top ->
                 chữ nằm lệch lên trên, lệch với placeholder / icon bên trong ô. -->
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource LineAccent}" />
        </Style>
        <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="TextBox.field /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource BgPanel}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="ComboBox.field">
            <Setter Property="Background" Value="{StaticResource BgPanel}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <!-- Canh giữa theo chiều dọc (mặc định Avalonia là Top -> lệch). -->
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox.field /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource BgPanel}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="ComboBox.field:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource LineAccent}" />
        </Style>
        <Style Selector="ComboBox.field:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style Selector="DatePicker.field">
            <Setter Property="Background" Value="{StaticResource BgPanel}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style Selector="CalendarDatePicker.field">
            <Setter Property="Background" Value="{StaticResource BgPanel}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Watermark" Value="Chọn ngày" />
        </Style>
        <Style Selector="CalendarDatePicker.field /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource BgPanel}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="CalendarDatePicker.field:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource LineAccent}" />
        </Style>
        <Style Selector="CalendarDatePicker.field TextBlock#PART_TextPresenter">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style Selector="CalendarDatePicker.field TextBlock#PART_Placeholder">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>

        <!-- Nut chinh (accent) trong thanh bo loc -->
        <Style Selector="Button.primary">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#2563EB" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1747B0" />
            <Setter Property="BorderBrush" Value="#1747B0" />
        </Style>
        <Style Selector="Button.primary TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Nut phu trong thanh bo loc -->
        <Style Selector="Button.soft">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{StaticResource BgRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="Button.soft /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BgRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <!-- Nút trắng viền xám (giống mẫu: Tải PO / Hoàn tất) -->
        <Style Selector="Button.whitebtn">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{StaticResource BgPanel}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="Button.whitebtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BgPanel}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.whitebtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BgPanel}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineAccent}" />
        </Style>
        <Style Selector="Button.whitebtn:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
        </Style>
        <Style Selector="Button.whitebtn:disabled TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>
        <Style Selector="Button.whitebtn:disabled Path">
            <Setter Property="Stroke" Value="{StaticResource TextMuted}" />
        </Style>
        <!-- Nút trắng chữ đỏ (Huỷ PO) -->
        <Style Selector="Button.whitebtn.danger TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Danger}" />
        </Style>
        <Style Selector="Button.whitebtn.danger Path">
            <Setter Property="Stroke" Value="{StaticResource Danger}" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>
        <Style Selector="Button.whitebtn.danger:disabled TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>
        <Style Selector="Button.whitebtn.danger:disabled Path">
            <Setter Property="Stroke" Value="{StaticResource TextMuted}" />
        </Style>
        <!-- Chữ trong nút cam Bắt đầu luôn đen (kể cả icon Play) -->
        <Style Selector="Button.startbtn Path">
            <Setter Property="Fill" Value="#1A1A1A" />
            <Setter Property="Stroke" Value="Transparent" />
        </Style>
        <!-- Nút cam Bắt đầu (giống mẫu Dashboard 4) -->
        <Style Selector="Button.startbtn">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="#F5A623" />
            <Setter Property="BorderBrush" Value="#F5A623" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1A1A1A" />
        </Style>
        <Style Selector="Button.startbtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F5A623" />
            <Setter Property="BorderBrush" Value="#F5A623" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.startbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FBBF24" />
            <Setter Property="BorderBrush" Value="#FBBF24" />
        </Style>
        <Style Selector="Button.startbtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D97706" />
            <Setter Property="BorderBrush" Value="#D97706" />
        </Style>
        <Style Selector="Button.startbtn TextBlock">
            <Setter Property="Foreground" Value="#1A1A1A" />
        </Style>
        <Style Selector="Button.startbtn:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#EDEFF2" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
        </Style>
        <Style Selector="Button.startbtn:disabled TextBlock">
            <Setter Property="Foreground" Value="#9AA8B2" />
        </Style>
        <Style Selector="Button.startbtn:disabled Path">
            <Setter Property="Fill" Value="#9AA8B2" />
            <Setter Property="Stroke" Value="Transparent" />
        </Style>

        <!-- ===== Nut co icon + chu (canh giua chuẩn) =====
             Dung chung cho moi nut dang "icon + nhan" de tranh viec
             icon lech chu / nut lech nhau do kich thuoc icon khac nhau.
             - Path luon 16x16, canh giua theo chiều dọc
             - StackPanel ben trong canh giua theo ca 2 chieu
             - Chieu cao co dinh 44px cho dong nut dong hang
             -->
        <Style Selector="Button.iconbtn">
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.iconbtn StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="7" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.iconbtn Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.iconbtn TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.soft:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BgPanel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>

        <!-- ===== Chip / nut thao tac ===== -->
        <Style Selector="Button.chip">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{StaticResource BgRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BgRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Button.chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
        </Style>

        <!-- ===== Badge trang thai (co vien theo trang thai) ===== -->
        <Style Selector="Border.badge">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource IdleSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="Border.badge TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Idle}" />
        </Style>
        <Style Selector="Border.badge.running">
            <Setter Property="Background" Value="{StaticResource OkSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineOk}" />
        </Style>
        <Style Selector="Border.badge.running TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ok}" />
        </Style>
        <Style Selector="Border.badge.warning">
            <Setter Property="Background" Value="{StaticResource WarnSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineWarn}" />
        </Style>
        <Style Selector="Border.badge.warning TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Warn}" />
        </Style>
        <Style Selector="Border.badge.fault">
            <Setter Property="Background" Value="{StaticResource DangerSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineDanger}" />
        </Style>
        <Style Selector="Border.badge.fault TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Danger}" />
        </Style>
        <!-- Badge vai trò Quản trị (accent teal) -->
        <Style Selector="Border.badge.accent">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineAccent}" />
        </Style>
        <Style Selector="Border.badge.accent TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
        <!-- Badge vai trò Lập trình viên (tím) -->
        <Style Selector="Border.badge.developer">
            <Setter Property="Background" Value="#F0E6FF" />
            <Setter Property="BorderBrush" Value="#CDB4F5" />
        </Style>
        <Style Selector="Border.badge.developer TextBlock">
            <Setter Property="Foreground" Value="#6B37C9" />
        </Style>

        <!-- ===== The thiet bi (sidebar) ===== -->
        <Style Selector="Border.device">
            <Setter Property="Background" Value="{StaticResource BgRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="9" />
        </Style>

        <!-- Card thiet bi: vien theo trang thai ket noi -->
        <Style Selector="Border.deviceCard">
            <Setter Property="Background" Value="{StaticResource BgPanel}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="Border.deviceCard.ok">
            <Setter Property="BorderBrush" Value="{StaticResource LineOk}" />
            <Setter Property="Background" Value="{StaticResource OkSoft}" />
        </Style>
        <Style Selector="Border.deviceCard.fault">
            <Setter Property="BorderBrush" Value="{StaticResource LineDanger}" />
            <Setter Property="Background" Value="{StaticResource DangerSoft}" />
        </Style>
        <Style Selector="Border.deviceCard.warn">
            <Setter Property="BorderBrush" Value="{StaticResource LineWarn}" />
            <Setter Property="Background" Value="{StaticResource WarnSoft}" />
        </Style>
        <Style Selector="Border.deviceCard TextBlock.deviceTitle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="Border.deviceCard TextBlock.deviceStatus">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>

        <!-- ===== LED trang thai ===== -->
        <Style Selector="Ellipse.led">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Fill" Value="{StaticResource Idle}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Ellipse.led.on">
            <Setter Property="Fill" Value="{StaticResource Ok}" />
        </Style>
        <Style Selector="Ellipse.led.off">
            <Setter Property="Fill" Value="{StaticResource Danger}" />
        </Style>
        <Style Selector="Ellipse.led.warn">
            <Setter Property="Fill" Value="{StaticResource Warn}" />
        </Style>

        <!-- Halos LED: vong sang mo quanh LED de tach biet khi mat ket noi -->
        <Style Selector="Ellipse.ledHalo">
            <Setter Property="Width" Value="11" />
            <Setter Property="Height" Value="11" />
            <Setter Property="Fill" Value="{StaticResource Danger}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Ellipse.ledHalo.warn">
            <Setter Property="Fill" Value="{StaticResource Warn}" />
        </Style>

        <!-- LED chop chop khi mat ket noi (reconnecting) -->
        <Style Selector="Ellipse.led.blink">
            <Style.Animations>
                <Animation Duration="0:0:0.55">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.15" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Halo chop chop khi mat ket noi -->
        <Style Selector="Ellipse.ledHalo.blink">
            <Style.Animations>
                <Animation Duration="0:0:1.1">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.55" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.55" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Vien card chop chop khi mat ket noi -->
        <Style Selector="Border.deviceCard.blink">
            <Style.Animations>
                <Animation Duration="0:0:1.1">
                    <KeyFrame Cue="0%">
                        <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.deviceCard.warn.blink">
            <Style.Animations>
                <Animation Duration="0:0:1.1">
                    <KeyFrame Cue="0%">
                        <Setter Property="BorderBrush" Value="{StaticResource Warn}" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="BorderBrush" Value="{StaticResource Warn}" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ===== Su kien ===== -->
        <Style Selector="Border.event">
            <Setter Property="Background" Value="{StaticResource BgRaised}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style Selector="Border.stripe">
            <Setter Property="Width" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Border.stripe.warning">
            <Setter Property="Background" Value="{StaticResource Warn}" />
        </Style>
        <Style Selector="Border.stripe.critical">
            <Setter Property="Background" Value="{StaticResource Danger}" />
        </Style>

        <!-- ===== Pill o thanh tieu de ===== -->
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Background" Value="{StaticResource BgRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.pill TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>
        <Style Selector="Border.pill.ok TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ok}" />
        </Style>
        <Style Selector="Border.pill.warn TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Warn}" />
        </Style>
        <Style Selector="Border.pill.danger TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Danger}" />
        </Style>
    </Application.Styles>
</Application>
