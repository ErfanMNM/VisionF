{
  "Camera": {
    "Ip": "127.0.0.1",
    "Port": 9000,
    "DuplicateWindowSeconds": 30
  },
  "Plc": {
    "Ip": "127.0.0.1",
    "Port": 9600,
    "RemoteNode": 0,
    "LocalNode": 1,
    "TimeoutMs": 1000,
    "Retries": 0,
    "ResultAddress": "D12",
    "ReadyAddress": "D16",
    "RefreshIntervalMs": 1000
  },
  "Web": {
    "Url": "https://estrace.checkee.vn",
    "Enabled": true
  },
  "Scanner": {
    "Enabled": true,
    "Mode": "TcpServer",
    "TcpHost": "127.0.0.1",
    "TcpPort": 6999,
    "ComPort": "COM3",
    "BaudRate": 9600
  },
  "Logging": {
    "Sqlite": {
      "Path": "logs/app.db",
      "MinLevel": "Information",
      "RetentionDays": 30,
      "EnableUserActions": true,
      "BatchSize": 100,
      "FlushIntervalMs": 1000,
      "PruneIntervalMs": 3600000
    },
    "History": {
      "Enabled": true,
      "PageSize": 200
    }
  },
  "Auth": {
    "DbPath": "logs/users.db",
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 5,
    "Pbkdf2Iterations": 210000,
    "SeedAdminUser": "admin",
    "SeedAdminPassword": "admin"
  },
  "PlcSettings": {
    "DbPath": "logs/plc.db"
  },
  "Scans": {
    "DbPath": "logs/scans.db",
    "BatchSize": 100,
    "FlushIntervalMs": 1000,
    "QueueCapacity": 20000,
    "RetentionDays": 0,
    "PruneIntervalMs": 3600000
  },
  "Po": {
    "BaseUrl": "http://127.0.0.1:5080",
    "DbRoot": "logs/po",
    "ActivationIntervalMs": 2500,
    "AutoActivate": true,
    "CodeSampleSize": 100
  }
