{
  "Camera": {
    "Ip": "127.0.0.1",
    "Port": 9000,
    "DuplicateWindowSeconds": 30
  },
  "Plc": {
    "Ip": "192.168.1.10",
    "Port": 9600,
    "RemoteNode": 0,
    "LocalNode": 1,
    "TimeoutMs": 1000,
    "Retries": 0,
    "ResultAddress": "D12",
    "ReadyAddress": "D16",
    "RefreshIntervalMs": 1000
  },
  "Web": {
    "Url": "https://estrace.checkee.vn",
    "Enabled": true
  },
  "Logging": {
    "Sqlite": {
      "Path": "logs/app.db",
      "MinLevel": "Information",
      "RetentionDays": 30,
      "EnableUserActions": true,
      "BatchSize": 100,
      "FlushIntervalMs": 1000,
      "PruneIntervalMs": 3600000
    },
    "History": {
      "Enabled": true,
      "PageSize": 200
    }
  }
}
