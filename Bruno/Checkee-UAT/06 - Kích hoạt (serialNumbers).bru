meta {
  name: 06 - Kích hoạt (serialNumbers)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/middleware-api/CTEs/active
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
  x-api-key: {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "GTIN": "{{gtin}}",
    "batchCode": "{{batchCode}}",
    "type": "{{serialType}}",
    "serialNumbers": [
      "{{serialNumber}}"
    ],
    "fromIndex": 0,
    "toIndex": 0
  }
}

vars:pre-request {
  gtin: 8935348800215
  batchCode: A001
  serialType: RANDOM
  serialNumber: TFauMPq0Hl
  apiKey: bf566fe2-f8e0-4d2e-925f-155f17fc82a6
}

tests {
  test("Activation response contains a Checkee envelope", function() {
    expect(res.body).to.have.property("status");
    expect(res.body).to.have.property("message");
  });
}
