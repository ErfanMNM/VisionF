meta {
  name: 06 - Kích hoạt (serialNumbers)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/middleware-api/CTEs/active
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
  x-api-key: {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "GTIN": "{{gtin}}",
    "batchCode": "{{batchCode}}",
    "type": "{{serialType}}",
    "serialNumbers": ["{{serialNumber}}"]
  }
}

