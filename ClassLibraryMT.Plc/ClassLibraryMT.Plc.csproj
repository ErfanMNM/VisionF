<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>ClassLibraryMT.Plc</RootNamespace>
    <AssemblyName>ClassLibraryMT.Plc</AssemblyName>
    <!-- Sinh XML doc cho toan bo public API. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- ADO.NET thuan (khong EF/Dapper) de giu AOT-compatible va nhe. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- ClassLibraryMT: dung OmronPlc de doc/ghi o nho vung D.
         ClassLibraryMT.Logging: ghi nhat ky thao tac nguoi dung. -->
    <ProjectReference Include="..\ClassLibraryMT\ClassLibraryMT.csproj" />
    <ProjectReference Include="..\ClassLibraryMT.Logging\ClassLibraryMT.Logging.csproj" />
  </ItemGroup>

</Project>
