<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="T8T.App"
             xmlns:local="using:T8T"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <!-- Bảng màu công nghiệp: nền than xanh, nhấn cyan, trạng thái xanh/vàng/đỏ -->
            <SolidColorBrush x:Key="BgBase">#F3F7FA</SolidColorBrush>
            <SolidColorBrush x:Key="BgPanel">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="BgRaised">#EAF1F5</SolidColorBrush>
            <SolidColorBrush x:Key="LineColor">#D5E0E8</SolidColorBrush>
            <SolidColorBrush x:Key="TextPrimary">#172B3A</SolidColorBrush>
            <SolidColorBrush x:Key="TextMuted">#657887</SolidColorBrush>
            <SolidColorBrush x:Key="Accent">#0891B2</SolidColorBrush>
            <SolidColorBrush x:Key="AccentSoft">#D9F4F8</SolidColorBrush>
            <SolidColorBrush x:Key="Ok">#16865D</SolidColorBrush>
            <SolidColorBrush x:Key="OkSoft">#DDF6EA</SolidColorBrush>
            <SolidColorBrush x:Key="Warn">#B77908</SolidColorBrush>
            <SolidColorBrush x:Key="WarnSoft">#FFF3D4</SolidColorBrush>
            <SolidColorBrush x:Key="Danger">#C33D4A</SolidColorBrush>
            <SolidColorBrush x:Key="DangerSoft">#FDE4E7</SolidColorBrush>
            <SolidColorBrush x:Key="Idle">#708494</SolidColorBrush>
            <SolidColorBrush x:Key="IdleSoft">#E7EDF1</SolidColorBrush>

            <FontFamily x:Key="UiFont">Bahnschrift, Segoe UI, Inter</FontFamily>
            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- ===== Nền tảng ===== -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Background" Value="{StaticResource BgBase}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <!-- ===== Văn bản ===== -->
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        </Style>
        <Style Selector="TextBlock.kpiValue">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.unit">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="TextBlock.delta">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Danger}" />
        </Style>
        <Style Selector="TextBlock.delta.good">
            <Setter Property="Foreground" Value="{StaticResource Ok}" />
        </Style>
        <Style Selector="TextBlock.reading">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- ===== Khung panel ===== -->
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{StaticResource BgPanel}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <!-- ===== Điều hướng sidebar ===== -->
        <Style Selector="Button.nav">
            <Setter Property="Width" Value="76" />
            <Setter Property="Height" Value="76" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.nav Path.icon">
            <Setter Property="Stroke" Value="{StaticResource TextMuted}" />
        </Style>
        <Style Selector="Button.nav TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BgRaised}" />
        </Style>
        <Style Selector="Button.nav:pointerover Path.icon">
            <Setter Property="Stroke" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="Button.nav:pointerover TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
        </Style>
        <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
        </Style>
        <Style Selector="Button.nav.active Path.icon">
            <Setter Property="Stroke" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Button.nav.active TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>

        <!-- ===== Chip / nút thao tác (vùng chạm tối thiểu 44px) ===== -->
        <Style Selector="Button.chip">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{StaticResource BgRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BgRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="Button.chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
        </Style>
        <Style Selector="Button.chip.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Button.chip.confirm /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource WarnSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource Warn}" />
            <Setter Property="Foreground" Value="{StaticResource Warn}" />
        </Style>
        <Style Selector="Button.chip.small">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- ===== Badge trạng thái ===== -->
        <Style Selector="Border.badge">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource IdleSoft}" />
        </Style>
        <Style Selector="Border.badge TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Idle}" />
        </Style>
        <Style Selector="Border.badge.running">
            <Setter Property="Background" Value="{StaticResource OkSoft}" />
        </Style>
        <Style Selector="Border.badge.running TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ok}" />
        </Style>
        <Style Selector="Border.badge.warning">
            <Setter Property="Background" Value="{StaticResource WarnSoft}" />
        </Style>
        <Style Selector="Border.badge.warning TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Warn}" />
        </Style>
        <Style Selector="Border.badge.fault">
            <Setter Property="Background" Value="{StaticResource DangerSoft}" />
        </Style>
        <Style Selector="Border.badge.fault TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Danger}" />
        </Style>

        <!-- ===== Thẻ máy ===== -->
        <Style Selector="Border.machine">
            <Setter Property="Background" Value="{StaticResource BgRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="9" />
        </Style>
        <Style Selector="Border.machine.warning">
            <Setter Property="BorderBrush" Value="{StaticResource Warn}" />
        </Style>
        <Style Selector="Border.machine.fault">
            <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
        </Style>
        <Style Selector="Border.machine.idle">
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <!-- ===== Thanh tải / chỉ số ===== -->
        <Style Selector="ProgressBar.load">
            <Setter Property="Height" Value="6" />
            <Setter Property="MinHeight" Value="6" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{StaticResource LineColor}" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="ProgressBar.load.warning">
            <Setter Property="Foreground" Value="{StaticResource Warn}" />
        </Style>
        <Style Selector="ProgressBar.load.fault">
            <Setter Property="Foreground" Value="{StaticResource Danger}" />
        </Style>
        <Style Selector="ProgressBar.load.idle">
            <Setter Property="Foreground" Value="{StaticResource Idle}" />
        </Style>
        <Style Selector="ProgressBar.metric">
            <Setter Property="Height" Value="8" />
            <Setter Property="MinHeight" Value="8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{StaticResource LineColor}" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>

        <!-- ===== Biểu đồ cột ===== -->
        <Style Selector="Border.bar">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="CornerRadius" Value="6,6,0,0" />
            <Setter Property="MaxWidth" Value="46" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Height" Duration="0:0:0.45" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.bar.below">
            <Setter Property="Background" Value="{StaticResource Warn}" />
        </Style>
        <Style Selector="Border.bar.live">
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <!-- ===== Cảnh báo ===== -->
        <Style Selector="Border.alarm">
            <Setter Property="Background" Value="{StaticResource BgRaised}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style Selector="Border.alarm.acked">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Border.stripe">
            <Setter Property="Width" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Border.stripe.warning">
            <Setter Property="Background" Value="{StaticResource Warn}" />
        </Style>
        <Style Selector="Border.stripe.critical">
            <Setter Property="Background" Value="{StaticResource Danger}" />
        </Style>

        <!-- ===== Pill ở thanh tiêu đề ===== -->
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Background" Value="{StaticResource BgRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.pill TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>
        <Style Selector="Border.pill.sim TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Border.pill.alarmOk TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ok}" />
        </Style>
        <Style Selector="Border.pill.alarmActive">
            <Setter Property="Background" Value="{StaticResource WarnSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource Warn}" />
        </Style>
        <Style Selector="Border.pill.alarmActive TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Warn}" />
        </Style>
        <Style Selector="Border.pill.alarmActive.critical">
            <Setter Property="Background" Value="{StaticResource DangerSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
        </Style>
        <Style Selector="Border.pill.alarmActive.critical TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Danger}" />
        </Style>
    </Application.Styles>
</Application>
