<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DemoQR</AssemblyName>
    <RootNamespace>QRDemoCodeBackend</RootNamespace>
    <!-- Bao ve: publish ra native code theo tung may (Native AOT) + don 1 file.
         dotnet publish -c Release -r win-x64 -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <StripSymbols>true</StripSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Chi dung o moi truong Development: cau hinh mau (ClientId/ApiKey mau) cho debug.
       KHONG dua vao ban phat hanh cho khach (Release). -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <None Include="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Copy license.lic sang thu muc output de debug khong bi loi "khong tim thay license".
       File license.lic khong commit git (xem .gitignore). -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <None Include="$(MSBuildThisFileDirectory)..\license.lic"
          Condition="Exists('$(MSBuildThisFileDirectory)..\license.lic')"
          Link="license.lic"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Chay Debug: dung appsettings.Development.json (co ClientId/ApiKey mau) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DEVELOPMENT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClassLibraryMT\ClassLibraryMT.csproj" />
  </ItemGroup>

</Project>
