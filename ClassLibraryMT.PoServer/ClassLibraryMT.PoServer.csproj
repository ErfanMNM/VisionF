<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>ClassLibraryMT.PoServer</RootNamespace>
    <AssemblyName>ClassLibraryMT.PoServer</AssemblyName>
    <!-- Sinh XML doc cho toan bo public API. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dung chung store PO de PO nhan tu MES hien thi nhu PO cao tu server. -->
    <ProjectReference Include="..\ClassLibraryMT.Po\ClassLibraryMT.Po.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Đóng gói đúng hai tài nguyên demo, không phục vụ file từ đĩa. -->
    <EmbeddedResource Include="..\docs\po-demo\index.html" LogicalName="ClassLibraryMT.PoServer.PoDemo.index.html" />
    <EmbeddedResource Include="..\docs\po-demo\validation.js" LogicalName="ClassLibraryMT.PoServer.PoDemo.validation.js" />
  </ItemGroup>

</Project>
