<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>ClassLibraryMT.Auth</RootNamespace>
    <AssemblyName>ClassLibraryMT.Auth</AssemblyName>
    <!-- Sinh XML doc cho toan bo public API. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- ADO.NET thuan (khong EF/Dapper) de giu AOT-compatible va nhe. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- IUserContext (lib Logging) de ghi ten nguoi dung vao nhat ky thao tac.
         Chi chieu Auth -> Logging, nguoc lai khong tham chieu de tranh phu thuoc vong. -->
    <ProjectReference Include="..\ClassLibraryMT.Logging\ClassLibraryMT.Logging.csproj" />
  </ItemGroup>

</Project>
