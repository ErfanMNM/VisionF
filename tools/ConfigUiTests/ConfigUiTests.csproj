<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ConfigUiTests — kiểm thử trang Cấu hình của TanTienQR ở chế độ OFF-SCREEN.

    Dùng Avalonia.Headless + Skia: KHÔNG mở cửa sổ thật trên desktop,
    KHÔNG chụp màn hình, KHÔNG ảnh hưởng phiên làm việc của người dùng.

    Mọi DB / file cấu hình đều nằm trong thư mục sandbox cục bộ của test.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ConfigUiTests</RootNamespace>
    <AssemblyName>ConfigUiTests</AssemblyName>
    <IsAotCompatible>false</IsAotCompatible>
    <PublishAot>false</PublishAot>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <NoWarn>$(NoWarn);CA1416;AVLN5001;IL3000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\TanTienQR\TanTienQR.csproj" />
  </ItemGroup>

</Project>
