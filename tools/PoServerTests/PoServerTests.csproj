<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PoServerTests</RootNamespace>
    <AssemblyName>PoServerTests</AssemblyName>
    <!-- Cong tool kiem thu: khong can AOT. -->
    <IsAotCompatible>false</IsAotCompatible>

    <!-- Cac thu muc con (e2e/...) la project rieng, khong thuoc ve project nay. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="CodeContentParserChecks.cs" />
    <Compile Include="PoContractChecks.cs" />
    <Compile Include="PoDemoTestHost.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ClassLibraryMT.Po\ClassLibraryMT.Po.csproj" />
    <ProjectReference Include="..\..\ClassLibraryMT.PoServer\ClassLibraryMT.PoServer.csproj" />
    <ProjectReference Include="..\..\ClassLibraryMT.MesSimulator\ClassLibraryMT.MesSimulator.csproj" />
  </ItemGroup>

</Project>
