<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AccountsIconTests — kiểm thử OFF-SCREEN cho trang "Tài khoản người dùng":

      [1] Icon trong 4 nút thao tác (Sửa / Mật khẩu / Khoá / Xoá) phải được
          TÔ MÀU khác nhau, không còn màu chữ mặc định (TextPrimary).
      [2] Nút trong hàng không bị cắt chữ: chiều rộng nút >= chiều rộng nội
          dung (icon + chữ), và chiều cao bằng chiều cao hàng (32px), không
          tràn dọc như trước (Height=44 của style iconbtn).

    Dùng Avalonia.Headless + Skia: KHÔNG mở cửa sổ thật trên desktop,
    KHÔNG chụp màn hình, KHÔNG ảnh hưởng phiên làm việc của người dùng.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AccountsIconTests</RootNamespace>
    <AssemblyName>AccountsIconTests</AssemblyName>
    <IsAotCompatible>false</IsAotCompatible>
    <PublishAot>false</PublishAot>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <NoWarn>$(NoWarn);CA1416;AVLN5001;IL3000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\TanTienQR\TanTienQR.csproj" />
  </ItemGroup>

</Project>
