<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LicenseTool.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Tông sáng công nghiệp: nền xanh xám nhạt, nhấn cyan-teal -->
      <SolidColorBrush x:Key="BgBase">#EEF3F6</SolidColorBrush>
      <SolidColorBrush x:Key="BgPanel">#FFFFFF</SolidColorBrush>
      <SolidColorBrush x:Key="BgRaised">#E7EFF4</SolidColorBrush>
      <SolidColorBrush x:Key="LineColor">#D3DEE6</SolidColorBrush>
      <SolidColorBrush x:Key="TextPrimary">#173041</SolidColorBrush>
      <SolidColorBrush x:Key="TextMuted">#5F7688</SolidColorBrush>
      <SolidColorBrush x:Key="Accent">#0284A8</SolidColorBrush>
      <SolidColorBrush x:Key="AccentDark">#03687F</SolidColorBrush>
      <SolidColorBrush x:Key="AccentSoft">#D7F1F7</SolidColorBrush>
      <SolidColorBrush x:Key="Ok">#147A52</SolidColorBrush>
      <SolidColorBrush x:Key="OkSoft">#DCF3E7</SolidColorBrush>
      <SolidColorBrush x:Key="Danger">#C03545</SolidColorBrush>
      <SolidColorBrush x:Key="DangerSoft">#FBE3E6</SolidColorBrush>
      <SolidColorBrush x:Key="Amber">#A86A05</SolidColorBrush>
      <SolidColorBrush x:Key="AmberSoft">#FDF0D3</SolidColorBrush>

      <FontFamily x:Key="UiFont">Segoe UI, Inter</FontFamily>
      <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="Background" Value="{StaticResource BgBase}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    </Style>
    <Style Selector="TextBlock.stepNum">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Khung thẻ -->
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{StaticResource BgPanel}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="BoxShadow" Value="0 1 6 0 #14000000" />
    </Style>
    <!-- Vòng tròn số thứ tự -->
    <Style Selector="Border.step">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{StaticResource Accent}" />
    </Style>

    <!-- Nút -->
    <Style Selector="Button.btn">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="{StaticResource BgRaised}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="{StaticResource AccentDark}" />
    </Style>
    <Style Selector="Button.btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
    </Style>
    <Style Selector="Button.btn.primary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.btn.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentDark}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentDark}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.btn.small">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Ô nhập -->
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="TextBox.mono">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>

    <!-- Badge trạng thái -->
    <Style Selector="Border.badge">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Background" Value="{StaticResource BgRaised}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>
    <Style Selector="Border.badge.ok">
      <Setter Property="Background" Value="{StaticResource OkSoft}" />
      <Setter Property="BorderBrush" Value="{StaticResource Ok}" />
    </Style>
    <Style Selector="Border.badge.ok TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ok}" />
    </Style>
    <Style Selector="Border.badge.bad">
      <Setter Property="Background" Value="{StaticResource DangerSoft}" />
      <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
    </Style>
    <Style Selector="Border.badge.bad TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Danger}" />
    </Style>

    <!-- Banner cảnh báo -->
    <Style Selector="Border.notice">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Background" Value="{StaticResource AmberSoft}" />
      <Setter Property="BorderBrush" Value="{StaticResource Amber}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.notice TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Amber}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Tab -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="18,10" />
    </Style>
  </Application.Styles>
</Application>
