    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PoServer</RootNamespace>
    <AssemblyName>PoServer</AssemblyName>
    <!-- Tool noi bo (may chu gia lap): KHONG giao cho khach -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ClassLibraryMT.Po\ClassLibraryMT.Po.csproj" />
  </ItemGroup>

  <!-- Copy giao diện web tạo PO mẫu vào output -->
  <ItemGroup>
    <None Update="www\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
